insert Definition (id: null
text: King George Island (Argentina: Isla 25 de Mayo, Chile: Isla Rey Jorge, Russian: Ватерло́о Vaterloo) is the largest of the South Shetland Islands, lying 120 km (75 miles) off the coast of Antarctica in the Southern Ocean. The island was named after King George III.
language code: en);</changeNote>
