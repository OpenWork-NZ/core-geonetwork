    <changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2018-12-04 16:41:00.0 [sritz]  
insert Definition (id: null
text: Bartolomé Island (Spanish: Isla Bartolomé) is a volcanic islet in the Galápagos Islands group.[1] It is a volcanic islet just off the east coast of Santiago Island. It is one of the "younger" islands in the Galápagos archipelago. This island, and Sulivan Bay on Santiago island, are named after naturalist and lifelong friend of Charles Darwin, Sir Bartholomew James Sulivan, who was a lieutenant aboard HMS Beagle.[2]
language code: en);</changeNote>
    <definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Bartolomé Island (Spanish: Isla Bartolomé) is a volcanic islet in the Galápagos Islands group.[1] It is a volcanic islet just off the east coast of Santiago Island. It is one of the "younger" islands in the Galápagos archipelago. This island, and Sulivan Bay on Santiago island, are named after naturalist and lifelong friend of Charles Darwin, Sir Bartholomew James Sulivan, who was a lieutenant aboard HMS Beagle.[2]</definition>
    <reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5nu8fx11" />
  </rdf:Description>
