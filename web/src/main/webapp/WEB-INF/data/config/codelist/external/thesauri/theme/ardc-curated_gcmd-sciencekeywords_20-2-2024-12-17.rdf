insert Definition (id: null
text: An index of plant “greenness” or photosynthetic activity, and is one of the most commonly used vegetation indices.
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2016-07-12 11:12:04.0 [gee-cee]  
update PrefLabel (NORMALIZED DIFFERENCE VEGETATION INDEX (NDVI)); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">An index of plant “greenness” or photosynthetic activity, and is one of the most commonly used vegetation indices.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">NORMALIZED DIFFERENCE VEGETATION INDEX (NDVI)</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx2333"/>
</rdf:Description>

