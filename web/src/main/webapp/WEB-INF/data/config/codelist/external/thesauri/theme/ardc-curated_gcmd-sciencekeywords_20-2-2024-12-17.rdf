insert Definition (id: null
text: A type of distinctive, flat-topped, steep-sided volcano formed when lava  erupts through a thick glacier or ice sheet. They are somewhat rare worldwide, being confined to regions which were formerly covered by continental ice sheets and also had active volcanism during the same time period.
language code: en); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">A type of distinctive, flat-topped, steep-sided volcano formed when lava  erupts through a thick glacier or ice sheet. They are somewhat rare worldwide, being confined to regions which were formerly covered by continental ice sheets and also had active volcanism during the same time period.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
