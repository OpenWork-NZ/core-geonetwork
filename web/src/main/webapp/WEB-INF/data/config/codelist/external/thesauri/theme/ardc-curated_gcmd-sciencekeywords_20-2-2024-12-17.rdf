insert Definition (id: null
text: Gymnosperms are seed-producing plants, commonly refered to as 'naked seeds', where the ovules are not inclused in the ovary.
language code: en); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Gymnosperms are seed-producing plants, commonly refered to as 'naked seeds', where the ovules are not inclused in the ovary.</definition>
