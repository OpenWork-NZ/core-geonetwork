<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/82fdb39c-4fe8-4e2b-9dcf-67ceb4c6d8b9">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/cdbe5ef5-408d-489d-b6ff-4482ce4a99c7"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2019-03-12 13:52:15.0 [tstevens] Insert Concept 
add broader relation (TOURISM [82fdb39c-4fe8-4e2b-9dcf-67ceb4c6d8b9,368555] - ECONOMIC RESOURCES [cdbe5ef5-408d-489d-b6ff-4482ce4a99c7,84705]); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2019-03-12 15:27:48.0 [tstevens] Insert Concept 
add narrower relation (TOURISM [82fdb39c-4fe8-4e2b-9dcf-67ceb4c6d8b9,368555] - ECOTOURISM [e6cf64ce-389f-479c-835a-eecd612d4d88,368559]); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">The business or industry of providing information, accommodations, transportation, and other services to tourists.​​  Climate and weather are important factors in tourist destination choice, and the tourist sector is susceptible to extreme weather.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">TOURISM</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx938"/>
	<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/e6cf64ce-389f-479c-835a-eecd612d4d88"/>
	<altLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Tourism Industry</altLabel>
	<altLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Tourism Sector</altLabel>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/e6cf64ce-389f-479c-835a-eecd612d4d88">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/82fdb39c-4fe8-4e2b-9dcf-67ceb4c6d8b9"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2019-03-12 15:27:48.0 [tstevens] Insert Concept 
add broader relation (ECOTOURISM [e6cf64ce-389f-479c-835a-eecd612d4d88,368559] - TOURISM [82fdb39c-4fe8-4e2b-9dcf-67ceb4c6d8b9,368555]); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Nature-based tourism that promotes the observation, appreciation, and conservation of natural areas and traditional cultures. Ecotourism often contains an educational component and functions to sustain the well-being of local peoples, communities, and economies while minimizing negative impacts to ecosystems.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">ECOTOURISM</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx2889"/>
</rdf:Description>

