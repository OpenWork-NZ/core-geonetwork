<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/f1964fd8-9ab6-4f36-b761-131ff79a12bc">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/1a4e5774-7d4a-4ce7-9a4c-e2c72c8c377f"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2021-10-22 09:41:21.0 [tstevens]  
insert Definition (id: null
text: The mass fraction of total dissolved solids/salt per kilogram of seawater. In practice, this mass is difficult to determine. A protocol was adopted in 1902 by an international commission to approach the value of the dissolved substance mass.
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2021-10-21 08:27:49.0 [tstevens] Insert Concept 
