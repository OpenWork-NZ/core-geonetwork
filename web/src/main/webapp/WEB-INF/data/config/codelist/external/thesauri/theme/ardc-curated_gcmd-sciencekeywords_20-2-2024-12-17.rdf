<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/b8018326-a186-4847-961d-8bd0727bbd5e">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/a956d045-3b12-441c-8a18-fac7d33b2b4e"/>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">The design, construction, and use of agricultural implements and
buildings; soil and water management; rural use of electricity; and
processing of agricultural products.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">AGRICULTURAL ENGINEERING</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx272"/>
	<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/d53e1951-fb68-4ad8-8725-d19c10751da5"/>
