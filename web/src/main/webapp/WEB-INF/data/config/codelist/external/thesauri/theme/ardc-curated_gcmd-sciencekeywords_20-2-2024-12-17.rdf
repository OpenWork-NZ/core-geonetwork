<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/e85b6d64-a230-4c1d-99a5-c62be8af18c7">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/3546cb0a-27a2-4914-85cf-1774b5c4ed19"/>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Lichens are a type of composite organism, which consists of a fungus and
an algae living in symbiotic association.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">LICHENS</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx2348"/>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/14fa5360-320c-4d54-9bf6-9871a4b308d7">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/3546cb0a-27a2-4914-85cf-1774b5c4ed19"/>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Mushrooms are a type of fungi (which are major decomposers that engage
in extracellular digestion and absorption of organic matter). Mushrooms
are of the order Basidiomycota, the club fungi, which have a fruiting body
in the aboveground portion of the plant.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">MUSHROOMS</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx930"/>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/ee2e5028-1963-4de1-a883-b9e546d682a4">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/3546cb0a-27a2-4914-85cf-1774b5c4ed19"/>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Yeasts are members of the Ascomycota Division.	Yeasts are unicellular and
they reproduce asexually by budding.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">YEASTS/TRUFFLES</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx1316"/>
</rdf:Description>

