<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/06a24fd2-38b6-4a4a-a0cf-1abf149283e2">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/4ad0c52d-6449-48ff-8678-adc6b2cebcb7"/>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Atmospheric heating has been used to refer to the heat transfer or heat
balance of the Earth's atmosphere. Heat transfer is the exchange of heat
by radiation, conduction, or convection. Heat balance is the balance of
the gains and losses of heat at any point in the atmosphere.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">ATMOSPHERIC HEATING</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx1346"/>
</rdf:Description>

