<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/af67dee1-7c50-4e73-8db8-b1f421df67fb">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/1bf8f27a-d6ff-4cb6-acb7-7e5cce11e029"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2017-03-15 09:17:13.0 [mgenazzi] Definition added 
insert Definition (id: null
text: Phylum Chordata. Class Aves. Order Pelecaniformes. Family Ardeidae are long-legged freshwater and coastal birds. Though not egrets are not biologically distinct from herons, they tend to be mainly white with decorative plumes. Herons has the same build has egrets but tend to be larger with thick daggerlike bills.
language code: en); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Phylum Chordata. Class Aves. Order Pelecaniformes. Family Ardeidae are long-legged freshwater and coastal birds. Though not egrets are not biologically distinct from herons, they tend to be mainly white with decorative plumes. Herons has the same build has egrets but tend to be larger with thick daggerlike bills.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
