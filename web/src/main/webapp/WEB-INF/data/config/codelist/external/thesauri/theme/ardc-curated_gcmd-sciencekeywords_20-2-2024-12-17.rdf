<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/527f637c-aea5-4519-9293-d57e10a76bff">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/2e5a401b-1507-4f57-82b8-36557c13b154"/>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Aerosols consisting predominantly of organic substances and various forms
of black carbon; may be biogenic or anthropogenic, primary or secondary.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">CARBONACEOUS AEROSOLS</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx3161"/>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/1b6342c6-315b-4f4f-b4e3-d6902aaa3e85">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/2e5a401b-1507-4f57-82b8-36557c13b154"/>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Solid materials suspended in the atmosphere in the form of small,
irregular particules, many of which are microscopic in size. Dust and Ash
are due to biogenic and anthropogenic sources such as volcanic eruptions,
salt spray, plant pollen, smoke, industrial processes, etc.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">DUST/ASH/SMOKE</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx3139"/>
</rdf:Description>

