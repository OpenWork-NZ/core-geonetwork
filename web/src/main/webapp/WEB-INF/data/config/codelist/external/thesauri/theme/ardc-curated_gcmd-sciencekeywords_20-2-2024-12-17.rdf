<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/5e9ad407-bd70-43ae-a901-6b07f100db27">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/4e4d3c18-cdd4-474a-a936-6e127ec526f7"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2021-10-20 15:06:05.0 [tstevens]  
insert Definition (id: null
text: The estimated average height of the highest one-third of the swells.  It is estimated from determining how the wave energy is distributed among various periods (frequencies), determining if a separate swell energy peak exists, and then, picking a frequency to separate swell and wind-waves. The swell height is calculated from the wave energies below the separation frequency.
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2021-10-20 15:05:10.0 [tstevens] Insert Concept 
add broader relation (SWELL HEIGHT [5e9ad407-bd70-43ae-a901-6b07f100db27,778219] - SWELLS [4e4d3c18-cdd4-474a-a936-6e127ec526f7,776184]); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">The estimated average height of the highest one-third of the swells.  It is estimated from determining how the wave energy is distributed among various periods (frequencies), determining if a separate swell energy peak exists, and then, picking a frequency to separate swell and wind-waves. The swell height is calculated from the wave energies below the separation frequency.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">SWELL HEIGHT</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx1565"/>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/7a8920f3-e531-47e0-bb23-a9f816cfb7bf">
