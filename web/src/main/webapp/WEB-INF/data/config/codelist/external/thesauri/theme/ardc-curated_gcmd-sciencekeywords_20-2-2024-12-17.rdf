<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/c1f717e9-da1a-4e85-ba2b-01986d53674d">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/46172bbe-8bf0-49a0-848f-129c089aeb8e"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-04-02 08:25:10.0 [tbs1979]  
insert Definition (id: null
text: Broad, low-relief volcanic crater that is caused by a phreatomagmatic eruption, an explosion  caused by groundwater coming into contact with hot lava or magma. A maar characteristically fills with water to form a relatively shallow crater lake.
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-02-18 11:59:32.0 [tbs1979] Insert Concept 
add broader relation (MAAR [c1f717e9-da1a-4e85-ba2b-01986d53674d,82529] - TECTONIC LANDFORMS [46172bbe-8bf0-49a0-848f-129c089aeb8e,63407]); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Broad, low-relief volcanic crater that is caused by a phreatomagmatic eruption, an explosion  caused by groundwater coming into contact with hot lava or magma. A maar characteristically fills with water to form a relatively shallow crater lake.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
