	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2016-06-13 12:08:07.0 [gee-cee]  
insert Definition (id: null
text: Pertaining to forests consisting of coniferous-evergreen trees and characterized by well-defined seasons with cold, long snowy winters and warm, humid summers.
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2016-06-13 12:07:40.0 [gee-cee] Insert Concept 
