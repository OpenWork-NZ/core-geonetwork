<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/5b49fd6d-3759-4b61-8b04-8309f38b2f90">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/d8dcfd36-f71c-499f-84f5-43da9fee26c5"/>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Hydroxyl (OH) - an atom consisting of one hydrogen atom and one oxygen&#xD;
atom which does not normally exist in a stable form; this radical readily&#xD;
reacts with methane and carbon monoxide. The source of the hydroxyl&#xD;
radical in the atmosphere occurs primarily through the 1) photolysis of&#xD;
hydrogen peroxide, heat, and light and 2) the attack on water of an&#xD;
excited oxygen radical (created by the photolysis of ozone). [JAPCA; v39;&#xD;
704; 1989] [Journal of Chemical Society; v85; 577; 1989.]</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">HYDROXYL</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx233"/>
</rdf:Description>

