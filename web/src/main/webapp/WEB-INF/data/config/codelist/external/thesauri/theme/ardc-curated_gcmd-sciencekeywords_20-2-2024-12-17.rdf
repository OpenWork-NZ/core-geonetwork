<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/0ff2a38d-00f6-459d-ac9a-9a983bda602e">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/76b8c21c-c221-4724-86ef-c07222cb152b"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2012-06-26 13:35:54.0 [gee-cee] Insert Concept 
add broader relation (ICE GROWTH/MELT [0ff2a38d-00f6-459d-ac9a-9a983bda602e,39929] - CRYOSPHERIC INDICATORS [76b8c21c-c221-4724-86ef-c07222cb152b,39899]); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2012-07-10 13:50:15.0 [mpmorahan]  
insert Definition (id: null
text: Melt of the ice can occur at various stages: puddle, thaw holes, dried ice, rotten ice, flodded ice, and frozen puddle. Developing sea ice (or growth) takes on the following stages: New Ice, Youg Ice, First-Year Ice, Old Ice. Lake Ice development goes through the following stages: New Lake Ice, Thin Lake Ice, Medium Lake Ice, Thick Lake Ice, and Very Thick Lake Ice.
language code: en); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Melt of the ice can occur at various stages: puddle, thaw holes, dried ice, rotten ice, flodded ice, and frozen puddle. Developing sea ice (or growth) takes on the following stages: New Ice, Youg Ice, First-Year Ice, Old Ice. Lake Ice development goes through the following stages: New Lake Ice, Thin Lake Ice, Medium Lake Ice, Thick Lake Ice, and Very Thick Lake Ice.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">ICE GROWTH/MELT</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx1757"/>
</rdf:Description>

