<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/12b1cc7c-cb81-4851-9163-19c04a8ffd1c">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/0af72e0e-52a5-4695-9eaf-d6fbb7991039"/>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">A unit measure of electrical conduction; the facility with which a
substance conducts electricity, as represented by the current density per
unit electrical- potential gradient in the direction of flow.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">ATMOSPHERIC CONDUCTIVITY</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx2156"/>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/41f27172-14f6-4940-9b7b-f3d4db69e0c6">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/0af72e0e-52a5-4695-9eaf-d6fbb7991039"/>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">The region in which electric forces can be observed, e.g. near an&#xD;
electric charge. As a field, it may also be viewed as a region of space&#xD;
modified by the presence of electric charges.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">ELECTRIC FIELD</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx2986"/>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/cac28264-0788-49a9-bb6a-c2251b0b325c">
