insert Definition (id: null
text: Pertaining to forests in temperate latitudes characterized by high annual precipitation over 140 cm and infrequent fire.
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2016-06-13 12:10:38.0 [gee-cee] Insert Concept 
