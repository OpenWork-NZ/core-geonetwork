	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-02-14 14:16:45.0 [mpmorahan] Rename Concept 
update PrefLabel (CLOUD RADIATIVE FORCING); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-02-14 14:15:25.0 [mpmorahan] Move Concepts 
add broader relation (CLOUD FORCING [345ab082-59ac-4649-9a2a-a3bef0d26a06,63279] - CLOUD RADIATIVE TRANSFER [3487d350-a5a5-43d9-a60d-c1407dd2f0ce,82135]); 
delete broader relation (null); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">The effect that clouds have on the global radiation budget.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">CLOUD RADIATIVE FORCING</prefLabel>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/d2e93932-0231-4b23-af2f-217c6315a95e">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/3487d350-a5a5-43d9-a60d-c1407dd2f0ce"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-02-14 14:11:20.0 [mpmorahan] Insert Concept 
add broader relation (ABSORPTION [d2e93932-0231-4b23-af2f-217c6315a95e,82301] - CLOUD RADIATIVE TRANSFER [3487d350-a5a5-43d9-a60d-c1407dd2f0ce,82135]); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-03-21 14:46:27.0 [mpmorahan]  
insert Definition (id: null
text: The process in which incident radiant energy is retained by a substance.

A further process always results from absorption, that is, the irreversible conversion of the absorbed radiation into some other form of energy within and according to the nature of the absorbing medium. The absorbing medium itself may emit radiation, but only after an energy conversion has occurred.
See attenuation.

The taking up or assimilation of one substance by another.

The substances may combine chemically, or the absorption may just correspond to a physical solubility.
language code: en); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">The process in which incident radiant energy is retained by a substance.

A further process always results from absorption, that is, the irreversible conversion of the absorbed radiation into some other form of energy within and according to the nature of the absorbing medium. The absorbing medium itself may emit radiation, but only after an energy conversion has occurred.
See attenuation.

The taking up or assimilation of one substance by another.

The substances may combine chemically, or the absorption may just correspond to a physical solubility.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">ABSORPTION</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx1930"/>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/c830ad5e-ac31-41cf-b8e2-277fe457d76d">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/3487d350-a5a5-43d9-a60d-c1407dd2f0ce"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-02-14 14:30:18.0 [mpmorahan] Insert Concept 
add broader relation (SCATTERING [c830ad5e-ac31-41cf-b8e2-277fe457d76d,82307] - CLOUD RADIATIVE TRANSFER [3487d350-a5a5-43d9-a60d-c1407dd2f0ce,82135]); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2017-03-15 12:00:45.0 [mgenazzi] Definition added 
insert Definition (id: null
text: The process in which a wave or beam of particles is diffused or deflected by collisions with particles of the medium which it traverses. Along with absorption, scattering is a major cause of the attenuation of radiation by the atmosphere.
language code: en); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">The process in which a wave or beam of particles is diffused or deflected by collisions with particles of the medium which it traverses. Along with absorption, scattering is a major cause of the attenuation of radiation by the atmosphere.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">SCATTERING</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx1593"/>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/4b12439a-45fc-42fa-ae19-535826f6247b">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/3487d350-a5a5-43d9-a60d-c1407dd2f0ce"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-02-14 14:28:05.0 [mpmorahan] Insert Concept 
add broader relation (EMISSION [4b12439a-45fc-42fa-ae19-535826f6247b,82303] - CLOUD RADIATIVE TRANSFER [3487d350-a5a5-43d9-a60d-c1407dd2f0ce,82135]); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2017-03-16 10:10:48.0 [sritz]  
insert Definition (id: null
text: When a cloud absorbs longwave radiation emitted by the Earth's surface, the cloud reemits a portion of the energy to outer space (emission) and a portion back toward the surface.
language code: en); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">When a cloud absorbs longwave radiation emitted by the Earth's surface, the cloud reemits a portion of the energy to outer space (emission) and a portion back toward the surface.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">EMISSION</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx2887"/>
</rdf:Description>

