<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/bffac466-83aa-4060-a378-6d2d6e49f2a1">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/b895f4b5-5273-49ef-883f-b67d9f199505"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-08-06 14:46:51.0 [tbs1979] Insert Concept 
add broader relation (TILL PLAINS [bffac466-83aa-4060-a378-6d2d6e49f2a1,105637] - GLACIAL LANDFORMS [b895f4b5-5273-49ef-883f-b67d9f199505,105287]); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-08-26 08:49:54.0 [tbs1979]  
insert Definition (id: null
text: An extensive flat plain of glacial till that forms when a sheet of ice becomes detached from the main body of a glacier and melts in place depositing the sediments it carried. A till plain with irregular topography is referred to as a ground moraine.
language code: en); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">An extensive flat plain of glacial till that forms when a sheet of ice becomes detached from the main body of a glacier and melts in place depositing the sediments it carried. A till plain with irregular topography is referred to as a ground moraine.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">TILL PLAINS</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx1660"/>
</rdf:Description>

