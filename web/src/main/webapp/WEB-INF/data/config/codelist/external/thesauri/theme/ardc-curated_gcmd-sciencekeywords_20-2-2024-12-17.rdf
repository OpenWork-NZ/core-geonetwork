<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/64074461-95d0-4538-869a-0114e39216aa">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/251c87cd-03b3-464f-8390-8ede2fec28fc"/>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Also called the surface zone. The ocean mixed layer is the upper layer
of ocean in which temperature and salinity are relatively constant with
depth. Depending on local conditions, the surface layer may reach to 1,000
meters (3,300 feet) or be absent entirely.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">OCEAN MIXED LAYER</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx1286"/>
</rdf:Description>

