	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2012-07-26 15:12:52.0 [mpmorahan]  
insert Definition (id: null
text: Sun-Earth Interactions: The effects of the sun's variability are evident in a variety of physical and chemical processes in the upper layers of the earth's atmosphere.
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2012-06-27 09:07:52.0 [mpmorahan] Insert Concept 
