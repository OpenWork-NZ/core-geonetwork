<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/6d2511f8-4503-4237-93a9-34a3b369fe00">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
