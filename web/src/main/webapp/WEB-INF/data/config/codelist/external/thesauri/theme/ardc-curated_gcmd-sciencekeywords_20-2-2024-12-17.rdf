	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2023-02-24 12:24:08.0 [sritz]  
insert Definition (id: null
text: The net balance between the sea ice mass gained by freezing and the loss of mass by melting that is a function of its extent and thickness, which combine to give its volume.
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2023-02-24 12:22:29.0 [sritz] Insert Concept 
