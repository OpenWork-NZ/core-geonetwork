	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/66034667-3a75-401d-894e-57f604d56571"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2024-02-21 15:25:42.0 [tstevens] Insert Concept 
add broader relation (ENVIRONMENTAL DNA _eDNA_ [4c0b1743-dfeb-4147-b89f-99386a370d42,1588448] - DNA [66034667-3a75-401d-894e-57f604d56571,1588447]); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2024-02-21 15:26:34.0 [tstevens]  
update PrefLabel (ENVIRONMENTAL DNA (eDNA)); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2024-02-22 09:10:28.0 [tstevens]  
insert Definition (id: null
text: Environmental DNA (eDNA) is organismal DNA that can be found in the environment and originates from cellular material shed by larger organisms (via skin, excrement, etc.) into aquatic or terrestrial environments, or can represent the entirety of smaller organisms present within the sample.
language code: en); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Environmental DNA (eDNA) is organismal DNA that can be found in the environment and originates from cellular material shed by larger organisms (via skin, excrement, etc.) into aquatic or terrestrial environments, or can represent the entirety of smaller organisms present within the sample.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">ENVIRONMENTAL DNA (eDNA)</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx1026"/>
</rdf:Description>

