<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/e2ea5b37-7004-4943-ad69-ca39a57569a4">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/b409a30b-0e3f-4592-bec9-7d371797b4a9"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-08-06 15:00:45.0 [tbs1979] Insert Concept 
add broader relation (FIRN FORMATION [e2ea5b37-7004-4943-ad69-ca39a57569a4,105667] - GLACIAL PROCESSES [b409a30b-0e3f-4592-bec9-7d371797b4a9,85295]); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-08-26 09:04:02.0 [tbs1979]  
insert Definition (id: null
text: The formation process of firn, a partially compacted névé, which is a type of snow that has been left over from past seasons and has been recrystallized into a substance denser than névé. It is ice that is at an intermediate stage between snow and glacial ice.
language code: en); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">The formation process of firn, a partially compacted névé, which is a type of snow that has been left over from past seasons and has been recrystallized into a substance denser than névé. It is ice that is at an intermediate stage between snow and glacial ice.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">FIRN FORMATION</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx460"/>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/aa74db50-4ae7-463b-903a-2a256f967ca8">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/b409a30b-0e3f-4592-bec9-7d371797b4a9"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-08-06 15:01:47.0 [tbs1979] Insert Concept 
add broader relation (GLACIAL DISPLACEMENT [aa74db50-4ae7-463b-903a-2a256f967ca8,105673] - GLACIAL PROCESSES [b409a30b-0e3f-4592-bec9-7d371797b4a9,85295]); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2024-10-30 08:06:03.0 [tstevens]  
insert WeightedRelation (id: null
related concept uuid: 5ddbaf71-b279-42cf-b250-faaefb627f66
relationship type: null
relationship value: null
generated by: null); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-08-26 09:07:57.0 [tbs1979]  
insert Definition (id: null
text: The displacement of a glacier. The speed of glacial displacement is partly determined by friction. Friction makes the ice at the bottom of the glacier move slower than the upper portion. In alpine glaciers, friction is also generated at the valley's side walls, which slows the edges relative to the center.
language code: en); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">The displacement of a glacier. The speed of glacial displacement is partly determined by friction. Friction makes the ice at the bottom of the glacier move slower than the upper portion. In alpine glaciers, friction is also generated at the valley's side walls, which slows the edges relative to the center.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">GLACIAL DISPLACEMENT</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx2778"/>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/07825acf-619a-4689-b1ed-09c15166624c">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/b409a30b-0e3f-4592-bec9-7d371797b4a9"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-08-06 15:06:01.0 [tbs1979] Insert Concept 
add broader relation (WEATHERING [07825acf-619a-4689-b1ed-09c15166624c,105693] - GLACIAL PROCESSES [b409a30b-0e3f-4592-bec9-7d371797b4a9,85295]); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-08-26 09:20:49.0 [tbs1979]  
insert Definition (id: null
text: Breaking down of Earth's rocks, soils and minerals through direct contact with the planet's atmosphere. Weathering occurs in situ, or "with no movement", and thus should not be confused with erosion, which involves the movement of rocks and minerals by agents such as water, ice, wind, and gravity.
language code: en); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Breaking down of Earth's rocks, soils and minerals through direct contact with the planet's atmosphere. Weathering occurs in situ, or "with no movement", and thus should not be confused with erosion, which involves the movement of rocks and minerals by agents such as water, ice, wind, and gravity.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">WEATHERING</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx541"/>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/2f8b965f-0a0e-427f-a696-ac6b4323744e">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/b409a30b-0e3f-4592-bec9-7d371797b4a9"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-08-26 09:18:13.0 [tbs1979]  
insert Definition (id: null
text: Describes a geomorphic process related to freezing of water occur. In its original meaning a periglacial area was at the time in question, the area was not buried by glacial ice but was subject to intense freezing cycles and exhibits permafrost weathering and erosion characteristics.
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-08-06 15:06:38.0 [tbs1979] Insert Concept 
add broader relation (PERIGLACIAL PROCESSES [2f8b965f-0a0e-427f-a696-ac6b4323744e,105695] - GLACIAL PROCESSES [b409a30b-0e3f-4592-bec9-7d371797b4a9,85295]); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Describes a geomorphic process related to freezing of water occur. In its original meaning a periglacial area was at the time in question, the area was not buried by glacial ice but was subject to intense freezing cycles and exhibits permafrost weathering and erosion characteristics.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">PERIGLACIAL PROCESSES</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx1250"/>
</rdf:Description>

