</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-02-12 13:51:21.0 [mpmorahan] Insert Concept 
add narrower relation (ALTOCUMULUS [01021105-60ed-479a-a35b-faa73e286264,82159] - ALTOCUMULUS UNDULATUS [73e102fa-3089-42c3-bd0f-4682f73fff0f,82161]); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-03-20 16:27:40.0 [mpmorahan]  
insert Definition (id: null
text: A principal cloud type, forming in the middle levels of the troposphere, and appearing as a white and/or grey layer or patch with a waved aspect. In aviation forecasts and reports it is coded as AC.
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-02-12 13:55:53.0 [mpmorahan] Insert Concept 
add narrower relation (ALTOCUMULUS [01021105-60ed-479a-a35b-faa73e286264,82159] - ALTOCUMULUS LENTICULARIS [dbc7fed3-ad30-4e57-868e-bae478713a71,82165]); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-02-12 13:54:53.0 [mpmorahan] Insert Concept 
add narrower relation (ALTOCUMULUS [01021105-60ed-479a-a35b-faa73e286264,82159] - ALTOCUMULUS CASTELLANUS [44415a90-bfe0-447a-93c9-6e4badc6871c,82163]); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">A principal cloud type, forming in the middle levels of the troposphere, and appearing as a white and/or grey layer or patch with a waved aspect. In aviation forecasts and reports it is coded as AC.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">ALTOCUMULUS</prefLabel>
