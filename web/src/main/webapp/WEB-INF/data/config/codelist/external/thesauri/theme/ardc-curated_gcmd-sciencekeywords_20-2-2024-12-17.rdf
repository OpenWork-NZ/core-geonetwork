insert Definition (id: null
text: A glacial landform made by a stream flowing through glacial ice and depositing material upon entering a lake or pond at the end or terminus of the glacier, thus "in front" of it, a proglacial lake.
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-03-05 08:31:35.0 [tbs1979] Insert Concept 
