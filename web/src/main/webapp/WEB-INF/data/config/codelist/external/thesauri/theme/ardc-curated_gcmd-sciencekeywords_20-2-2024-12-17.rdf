	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/a46016d7-e571-403a-ab37-7223fd74e68e"/>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">A measure of the dissolved solids in seawater.</definition>
