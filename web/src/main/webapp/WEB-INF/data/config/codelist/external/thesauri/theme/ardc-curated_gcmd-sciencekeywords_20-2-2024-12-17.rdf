</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/9818a5f0-bec9-47c0-b2ee-7e84c55466ed">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
