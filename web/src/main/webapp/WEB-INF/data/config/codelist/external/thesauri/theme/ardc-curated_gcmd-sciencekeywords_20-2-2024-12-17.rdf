<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/10a9c153-f37d-48fe-920d-c790d946ab07">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/a031952d-9f00-4ba5-9966-5f87ab9dfdd4"/>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">The circulatory vertical motion in a fluid medium (ocean water) owing to
the variation of its density and the action of gravity.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
