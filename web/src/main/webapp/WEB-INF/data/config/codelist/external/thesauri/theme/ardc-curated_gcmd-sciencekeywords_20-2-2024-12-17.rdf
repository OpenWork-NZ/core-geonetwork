	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">The reduction in bulk volume or thickness of a soil owing to increasing
weight of overlying material that is continually being deposited, or to
pressures from earth movements, resulting in a decrease of porosity.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">SOIL COMPACTION</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx3129"/>
</rdf:Description>

