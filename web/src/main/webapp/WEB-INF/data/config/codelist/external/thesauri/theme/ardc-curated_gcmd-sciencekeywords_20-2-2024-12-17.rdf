<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/fc77777e-614f-41f1-9b97-d5324fa99105">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/de62c07e-96c6-44fb-a3a1-cd2902305691"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2019-05-30 08:19:49.0 [mmorahan] Insert Concept 
add broader relation (Atmospheric Feedbacks [fc77777e-614f-41f1-9b97-d5324fa99105,368855] - Climate Feedbacks [de62c07e-96c6-44fb-a3a1-cd2902305691,368851]); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2019-06-03 14:42:38.0 [mmorahan] Rename Concept 
update PrefLabel (ATMOSPHERIC FEEDBACKS); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Processes within the atmosphere through which the climate system is
controlled, changed, or modulated. Atmospheric feedbacks involve a
perturbation in a climate quantity that causes a change in a second
quantity, and the change in the second quantity ultimately leads to an
additional change in the first. Examples include water vapor and cloud
feedbacks.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">ATMOSPHERIC FEEDBACKS</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx941"/>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/de62c07e-96c6-44fb-a3a1-cd2902305691">
