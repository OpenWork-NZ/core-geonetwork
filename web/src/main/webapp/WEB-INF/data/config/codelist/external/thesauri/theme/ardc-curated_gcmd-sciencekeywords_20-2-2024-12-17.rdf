	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Litter characteristics refer to Global Change Master Directory
detailed variable under the variable, Litter Characteristics: litter
chemistry, litter decomposition, litter dry weight, litterfall, and
litterfall flux.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">LITTER CHARACTERISTICS</prefLabel>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/b7de16ed-c090-449b-81c1-44fe5b1195f0">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/c7b5c02c-724d-4a19-b824-98180f3900c9"/>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Deciduous vegetation is vegetation that sheds its leaves each year in the
fall. Maple, oak, black cherry, and beech trees are examples.  The loss of
leaves in the fall is believed to be an adaptation that greatly reduces
evaporation at a time when the supply of liquid water is limited.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">DECIDUOUS VEGETATION</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx1300"/>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/7b4a6b86-6a74-4b01-b0ee-a9d7d60c72cb">
