	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2012-06-26 10:33:08.0 [gee-cee] Insert Concept 
add broader relation (OCEAN UPWELLLING INDICES [7d3e2368-75ba-43b9-bdce-bba2ff8d3e2c,39807] - ATMOSPHERIC/OCEAN INDICATORS [5273c8c2-d30b-4666-b2d5-0388ce2741d0,39645]); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2024-09-23 14:51:12.0 [tstevens]  
insert Definition (id: null
text: Indices that leverage state-of-the-art ocean models as well as satellite and in situ data to improve upon historically available upwelling indices. Upwelling drives the biological productivity of the system by bringing nutrients to surface waters.
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2012-06-26 10:34:07.0 [gee-cee] Insert Concept 
add narrower relation (OCEAN UPWELLLING INDICES [7d3e2368-75ba-43b9-bdce-bba2ff8d3e2c,39807] - OCEAN COASTAL UPWELLLING INDEX [74ad118c-2f18-40fb-a26e-092390f52c20,39809]); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2012-06-26 10:44:00.0 [gee-cee]  
update PrefLabel (OCEAN UPWELLING INDICES); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Indices that leverage state-of-the-art ocean models as well as satellite and in situ data to improve upon historically available upwelling indices. Upwelling drives the biological productivity of the system by bringing nutrients to surface waters.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">OCEAN UPWELLING INDICES</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx63"/>
	<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/74ad118c-2f18-40fb-a26e-092390f52c20"/>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/74ad118c-2f18-40fb-a26e-092390f52c20">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/7d3e2368-75ba-43b9-bdce-bba2ff8d3e2c"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2012-06-26 10:34:07.0 [gee-cee] Insert Concept 
add broader relation (OCEAN COASTAL UPWELLLING INDEX [74ad118c-2f18-40fb-a26e-092390f52c20,39809] - OCEAN UPWELLLING INDICES [7d3e2368-75ba-43b9-bdce-bba2ff8d3e2c,39807]); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2012-06-26 10:34:50.0 [gee-cee] Insert Concept 
add narrower relation (OCEAN COASTAL UPWELLLING INDEX [74ad118c-2f18-40fb-a26e-092390f52c20,39809] - CUI [db8eb32d-2f86-40ab-82af-b615b5a30db9,39811]); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2012-07-05 13:10:31.0 [mpmorahan]  
insert Definition (id: null
text: Upwelling is an important process affecting plankton production off the Pacific Northwest. The CUI is a measure of the volume of water that upwells along the coast; it identifies the amount of offshore transport of surface waters due to geostrophic wind fields. Indices are in units of cubic meters per second along each 100 meters of coastline. Positive numbers indicate offshore transport for the upwelling index product and southward transport for the along-shore product. The CUI was developed by Dr. Andrew Bakun (Bakun 1973) and is provided by the Pacific Fisheries Environmental Lab (PFEL) of NOAA National Marine Fisheries Service (NMFS).
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2012-06-26 10:46:17.0 [gee-cee]  
update PrefLabel (OCEAN COASTAL UPWELLING INDEX); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2020-02-14 12:47:59.0 [tstevens] Remove Concepts 
delete narrower relation (null); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Upwelling is an important process affecting plankton production off the Pacific Northwest. The CUI is a measure of the volume of water that upwells along the coast; it identifies the amount of offshore transport of surface waters due to geostrophic wind fields. Indices are in units of cubic meters per second along each 100 meters of coastline. Positive numbers indicate offshore transport for the upwelling index product and southward transport for the along-shore product. The CUI was developed by Dr. Andrew Bakun (Bakun 1973) and is provided by the Pacific Fisheries Environmental Lab (PFEL) of NOAA National Marine Fisheries Service (NMFS).</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">OCEAN COASTAL UPWELLING INDEX</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx3118"/>
</rdf:Description>

