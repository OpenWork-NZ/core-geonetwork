<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/01a4a324-cad3-441d-b0f1-02dc9742784a">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/dba19648-3f52-48ba-b00b-8527d44c4d74"/>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">An important baseline measurement in ice cores is electrical conductivity.&#xD;
Electrical conductivity measurements (ECM) of the core is a very rapid method
to indicate how acidic the core is without the chemical detail of the ion
analyses. The value of the measurement is that it can be done for the whole
length of the core in high resolution and provide an immediate picture of the
core and allow quick detection of interesting areas, such as a volcanic
eruptions. Because it is a high resolution, continuous measurement it can be
used, along with the other measurements, for time frequency analysis in order
to identify cycles in the climate signal.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">ELECTRICAL PROPERTIES</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx754"/>
</rdf:Description>

