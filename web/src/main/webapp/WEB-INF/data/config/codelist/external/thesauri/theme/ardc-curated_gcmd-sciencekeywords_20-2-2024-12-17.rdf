	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2012-07-23 17:12:34.0 [mpmorahan]  
insert Definition (id: null
text: A condition occurring when backward melting at the front of a glacier takes place at a rate exceeding forward motion.
language code: en); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">A condition occurring when backward melting at the front of a glacier takes place at a rate exceeding forward motion.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
