	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2016-06-28 14:37:48.0 [saritz] Insert Concept 
add narrower relation (EXTRATROPICAL CYCLONES [da436e9b-60e5-4a5f-a50a-08794d62bca8,217755] - EXTRATROPICAL CYCLONE TRACK [7de1c2c0-89c2-4841-b0b8-158224c8ad22,217761]); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2016-06-28 14:33:15.0 [saritz]  
insert Definition (id: null
text: (Sometimes called extratropical low, extratropical storm.) Any cyclonic-scale storm that is not a tropical cyclone, usually referring only to the migratory frontal cyclones of middle and high latitudes.
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2016-06-28 14:32:51.0 [saritz] Insert Concept 
add broader relation (EXTRATROPICAL CYCLONES [da436e9b-60e5-4a5f-a50a-08794d62bca8,217755] - ATMOSPHERIC PHENOMENA [b7d562cf-9b9b-4461-900b-50423a8c4d29,83679]); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2016-06-28 14:34:16.0 [saritz] Insert Concept 
add narrower relation (EXTRATROPICAL CYCLONES [da436e9b-60e5-4a5f-a50a-08794d62bca8,217755] - EXTRATROPICAL CYCLONE FREQUENCY [10277cb5-5a11-47a2-8578-3ac1c7152cd2,217757]); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">(Sometimes called extratropical low, extratropical storm.) Any cyclonic-scale storm that is not a tropical cyclone, usually referring only to the migratory frontal cyclones of middle and high latitudes.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
