insert Definition (id: null
text: A type of air pollution that is made up of particles that are less than 1 micron in size. PM1 is particularly dangerous because of its small size, which allows it to penetrate lung tissue and enter the bloodstream.
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2023-02-16 14:50:22.0 [tstevens]  
update PrefLabel (PARTICULATE MATTER (PM 1.0)); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">A type of air pollution that is made up of particles that are less than 1 micron in size. PM1 is particularly dangerous because of its small size, which allows it to penetrate lung tissue and enter the bloodstream.</definition>
