	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">The ratio of the area of the water surface covered by ice as a fraction of
the whole area. Sea ice concentration has been monitored by polar
orbiting satellites at all wavelengths.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">SEA ICE CONCENTRATION</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx2586"/>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/15547b03-1b99-4c60-92eb-216a2908f504">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/d73e969a-4b66-4713-8d63-fa3cbb1e25e3"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2021-10-21 09:09:35.0 [tstevens] Insert Concept 
add broader relation (SEA ICE TOPOGRAPHY [15547b03-1b99-4c60-92eb-216a2908f504,778232] - SEA ICE [d73e969a-4b66-4713-8d63-fa3cbb1e25e3,774840]); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2021-10-21 09:10:42.0 [tstevens]  
insert Definition (id: null
text: General elevation pattern of the sea ice surface. Changes in ice topography can be caused by water currents and wind, which can either pull ice apart or push it together to cause overriding. Some specific ice formations include rafting, ridged, and hummocked ice.
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2021-10-21 09:13:53.0 [tstevens] Insert Concept 
add narrower relation (SEA ICE TOPOGRAPHY [15547b03-1b99-4c60-92eb-216a2908f504,778232] - DYNAMIC TOPOGRAPHY [940550d2-1d9f-4c28-b9ba-857c2dc8ef95,778236]); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2021-10-21 09:11:23.0 [tstevens] Insert Concept 
add narrower relation (SEA ICE TOPOGRAPHY [15547b03-1b99-4c60-92eb-216a2908f504,778232] - SEA LEVEL [d17151a9-e03f-49ee-8d3a-d653ac84c071,778233]); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2021-10-21 09:22:43.0 [tstevens] Move Concepts 
