	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Photosynthetically Active Radiation is the light in the whole wavelength band from 400 nm (deep violet) to 700 nm (dark red) used by plants in photosynthesis.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">PHOTOSYNTHETICALLY ACTIVE RADIATION</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx805"/>
	<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/6079e5e4-4dee-4b32-aaa8-ae3231bcbadb"/>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/6079e5e4-4dee-4b32-aaa8-ae3231bcbadb">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
