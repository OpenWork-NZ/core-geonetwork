<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/c692e8e4-b920-4eb5-86c3-b5f6121fec4b">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
