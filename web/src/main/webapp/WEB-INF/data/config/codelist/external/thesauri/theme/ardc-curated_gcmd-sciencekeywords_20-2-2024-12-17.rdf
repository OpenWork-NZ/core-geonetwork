	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-08-06 08:36:18.0 [tbs1979] Insert Concept 
add broader relation (CHEMICAL SOLUTION [1e73dd30-abb5-4723-be3e-71706d2b1ea1,105561] - COASTAL PROCESSES [e26803a0-82ea-40c4-a41a-9e222c9bd09a,86507]); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2017-03-10 08:06:29.0 [tstevens]  
insert Definition (id: null
text: The removal of rock in solution by acidic rainwater. In particular, limestone is weathered by rainwater containing dissolved CO2.
language code: en); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">The removal of rock in solution by acidic rainwater. In particular, limestone is weathered by rainwater containing dissolved CO2.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
