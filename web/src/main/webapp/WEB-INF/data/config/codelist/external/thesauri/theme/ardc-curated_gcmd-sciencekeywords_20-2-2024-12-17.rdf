<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/09c21315-faba-446c-b060-136705972347">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/c40d3dbc-5d7e-434d-996e-120ba44a5d44"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2022-08-05 14:16:32.0 [sritz]  
update Definition (Precipitation composed of white or translucent ice crystals, chiefly in complex branch hexagonal form and often agglomerated into snowflakes.); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2022-08-05 12:56:30.0 [sritz] Insert Concept 
add broader relation (SNOW [09c21315-faba-446c-b060-136705972347,1011364] - SOLID PRECIPITATION [c40d3dbc-5d7e-434d-996e-120ba44a5d44,1011363]); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2022-08-05 14:15:46.0 [sritz]  
insert Definition (id: null
text: A type of frozen precipitation composed of white or translucent ice crystals, chiefly in complex branch hexagonal form and often agglomerated into snow-flakes, especially at temperatures warmer than -5 C (23 F).
language code: en); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Precipitation composed of white or translucent ice crystals, chiefly in complex branch hexagonal form and often agglomerated into snowflakes.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">SNOW</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx296"/>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/c40d3dbc-5d7e-434d-996e-120ba44a5d44">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/ea213be5-fe37-4179-9a9b-030c2bf42cf5"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2022-08-05 14:14:03.0 [sritz]  
insert Definition (id: null
text: Solid (frozen) precipitation, for example, snow, hail, ice pellets, snow pellets (soft hail, graupel), snow grains, and ice crystals;
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2022-08-05 12:56:08.0 [sritz] Insert Concept 
