</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/f29a3482-de42-4027-b5f4-87a3f7cd28af">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/a1fedfa9-569f-4313-8ce1-db95513c5469"/>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Metadata Transformation/Conversion services are defined as Metadata Handling
Services that, in the case of transformation, apply an adjustment function to
the original metadata that alters the absolute values of the metadata (e.g.,
interpolation, standardization, anomalies). In the case of conversion, the
service is designed to apply a function to the data that transforms the
relative value of the data but not the absolute. &lt;br&gt;&#xD;
Example: DIF to FGDC</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">METADATA TRANSFORMATION/CONVERSION</prefLabel>
</rdf:Description>

