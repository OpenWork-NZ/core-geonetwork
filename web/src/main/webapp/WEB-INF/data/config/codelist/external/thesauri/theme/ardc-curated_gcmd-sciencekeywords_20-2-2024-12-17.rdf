	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Any measure related to any substance that is added to food, either directly
or indirectly, to improve nutrition, taste, or shelf life.  Examples
include colorants, flavorings, seasonings, emulsifiers, stabilizers,
thickeners, sweeteners, preservatives, antioxidants, etc.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">FOOD ADDITIVES</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx231"/>
</rdf:Description>

