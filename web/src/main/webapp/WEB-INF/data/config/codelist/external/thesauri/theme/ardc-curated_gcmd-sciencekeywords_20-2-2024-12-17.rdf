<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/01549b6d-91e1-40de-bd7c-5ed5ee59d14e">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/c69cde73-7bd9-489b-a20b-bd23cfb82d92"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2017-03-15 10:43:36.0 [mgenazzi] Definition added 
insert Definition (id: null
text: Phylum Chordata. Class Actinopterygii. Order Acipenseriformes, which includes sturgeons and paddlefish, are ray-finned fish with a cartilaginous endoskeleton and no vertebral centrum
language code: en); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Phylum Chordata. Class Actinopterygii. Order Acipenseriformes, which includes sturgeons and paddlefish, are ray-finned fish with a cartilaginous endoskeleton and no vertebral centrum</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">STURGEONS/PADDLEFISHES</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx2057"/>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/0b8d5346-d10b-4e32-8179-7a51970c5e7f">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/c69cde73-7bd9-489b-a20b-bd23cfb82d92"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2017-03-15 10:41:04.0 [mgenazzi] Definition added 
insert Definition (id: null
text: Phylum Chordata. Class Actinopterygii. Salmon, a common name for ray-finned fish, are a commercially important anadromous fish. Trout, common name for freshwater fish, have fins without spine and small adipose fin near the tail.
language code: en); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Phylum Chordata. Class Actinopterygii. Salmon, a common name for ray-finned fish, are a commercially important anadromous fish. Trout, common name for freshwater fish, have fins without spine and small adipose fin near the tail.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">SALMONS/TROUTS</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx2151"/>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/a0b5e8ee-e164-4713-97b7-a8e5100d5e9c">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/c69cde73-7bd9-489b-a20b-bd23cfb82d92"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2020-05-07 14:35:16.0 [tstevens] Insert Concept 
add broader relation (STICKLEBACKS [a0b5e8ee-e164-4713-97b7-a8e5100d5e9c,560025] - RAY-FINNED FISHES [c69cde73-7bd9-489b-a20b-bd23cfb82d92,84365]); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Distribution: Northern Hemisphere. Body may be elongate, naked or with bony scutes along the sides. Three to sixteen well-developed isolated dorsal spines preceed a normal dorsal fin having 6-14 rays; caudal fin rays 12-13; a single spine and 1-2 soft rays in the pelvic fin; three branchiostegal rays; circumorbital ring incomplete posteriorly; epineurals present; vertebrae 28-42. About 18 cm maximum length reached in Spinachia spinachia. Sticklebacks have been widely used in scientific studies. Several subspecies are recognized by authors and the family is in need of revision.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">STICKLEBACKS</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx1865"/>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/89530978-556a-44fd-88fa-5d42ce9c8b91">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/c69cde73-7bd9-489b-a20b-bd23cfb82d92"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2017-03-15 08:45:50.0 [mgenazzi] Definition added 
insert Definition (id: null
text: Phylum Chordata. Class Actinopterygii. Catfish, Order Siluriformes are ray-finned fish characterized for their pair of barbels, and/or features of their flattened skull and swimbladder. Minnow is a common name for a freshwater or saltwater fish typically used as bait fish
language code: en); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Phylum Chordata. Class Actinopterygii. Catfish, Order Siluriformes are ray-finned fish characterized for their pair of barbels, and/or features of their flattened skull and swimbladder. Minnow is a common name for a freshwater or saltwater fish typically used as bait fish</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">CATFISHES/MINNOWS</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx1768"/>
</rdf:Description>

