<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/9af548c9-7050-4d59-b66d-adf52f2fb242">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/c8317644-4cb2-4e37-b536-c762f7e670ab"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2023-03-29 14:50:21.0 [sritz]  
insert AltLabel (id: null
category: primary
text: ENVIRONMENTAL JUSTICE
language code: en); 
insert Definition (id: null
text: Environmental justice is the fair treatment and meaningful involvement of all people regardless of race, color, national origin, or income, with respect to the development, implementation, and enforcement of environmental laws, regulations, and policies.  

Environmental Justice is becoming more important to the federal government and to individual agencies such as NASA and EPA.  Environmental Justice is also the driving force behind all of the UN’s Sustainable Development Goals.  NASA data are being used to support environmental and climate justice efforts. Scientists and decision-makers are applying a wide combination of datasets to assess the vulnerability and exposure of communities to environmental challenges. By providing full and open access to data, software, and tools, the agency ensures that anyone can use these resources.
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2023-03-29 14:49:05.0 [sritz] Rename Concept 
update PrefLabel (ENVIRONMENTAL JUSTICE); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2023-03-29 14:48:20.0 [sritz] Insert Concept 
add broader relation (Environmental Justice [9af548c9-7050-4d59-b66d-adf52f2fb242,1261752] - SOCIAL BEHAVIOR [c8317644-4cb2-4e37-b536-c762f7e670ab,1258564]); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Environmental justice is the fair treatment and meaningful involvement of all people regardless of race, color, national origin, or income, with respect to the development, implementation, and enforcement of environmental laws, regulations, and policies.  

Environmental Justice is becoming more important to the federal government and to individual agencies such as NASA and EPA.  Environmental Justice is also the driving force behind all of the UN’s Sustainable Development Goals.  NASA data are being used to support environmental and climate justice efforts. Scientists and decision-makers are applying a wide combination of datasets to assess the vulnerability and exposure of communities to environmental challenges. By providing full and open access to data, software, and tools, the agency ensures that anyone can use these resources.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">ENVIRONMENTAL JUSTICE</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx2322"/>
	<altLabel xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx2321"/>
</rdf:Description>

