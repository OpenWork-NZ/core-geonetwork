<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/4bc483b1-dd64-4e97-bfd3-c0e755df6308">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/0cfcbaa7-727b-4199-8cca-93824b427e9b"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-02-14 14:38:52.0 [mpmorahan] Move Concepts 
delete broader relation (null); 
add broader relation (CLOUD OPTICAL DEPTH/THICKNESS [4bc483b1-dd64-4e97-bfd3-c0e755df6308,63285] - CLOUD MICROPHYSICS [0cfcbaa7-727b-4199-8cca-93824b427e9b,82137]); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">The degree to which a cloud prevents light from passing through it.
Optical thickness depends upon the physical constitution (crystals, drop,
droplets), the form, the concentration of particles, and the vertical
extent of the cloud.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">CLOUD OPTICAL DEPTH/THICKNESS</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx1937"/>
</rdf:Description>

