	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-04-02 08:29:58.0 [tbs1979]  
insert Definition (id: null
text: A type of distinctive, flat-topped, steep-sided volcano formed when lava  erupts through a thick glacier or ice sheet. They are somewhat rare worldwide, being confined to regions which were formerly covered by continental ice sheets and also had active volcanism during the same time period.
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-02-18 11:58:31.0 [tbs1979] Insert Concept 
