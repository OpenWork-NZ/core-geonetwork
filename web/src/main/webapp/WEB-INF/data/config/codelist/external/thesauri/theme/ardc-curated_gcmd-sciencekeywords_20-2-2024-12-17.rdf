	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-08-05 13:59:06.0 [tbs1979] Insert Concept 
add broader relation (OROGENIC MOVEMENT [f486acc8-0d0c-4322-bf5c-177bc632bd76,105409] - TECTONIC PROCESSES [99b4792a-9ea3-4756-a4dc-b1b30c946b54,86001]); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-08-16 12:09:21.0 [tbs1979]  
insert Definition (id: null
text: The formation of mountain ranges by intense upward displacement of the earth's crust, usually associated with folding, thrust faulting, and other compressional processes.
language code: en); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">The formation of mountain ranges by intense upward displacement of the earth's crust, usually associated with folding, thrust faulting, and other compressional processes.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">OROGENIC MOVEMENT</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx115"/>
</rdf:Description>

