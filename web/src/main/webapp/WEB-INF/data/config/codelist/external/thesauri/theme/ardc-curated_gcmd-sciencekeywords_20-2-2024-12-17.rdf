<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/8945d3c7-1c39-4a8b-b954-2a84da8ecc88">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
