<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/47ea7cc6-2816-4d64-ad41-6ac1d11c2a33">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/bdc0bd86-a3a3-48fa-b1fb-4ca5d13d4dde"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-08-15 12:37:57.0 [tbs1979]  
insert Definition (id: null
text: Also known as a river cliff, is an erosional feature of streams. Cut banks are found in abundance along mature or meandering streams, they are located on the outside of a stream bend, known as a meander.
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2024-10-29 09:44:55.0 [tstevens]  
