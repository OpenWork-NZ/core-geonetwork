</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/914a7dba-82ae-4419-97cf-397007ad9c30">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/8799f524-e313-4d2d-9428-8d672d123513"/>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">An important baseline measurement in ice cores is electrical conductivity.
Electrical conductivity measurements (ECM) of the core is a very rapid method
to indicate how acidic the core is without the chemical detail of the ion
analyses. The value of the measurement is that it can be done for the whole
length of the core in high resolution and provide an immediate picture of the
core and allow quick detection of interesting areas, such as a volcanic
eruptions. Because it is a high resolution, continuous measurement it can be
used, along with the other measurements, for time frequency analysis in order
to identify cycles in the climate signal.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">ELECTRICAL PROPERTIES</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx1991"/>
</rdf:Description>

<rdf:Description rdf:nodeID="node1igi5qapbx1991">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<text xmlns="https://gcmd.earthdata.nasa.gov/kms#" xml:lang="en">GISP2 (Greenland) Ice Cores and Climate Change: http://www.gisp2.sr.unh.edu/GISP2/MoreInfo/Ice_Cores_Past.html "</text>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/994cc55d-b789-4f03-98dc-4cd0f58ad12a">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/9246fc12-17e7-4473-b9c0-c23e4bfc4eda"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2024-10-08 13:42:46.0 [tstevens]  
insert Definition (id: null
text: Refers decrease in snow cover. Researchers found snow cover is declining in nearly twice as many grids as it advances. Arctic areas are showing heavy snow cover loss. Along with the general snow decline, there is also a shift in snow coverage. Snow is coming earlier and going away earlier. Snow cover is trending more in November and declining from February to late spring and early summer.
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2012-06-26 12:33:48.0 [gee-cee] Insert Concept 
add broader relation (SNOW COVER DEGRADATION [994cc55d-b789-4f03-98dc-4cd0f58ad12a,39877] - TERRESTRIAL HYDROSPHERE INDICATORS [9246fc12-17e7-4473-b9c0-c23e4bfc4eda,39869]); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Refers decrease in snow cover. Researchers found snow cover is declining in nearly twice as many grids as it advances. Arctic areas are showing heavy snow cover loss. Along with the general snow decline, there is also a shift in snow coverage. Snow is coming earlier and going away earlier. Snow cover is trending more in November and declining from February to late spring and early summer.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">SNOW COVER DEGRADATION</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx1992"/>
</rdf:Description>

