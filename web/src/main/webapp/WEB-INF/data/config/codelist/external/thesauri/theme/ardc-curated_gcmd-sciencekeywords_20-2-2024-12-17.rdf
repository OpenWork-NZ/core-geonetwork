<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/e96f2d1a-432e-44e4-bc88-6f8f35ae88fb">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/1532e590-a62d-46e3-8d03-2351bc48166a"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2014-04-14 14:41:43.0 [128.183.164.42] Move Concepts 
delete broader relation (null); 
add broader relation (VIRGA [e96f2d1a-432e-44e4-bc88-6f8f35ae88fb,106311] - HYDROMETEORS [280b66ac-b3a9-45da-8eb1-ba1db93f5149,86517]); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2014-04-14 14:23:59.0 [128.183.164.42] Insert Concept 
add broader relation (VIRGA [e96f2d1a-432e-44e4-bc88-6f8f35ae88fb,106311] - HYDROMETEORS OBSERVED [9832fd10-0a53-44d4-88d7-018cc51ac93e,106307]); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2014-04-14 16:21:31.0 [128.183.164.42] added definition  
insert Definition (id: null
text: (Also called Fallstreifen, fallstreaks, precipitation trails.) Wisps or streaks of water or ice particles falling out of a cloud but evaporating before reaching the earth's surface as precipitation.
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2015-03-04 16:10:15.0 [saritz] Move Concepts 
delete broader relation (null); 
add broader relation (VIRGA [e96f2d1a-432e-44e4-bc88-6f8f35ae88fb,106311] - PRECIPITATION [1532e590-a62d-46e3-8d03-2351bc48166a,83877]); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">(Also called Fallstreifen, fallstreaks, precipitation trails.) Wisps or streaks of water or ice particles falling out of a cloud but evaporating before reaching the earth's surface as precipitation.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">VIRGA</prefLabel>
