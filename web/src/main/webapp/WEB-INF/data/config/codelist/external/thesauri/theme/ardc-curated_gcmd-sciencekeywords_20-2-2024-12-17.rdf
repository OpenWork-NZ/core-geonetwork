	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/2095acb5-14af-40fe-af22-e6af2e3528b5"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2017-03-15 11:26:01.0 [mgenazzi] Definition added 
insert Definition (id: null
text: Haptophytes are a clade of heterokont algae with smooth flagella. Haptophytes are typically eukaryotic, with a central nucleus and are characterized with a haptonema organelle.
language code: en); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Haptophytes are a clade of heterokont algae with smooth flagella. Haptophytes are typically eukaryotic, with a central nucleus and are characterized with a haptonema organelle.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">HAPTOPHYTES</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx2132"/>
	<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/e88cc54b-7a4b-4680-b441-4d10a4534cd9"/>
</rdf:Description>

