<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/71c78d69-9cfe-48e9-8dd2-9c75acf22283">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/457883c4-b30c-4d26-bed8-6c2887ebbc90"/>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Attenuation is the exponential loss of light intensity as light
propagates through water. Attenuation is caused by absorption and
scattering of light energy. Transmission is the measurement of the
percentage of light received at a photo cell placed at fixed distances
from a light source.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">ATTENUATION/TRANSMISSION</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx188"/>
</rdf:Description>

