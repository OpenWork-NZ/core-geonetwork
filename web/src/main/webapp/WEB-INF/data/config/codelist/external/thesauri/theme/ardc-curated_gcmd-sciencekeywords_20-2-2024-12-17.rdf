<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/d0931461-2e93-418c-b470-a218cadcf498">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
