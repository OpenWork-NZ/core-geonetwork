	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2017-03-15 11:53:28.0 [mgenazzi] Definition updated 
update Definition (An area of land that is always soaked with water; low, wet land that supports grass and trees. Swamps are wet areas that are normally covered by water all year and subject to drying out during the summer.  The parameter Swamp may be colloquially interchanged with the parameter Marshes.); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-08-15 13:16:27.0 [tbs1979]  
insert Definition (id: null
text: An area of land that is always soaked with water; low, wet land that supports grass and trees.
language code: en); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">An area of land that is always soaked with water; low, wet land that supports grass and trees. Swamps are wet areas that are normally covered by water all year and subject to drying out during the summer.  The parameter Swamp may be colloquially interchanged with the parameter Marshes.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">SWAMP</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx2115"/>
</rdf:Description>

