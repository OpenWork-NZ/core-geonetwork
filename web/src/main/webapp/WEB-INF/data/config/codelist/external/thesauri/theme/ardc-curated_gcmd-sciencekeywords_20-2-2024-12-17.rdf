<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/6b2fad63-2230-4d54-8f31-fee604d1f977">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/464de0a5-2bb9-4172-9fd3-1634cbc4e739"/>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">The act of restoring a community or ecosystem to its original pre-hazard state.
Relief refers to assistance that eases the financial, physical, or emotional
burden brought about by exposure of property or person to natural hazards or
disasters.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">DISASTER RECOVERY/RELIEF</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx213"/>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/464de0a5-2bb9-4172-9fd3-1634cbc4e739">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/894f9116-ae3c-40b6-981d-5113de961710"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2019-07-25 08:23:30.0 [tstevens] Insert Concept 
add narrower relation (HAZARDS MANAGEMENT [464de0a5-2bb9-4172-9fd3-1634cbc4e739,84355] - HAZARD MAPPING [c9a13e09-98de-4ace-8d4c-b01aa04347f4,368979]); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">A problem-solving process aimed at defining problems (identifying hazards), gathering information about them (assessing the risks) and solving them (controlling the risks). Where a control has been used to address an identified hazard, this should be reviewed by checking the effectiveness of the control (evaluation). The whole hazard management process should also be reviewed after a period of time or when something changes.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">HAZARDS MANAGEMENT</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx1570"/>
	<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/6b2fad63-2230-4d54-8f31-fee604d1f977"/>
	<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/c9a13e09-98de-4ace-8d4c-b01aa04347f4"/>
	<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/5c14b001-518f-460b-90fe-139bf192d1f2"/>
	<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/d7aa220d-4012-4ab1-98c8-0cc4157a48f3"/>
	<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/a2e9c7b9-96fd-449f-91db-7ab5e2dd679e"/>
</rdf:Description>

