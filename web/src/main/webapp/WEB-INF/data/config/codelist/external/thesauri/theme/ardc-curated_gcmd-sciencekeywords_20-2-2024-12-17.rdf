	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-03-05 08:39:18.0 [tbs1979] Insert Concept 
add broader relation (RIBBED/ROGAN MORAINE [a389919c-a6da-465e-b074-ea29b66a686b,82767] - MORAINES [4f590d94-110c-4762-9171-aba6d24af6a0,82759]); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-04-01 10:33:08.0 [tbs1979]  
insert Definition (id: null
text: Type of basal moraines that forms a series of ribs perpendicular to the ice flow in an ice sheet. The depressions between the ribs are sometimes filled with water making the Rogen moraines look like tigerstripes on aerial photographs.
language code: en); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Type of basal moraines that forms a series of ribs perpendicular to the ice flow in an ice sheet. The depressions between the ribs are sometimes filled with water making the Rogen moraines look like tigerstripes on aerial photographs.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">RIBBED/ROGAN MORAINE</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx2101"/>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/a4f0e7c2-711e-4675-b7c8-f5430905aa89">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/4f590d94-110c-4762-9171-aba6d24af6a0"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-04-01 10:30:43.0 [tbs1979]  
insert Definition (id: null
text: Parallel ridges of debris deposited along the sides of a glacier. The unconsolidated debris can be deposited on top of the glacier by frost shattering of the valley walls and from tributary streams flowing into the valley.
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-03-05 08:38:11.0 [tbs1979] Insert Concept 
