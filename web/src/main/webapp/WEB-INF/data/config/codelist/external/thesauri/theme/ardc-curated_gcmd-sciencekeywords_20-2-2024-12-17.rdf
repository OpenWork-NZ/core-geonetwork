insert Definition (id: null
text: National Snow and Ice Data Center, Distributed Active Archive Center
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2023-02-24 12:10:35.0 [sritz] Insert Concept 
