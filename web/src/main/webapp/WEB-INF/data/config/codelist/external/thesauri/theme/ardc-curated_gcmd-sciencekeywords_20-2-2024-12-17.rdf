add narrower relation (DUNES [416221ec-04e1-4913-aacb-9045551949c4,105421] - DOME DUNE [cb6b9191-21ab-4a56-b43f-27e86f90f6d9,105425]); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-08-16 14:40:26.0 [tbs1979]  
insert Definition (id: null
text: A hill of sand built by aeolian processes. Dunes occur in different forms and sizes, formed by interaction with the wind. Most kinds of dunes are longer on the windward side where the sand is pushed up the dune and have a shorter "slip face" in the lee of the wind.
language code: en); 
</changeNote>
