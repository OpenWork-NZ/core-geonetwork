</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/4d95ccc8-3ef9-40df-85e7-db36cb815499">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/8603db51-3484-4439-8b3b-a06f48e8c686"/>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">A massive piece of ice of greatly varying shape, protruding 5 m or more&#xD;
above sea- level, which has broken away from a glacier and which may be&#xD;
afloat or aground. They may be described as tabular, domed, pinnacled,&#xD;
wedged, drydocked or blocky. Sizes of icebergs are classed as small,&#xD;
medium, large and very large.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">ICEBERGS</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx2962"/>
</rdf:Description>

