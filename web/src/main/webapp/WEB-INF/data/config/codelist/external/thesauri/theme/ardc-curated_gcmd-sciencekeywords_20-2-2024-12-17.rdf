<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/6971fecc-af14-4c97-82db-2b01c98453b9">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/c9a5b3eb-7556-41a8-a2b8-c015db80e5b2"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2012-07-26 14:26:14.0 [mpmorahan]  
insert Definition (id: null
text: a theory in geology: the lithosphere of the earth is divided into a small number of plates which float on and travel independently over the mantle and much of the earth's seismic activity occurs at the boundaries of these plates
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2012-07-26 14:42:21.0 [mpmorahan]  
update Definition (A theory of global tectonics in which the lithosphere is divided into a number of plates whose pattern of horizontal movement is that of torsionally rigid bodies that interact with one another at their boundaries, causing seismic and tectonic activity along these boundaries.); 
update Definition (Jackson, J.A.(1997) Glossary of Geology. 4th ed. Alexandria, VA:American Geological Institute.769 p.); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2012-06-26 15:25:02.0 [gee-cee] Insert Concept 
add broader relation (PLATE TECTONICS [6971fecc-af14-4c97-82db-2b01c98453b9,40087] - PALEOCLIMATE INDICATORS [c9a5b3eb-7556-41a8-a2b8-c015db80e5b2,39947]); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">A theory of global tectonics in which the lithosphere is divided into a number of plates whose pattern of horizontal movement is that of torsionally rigid bodies that interact with one another at their boundaries, causing seismic and tectonic activity along these boundaries.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">PLATE TECTONICS</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx562"/>
</rdf:Description>

