<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/e749bafe-9a0a-42cc-bed8-9b42e3e088c8">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/b41894fa-2e3e-475b-b8f0-b6ffdd2d6e9c"/>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Measurements related to any deviation from a normal state of health in
animals which temporarily or permanently impairs vital functions.	It may
be caused by insect pests, viruses, pathogenic bacteria, parasites, poor
nutrition congenital or inherent deficiencies, unfavorable environment, or
any combination of these, and related pests.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">ANIMAL DISEASES/DISORDERS/PESTS</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx187"/>
</rdf:Description>

