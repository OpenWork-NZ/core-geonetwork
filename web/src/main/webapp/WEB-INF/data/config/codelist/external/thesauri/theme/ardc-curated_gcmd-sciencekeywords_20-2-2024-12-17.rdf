	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Areas of marsh grasses and reeds along coasts and estuaries where the ground is covered by high tides but drained at low tide.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">ESTUARINE WETLANDS</prefLabel>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/dd22cc67-afd5-4b9e-8072-90651a191486">
