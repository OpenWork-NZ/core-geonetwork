insert Definition (id: null
text: Air temperature measured with a thermometer, similar to dry-bulb temperature.
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-03-05 09:49:12.0 [tbs1979] Insert Concept 
