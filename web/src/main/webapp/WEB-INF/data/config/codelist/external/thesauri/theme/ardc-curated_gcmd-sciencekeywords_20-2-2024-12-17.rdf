</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/8251fedc-3910-4f18-9594-df2fbb9bb1d9">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/25775905-dac3-4834-b709-f38a0a03b258"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2017-04-20 15:12:25.0 [sritz] Insert Concept 
add broader relation (GOES WIND INDEX [8251fedc-3910-4f18-9594-df2fbb9bb1d9,278905] - WIND INDICES [25775905-dac3-4834-b709-f38a0a03b258,278861]); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2017-04-21 11:35:20.0 [tstevens]  
insert Definition (id: null
text: A GOES sounder-derived parameter used for estimating the maximum convective wind gusts is the Wind Index (WINDEX). The Wind Index is plotted on regional GOES images (visible, infrared, or water vapor) and made available on the GOES Microburst Products web page.
language code: en); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">A GOES sounder-derived parameter used for estimating the maximum convective wind gusts is the Wind Index (WINDEX). The Wind Index is plotted on regional GOES images (visible, infrared, or water vapor) and made available on the GOES Microburst Products web page.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">GOES WIND INDEX</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx2725"/>
</rdf:Description>

