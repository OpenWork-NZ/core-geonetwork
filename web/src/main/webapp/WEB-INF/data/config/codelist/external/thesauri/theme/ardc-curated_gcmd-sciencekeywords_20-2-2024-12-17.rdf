<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/93c1a177-70e3-4c33-a183-baff7f401697">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/63bc0693-52eb-4ebd-a39e-e77e96409072"/>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">The physical process by which a vapor becomes a liquid or solid. In the
heat budget of the ocean, the rate of heat gain can be affected by the
condensation.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
