insert Definition (id: null
text: Sea turtles are marine reptiles with streamlined bodies and large flippers that are well-adapted to life in the tropical and subtropical oceans. Sea turtles are reptiles of the order Testudines and of the suborder Cryptodira.
language code: en); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Sea turtles are marine reptiles with streamlined bodies and large flippers that are well-adapted to life in the tropical and subtropical oceans. Sea turtles are reptiles of the order Testudines and of the suborder Cryptodira.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
