<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/1eb6eeff-77f8-40b6-8e4a-2e4438f00b10">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/b73cee46-8e2c-4df9-b1ed-7f0aa98a04ac"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2012-06-29 13:55:45.0 [tbs1979]  
insert Definition (id: null
text: Refers to the production and use of tidal energy for human consumption. Tidal energy is the energy involved in tidal movements of water which is available to be harnessed if those movements can be used to turn turbines.
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2012-06-26 15:47:23.0 [tbs1979] Insert Concept 
add broader relation (TIDAL ENERGY PRODUCTION/USE [1eb6eeff-77f8-40b6-8e4a-2e4438f00b10,40121] - ENERGY PRODUCTION/USE [b73cee46-8e2c-4df9-b1ed-7f0aa98a04ac,40101]); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Refers to the production and use of tidal energy for human consumption. Tidal energy is the energy involved in tidal movements of water which is available to be harnessed if those movements can be used to turn turbines.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">TIDAL ENERGY PRODUCTION/USE</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx1184"/>
</rdf:Description>

