	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2012-07-26 18:23:08.0 [mpmorahan]  
insert Definition (id: null
text: The measurment of the flow of water in a stream, usually expressed in cubic feet per second; the net effect of storms, accumulation, transpiration, meltage, seepage, evaporation, and percolation.
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2012-06-26 12:32:23.0 [gee-cee] Insert Concept 
add broader relation (FRESHWATER RUNOFF [915399a1-eb5b-475b-ae9a-ff45f1dcddc9,39875] - TERRESTRIAL HYDROSPHERE INDICATORS [9246fc12-17e7-4473-b9c0-c23e4bfc4eda,39869]); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">The measurment of the flow of water in a stream, usually expressed in cubic feet per second; the net effect of storms, accumulation, transpiration, meltage, seepage, evaporation, and percolation.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
