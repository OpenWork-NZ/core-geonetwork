	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/26afa886-4866-4536-be3a-6f9db9aacd97"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2021-10-19 12:43:13.0 [tstevens]  
insert Definition (id: null
text: Partial pressure of carbon dioxide at the surface of the sea. C02 at the sea surface that can be measured from ships and other systems as an indicator for ocean acidification.
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2021-10-19 12:41:36.0 [tstevens] Insert Concept 
add broader relation (CARBON DIOXIDE PARTIAL PRESSURE [6bf8c40d-6bc0-410b-92a5-349bd88dc021,778204] - CARBON DIOXIDE [26afa886-4866-4536-be3a-6f9db9aacd97,776170]); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Partial pressure of carbon dioxide at the surface of the sea. C02 at the sea surface that can be measured from ships and other systems as an indicator for ocean acidification.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
