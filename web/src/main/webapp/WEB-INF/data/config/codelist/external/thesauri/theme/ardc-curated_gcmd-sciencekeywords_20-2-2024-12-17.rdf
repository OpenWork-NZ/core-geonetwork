<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/fb4834d9-7bfe-4283-86f7-931532baa79c">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/abc6f016-d1f0-4725-b847-639de054d13f"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2017-03-15 08:39:30.0 [mgenazzi] Definition added 
insert Definition (id: null
text: Phylum Tardigrada. Commonly known as Water Bears are extremophilic, water-dwelling, eight-legged semented micro-animals.
language code: en); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Phylum Tardigrada. Commonly known as Water Bears are extremophilic, water-dwelling, eight-legged semented micro-animals.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">WATER BEARS (TARDIGRADES)</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx2229"/>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/e3425c65-ead7-4bf6-942c-7176a1469b58">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/abc6f016-d1f0-4725-b847-639de054d13f"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2017-03-13 14:10:21.0 [mgenazzi] Definition added 
insert Definition (id: null
text: Phylum Nematomorpha, commonly known as horsehair worms, are parasitoid animals on arthropods. They have cilia on an external cuticle, and only have longitudinal muscle, a nerve ring near the anterior, and non-functional gut with no respiratory, excretory or circulatory system.
language code: en); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Phylum Nematomorpha, commonly known as horsehair worms, are parasitoid animals on arthropods. They have cilia on an external cuticle, and only have longitudinal muscle, a nerve ring near the anterior, and non-functional gut with no respiratory, excretory or circulatory system.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">HORSEHAIR WORMS</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx1973"/>
</rdf:Description>

