</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-02-14 10:40:00.0 [mpmorahan] Insert Concept 
add narrower relation (STRATOCUMULUS [3375096a-7782-42e8-97d2-0febf63893e0,82231] - STRATOCUMULUS UNDULATAS [bec5166e-1822-40f7-8f07-4d5167d8a565,82253]); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2024-10-09 10:18:39.0 [tstevens]  
insert Definition (id: null
text: Low-level clumps or patches of cloud varying in color from bright white to dark grey. They are the most common clouds on earth recognized by their well-defined bases, with some parts often darker than others. They usually have gaps between them, but they can also be joined together.
language code: en); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Low-level clumps or patches of cloud varying in color from bright white to dark grey. They are the most common clouds on earth recognized by their well-defined bases, with some parts often darker than others. They usually have gaps between them, but they can also be joined together.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">STRATOCUMULUS</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx2041"/>
	<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/5857260b-1de6-47c2-8f66-5c0dbac42e32"/>
	<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/bec5166e-1822-40f7-8f07-4d5167d8a565"/>
	<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/b1d51b72-97d0-484c-b251-220f219965c2"/>
</rdf:Description>

