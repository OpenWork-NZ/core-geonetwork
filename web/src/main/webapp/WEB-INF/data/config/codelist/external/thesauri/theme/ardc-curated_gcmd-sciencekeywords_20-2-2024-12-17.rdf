	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2017-03-13 14:16:39.0 [mgenazzi] Definition added 
insert Definition (id: null
text: Phylum Mollusca. Class Bivalvia. Sedentary bivalve characterized by two-part shell of calcium carbonate secreted by the mantle and joined by a ligamentous hinge held shut by adducter muscles distinguished by a rough, irregular shell shape.
language code: en); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Phylum Mollusca. Class Bivalvia. Sedentary bivalve characterized by two-part shell of calcium carbonate secreted by the mantle and joined by a ligamentous hinge held shut by adducter muscles distinguished by a rough, irregular shell shape.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
