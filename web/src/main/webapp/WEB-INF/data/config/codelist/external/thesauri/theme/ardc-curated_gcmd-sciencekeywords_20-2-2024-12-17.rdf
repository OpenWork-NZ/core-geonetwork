<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/436b098d-e4d9-4fbd-9ede-05675e111eee">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/868b87a1-d8c2-49b3-8bbd-9cbbed115271"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2016-03-30 14:10:55.0 [gee-cee] Insert Concept 
add broader relation (Burned Area [436b098d-e4d9-4fbd-9ede-05675e111eee,158719] - WILDFIRES [868b87a1-d8c2-49b3-8bbd-9cbbed115271,86199]); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2016-03-30 14:13:27.0 [gee-cee]  
update PrefLabel (BURNED AREA); 
insert Definition (id: null
text: Characterized by deposits of charcoal and ash, removal of vegetation, and alteration of the vegetation structure, Pereira et al. 1997, Roy et al. 1999
language code: en); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Characterized by deposits of charcoal and ash, removal of vegetation, and alteration of the vegetation structure, Pereira et al. 1997, Roy et al. 1999</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">BURNED AREA</prefLabel>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/868b87a1-d8c2-49b3-8bbd-9cbbed115271">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/ec0e2762-f57a-4fdc-b395-c8d7d5590d18"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2012-07-11 11:15:31.0 [tbs1979]  
update Definition (National Interagency Fire Center); 
update Definition (An uncontrolled fire in combustible vegetation that occurs in the countryside or a wilderness area. Other names such as brush fire, bushfire, forest fire, desert fire, grass fire, hill fire, peat fire, vegetation fire, and veldfire may be used to describe the same phenomenon depending on the type of vegetation being burned. A wildfire differs from other fires by its extensive size, the speed at which it can spread out from its original source, its potential to change direction unexpectedly, and its ability to jump gaps such as roads, rivers and fire breaks. Wildfires are characterized in terms of the cause of ignition, their physical properties such as speed of propagation, the combustible material present, and the effect of weather on the fire.); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2012-06-27 14:11:23.0 [tbs1979]  
update PrefLabel (WILDFIRES ); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2012-06-27 14:12:17.0 [tbs1979] Insert Concept 
add narrower relation (WILDFIRES  [868b87a1-d8c2-49b3-8bbd-9cbbed115271,22743] - WILDFIRE SUPPRESSION [5e693789-87a8-4f94-9b5d-a50cecf55e24,40213]); 
</changeNote>
