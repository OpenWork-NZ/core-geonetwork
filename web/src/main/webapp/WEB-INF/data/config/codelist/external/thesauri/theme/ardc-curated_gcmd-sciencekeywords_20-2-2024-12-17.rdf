<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/18a8197e-3a3f-408c-9c51-e9fe89dd6b45">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/afd084b9-1f4c-4eb5-a58e-689a360e7abf"/>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Any natural or manufactured material added to the soil in order to supply
one or more plant nutrients.  The term is generally applied to inorganic
materials other than lime or gypsum sold in the trade.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">FERTILIZERS</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx1312"/>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/afd084b9-1f4c-4eb5-a58e-689a360e7abf">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/a956d045-3b12-441c-8a18-fac7d33b2b4e"/>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">A term used to designate chemical materials used in Agriculture such
as herbicides, insecticides, fungicides, and fertilizers. Does NOT include
food or feed additives, or animal hormones.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">AGRICULTURAL CHEMICALS</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx2070"/>
