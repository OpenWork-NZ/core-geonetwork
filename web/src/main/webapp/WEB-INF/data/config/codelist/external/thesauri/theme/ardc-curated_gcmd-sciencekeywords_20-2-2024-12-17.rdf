add broader relation (AEROSOL FRACTION [101c2cd2-b135-430b-a9c6-b710dee48d78,560185] - AEROSOL BACKSCATTER [f795b88f-1aba-4548-97f6-7b587e8ba451,85545]); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">The fraction of liquid phase, 1 - x, which, after flashing to the atmosphere, remains suspended as an aerosol.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">AEROSOL FRACTION</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx1553"/>
</rdf:Description>

