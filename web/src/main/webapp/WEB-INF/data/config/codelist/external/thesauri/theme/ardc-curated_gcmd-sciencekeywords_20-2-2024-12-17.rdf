</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2024-08-09 11:58:15.0 [sritz]  
insert Definition (id: null
text: Definition: Ice that is anchored to the shore or ocean bottom, typically over shallow ocean shelves at continental margins. Fast ice does not move with the winds or currents. Also known as landfast ice.
language code: en); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Ice that is anchored to the shore or ocean bottom, typically over shallow ocean shelves at continental margins. Fast ice does not move with the winds or currents. Also known as landfast ice.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
