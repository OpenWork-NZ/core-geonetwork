	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Measurement of the degree of scattering of light in water, related to
the amount of suspended material in the water.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">TURBIDITY</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx579"/>
</rdf:Description>

