<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/a5aa7055-642d-4442-9b4b-76a759e15257">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/08fd82a1-4370-46a2-82ea-94c0f91498a7"/>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">The pressure in a fluid in hydrostatic equilibrium - that is , the
downward pressure at a point due solely to the weight of fluid in a column
of unit cross-sectional area.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">HYDROSTATIC PRESSURE</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx1359"/>
</rdf:Description>

