<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/d37d51e0-1bef-473a-9221-6713166762f9">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/b895f4b5-5273-49ef-883f-b67d9f199505"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-08-06 14:37:47.0 [tbs1979] Insert Concept 
add broader relation (ARETES [d37d51e0-1bef-473a-9221-6713166762f9,105599] - GLACIAL LANDFORMS [b895f4b5-5273-49ef-883f-b67d9f199505,105287]); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-08-23 14:47:25.0 [tbs1979]  
insert Definition (id: null
text: An arete is a thin, almost knife-like, ridge of rock which is typically formed when two glaciers erode parallel U-shaped valleys. The arête is a thin ridge of rock that is left separating the two valleys.
language code: en); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">An arete is a thin, almost knife-like, ridge of rock which is typically formed when two glaciers erode parallel U-shaped valleys. The arête is a thin ridge of rock that is left separating the two valleys.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">ARETES</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx1497"/>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/0557b602-cf85-4b04-82a7-ca76f364e5f4">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/b895f4b5-5273-49ef-883f-b67d9f199505"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-08-26 08:43:57.0 [tbs1979]  
insert Definition (id: null
text: A steep conical hill composed of glaciofluvial sediments. This feature develops when glacial crevasses and depressions in stagnant glacial ice are filled with sand and gravel deposits from sediment loaded meltwater.
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2024-10-31 08:32:36.0 [tstevens]  
