update PrefLabel (HARMFUL ALGAL BLOOM (HABs)); 
insert Definition (id: null
text: Forecasting, modeling, and/or observations of harmful algal blooms (colonies of algae that grow in dense concentrations and produce toxic or harmful effects on people, fish, shellfish, marine mammals, and/or birds).
language code: en); 
