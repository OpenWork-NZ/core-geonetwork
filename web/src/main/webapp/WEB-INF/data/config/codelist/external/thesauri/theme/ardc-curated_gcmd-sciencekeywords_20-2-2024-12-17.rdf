	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2017-03-15 09:20:52.0 [mgenazzi] Definition added 
insert Definition (id: null
text: Phylum Chordata. Class Reptilia. Order Squamata. Lizards typically have feet and external ears. Snakes are elongated, legless, carnivorous reptiles with skin covered in scales.
language code: en); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Phylum Chordata. Class Reptilia. Order Squamata. Lizards typically have feet and external ears. Snakes are elongated, legless, carnivorous reptiles with skin covered in scales.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
