	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2012-07-03 12:37:24.0 [mpmorahan]  
insert Definition (id: null
text: Extreme Drought - Major crop/pasture losses;  widespread water shortages or restrictions
Palmer Drought Index: -4.0 to -4.9
CPC Soil Moisture Model (Percentiles): 3-5
USGS Weekly Streamflow (Percentiles): 3-5
Standardized Precipitation Index (SPI): -1.6 to -1.9
Objective Short and Long-term Drought Indicator Blends (Percentiles): 3-5
language code: en); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Extreme Drought - Major crop/pasture losses;  widespread water shortages or restrictions
