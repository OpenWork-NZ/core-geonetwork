<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/b2800856-f1e3-41aa-bdc4-75e9cd626d3f">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/099ab1ae-f4d2-48cc-be2f-86bd58ffc4ca"/>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">A continuous sheet of land ice that covers a very large area and moves outward&#xD;
in many directions. This type of ice mass is so thick as to mask the land&#xD;
surface contours, in contrast to the smaller and thinner highland ice. The&#xD;
continental glacier of Greenland is sometimes called the Inland Ice. This term&#xD;
is often used to describe the great ice masses that characterized the ice ages.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">ICE SHEETS</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx852"/>
</rdf:Description>

