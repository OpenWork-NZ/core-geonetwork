add broader relation (PALEOVEGETATION [fbd867cf-f7e8-4dbc-9fd2-2ccc0728350f,39965] - BIOLOGICAL RECORDS [5553fe9d-ab0a-4305-86a6-1f7f697e15e4,39951]); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2012-07-19 15:17:18.0 [mpmorahan]  
insert Definition (id: null
text: Paleovegetation refers to plant species that were living at some time in the past. Indicators of past vegetation include pollen and plant macrofossils. Animal fossils and sedimentary indicators can also be used to reconstruct past vegetation.
language code: en); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Paleovegetation refers to plant species that were living at some time in the past. Indicators of past vegetation include pollen and plant macrofossils. Animal fossils and sedimentary indicators can also be used to reconstruct past vegetation.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
