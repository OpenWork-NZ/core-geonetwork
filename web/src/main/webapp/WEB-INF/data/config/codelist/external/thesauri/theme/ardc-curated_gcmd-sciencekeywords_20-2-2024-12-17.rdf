	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">The areal extent of vegetation-covered ground, expressed as the mathematical fraction of a region covered with vegetation.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">VEGETATION FRACTION</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx1387"/>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/86dfb9ca-6587-4a91-b397-f220bb48a1eb">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/c7b5c02c-724d-4a19-b824-98180f3900c9"/>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Reclamation, as used here refers, to putting a natural resource to a new
or altered use.  Restoration is the return of an ecosystem to a
close approximation of its condition prior to disturbance. Revegetation is
the planting of vegetation in an area where vegetation has been removed.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">RECLAMATION/REVEGETATION/RESTORATION</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx2466"/>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/c59b0666-e20f-4134-847b-89719ed5621a">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/c7b5c02c-724d-4a19-b824-98180f3900c9"/>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">The crown is the horizontal layer of the vegetation where most of the
branches and foliage are found.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">CROWN</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx2517"/>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/bf0ddf9c-39ba-4b2d-91ac-63021d644276">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/c7b5c02c-724d-4a19-b824-98180f3900c9"/>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Macrophytes are macroscopic vegetation.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">MACROPHYTES</prefLabel>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/a28eeef3-b252-4309-957b-860d2e0f97ef">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/c7b5c02c-724d-4a19-b824-98180f3900c9"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2024-09-25 09:43:31.0 [tstevens]  
update Definition (Afforestation is the establishment of trees on an area that has lacked forest
cover for a very long time or has never been forested. Reforestation is the
natural or artificial restocking (i.e., planting, seeding) of an area with
forest trees. Also called forest regeneration.); 
update Definition (From the Glossary of Forestry Terms, Ministry of Forests, Government of British
Columbia, Canada
"http://www.for.gov.bc.ca/hfd/library/documents/glossary/"); 
insert WeightedRelation (id: null
related concept uuid: b3a1e091-0bc2-4c9b-a89c-bd003fdd5889
relationship type: null
relationship value: null
generated by: null); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Afforestation is the establishment of trees on an area that has lacked forest
cover for a very long time or has never been forested. Reforestation is the
natural or artificial restocking (i.e., planting, seeding) of an area with
forest trees. Also called forest regeneration.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">AFFORESTATION/REFORESTATION</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx2214"/>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/5bdb3251-4811-439c-b172-9bbcd98e84b3">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/c7b5c02c-724d-4a19-b824-98180f3900c9"/>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Vegetation Cover is the percent of vegetation in an area.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">VEGETATION COVER</prefLabel>
</rdf:Description>

