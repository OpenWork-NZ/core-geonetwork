	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/abc6f016-d1f0-4725-b847-639de054d13f"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2017-03-13 14:05:52.0 [mgenazzi] Definition added 
insert Definition (id: null
text: A phylum of small invertebrate aquatic animals typically having a cup-shaped body bearing tentacles and attached to the substrate by means of a stalk  characterized by having tentacles with a downstream-collecting ciliary system, an anus inside the ring of ciliated tentacles, and no coelomic canal.
language code: en); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">A phylum of small invertebrate aquatic animals typically having a cup-shaped body bearing tentacles and attached to the substrate by means of a stalk  characterized by having tentacles with a downstream-collecting ciliary system, an anus inside the ring of ciliated tentacles, and no coelomic canal.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">ENTOPROCTS</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx79"/>
</rdf:Description>

