<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/bf03dba8-2881-44ac-abfc-ba3353f67a24">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/1459a39c-4781-4481-8bd9-510762865efd"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2018-03-07 10:32:23.0 [tstevens]  
insert Definition (id: null
text: Nonmetallic element of Group 15 of the periodic table. It is a colourless, odourless, tasteless gas that is the most plentiful element in Earth’s atmosphere and is a constituent of all living matter.
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2018-03-07 08:02:02.0 [tstevens] Insert Concept 
add broader relation (NITROGEN [bf03dba8-2881-44ac-abfc-ba3353f67a24,310679] - NUTRIENTS [1459a39c-4781-4481-8bd9-510762865efd,86519]); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Nonmetallic element of Group 15 of the periodic table. It is a colourless, odourless, tasteless gas that is the most plentiful element in Earth’s atmosphere and is a constituent of all living matter.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">NITROGEN</prefLabel>
