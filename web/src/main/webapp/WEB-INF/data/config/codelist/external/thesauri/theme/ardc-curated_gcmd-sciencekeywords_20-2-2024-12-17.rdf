	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-02-18 12:20:42.0 [tbs1979] Insert Concept 
add broader relation (BARRIER ISLANDS [6e3135e9-6be6-4995-a5df-022f6a0cf45b,82555] - COASTAL LANDFORMS [c58320e6-3f1d-4c36-9bee-6bad73404c21,62739]); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-03-22 10:55:44.0 [tbs1979]  
insert Definition (id: null
text: A coastal landform and a type of barrier system, are relatively narrow strips of sand that parallel the mainland coast. They usually occur in chains, consisting of anything from a few islands to more than a dozen.
language code: en); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">A coastal landform and a type of barrier system, are relatively narrow strips of sand that parallel the mainland coast. They usually occur in chains, consisting of anything from a few islands to more than a dozen.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">BARRIER ISLANDS</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx816"/>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/8d4c5e9c-bdab-48c9-89da-1eb4b9a528ab">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/c58320e6-3f1d-4c36-9bee-6bad73404c21"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-03-29 10:35:29.0 [tbs1979]  
insert Definition (id: null
text: A landform, often referred to as a drowned river valley. Rias are almost always estuaries. Rias form where sea levels rise relative to the land either as a result of eustatic sea level change (where the global sea levels rise), or isostatic sea level change (where the local land sinks).
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-02-18 14:15:58.0 [tbs1979] Insert Concept 
add broader relation (RIA [8d4c5e9c-bdab-48c9-89da-1eb4b9a528ab,82605] - COASTAL LANDFORMS [c58320e6-3f1d-4c36-9bee-6bad73404c21,62739]); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">A landform, often referred to as a drowned river valley. Rias are almost always estuaries. Rias form where sea levels rise relative to the land either as a result of eustatic sea level change (where the global sea levels rise), or isostatic sea level change (where the local land sinks).</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">RIA</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx1817"/>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/ee1d9786-33e9-46dc-b859-25d18e9c8a88">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/c58320e6-3f1d-4c36-9bee-6bad73404c21"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2024-10-31 11:29:00.0 [tstevens]  
