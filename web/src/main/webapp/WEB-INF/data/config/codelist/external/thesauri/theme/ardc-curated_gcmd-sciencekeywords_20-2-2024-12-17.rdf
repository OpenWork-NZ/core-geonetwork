<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/13aeaea0-ab45-4148-abcf-c6becf7a8934">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/346cade5-801a-4afc-9652-48d02905bc4f"/>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">A state of fluid (wind) flow in which the instantaneous (wind)
velocities exhibit irregular and apparently random fluctuations so that in
practice only statistical properties can be recognized and subjected to
analysis.  &lt;/U&gt;&lt;/B&gt;</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">TURBULENCE</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx2539"/>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/ab1e152c-eab9-400a-a90f-15cb64ed2a75">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/346cade5-801a-4afc-9652-48d02905bc4f"/>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">The component of ocean wind motion rising perpendicular to the plane of
the horizon.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">VERTICAL WIND MOTION</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx3156"/>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/b9a716e9-970e-44e0-9faf-66647f5a59ed">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
