insert Definition (id: null
text: A natural flow of water from the sub-surface to the surface. Usually occurs when the water table intersects the Earth's surface.
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-08-05 12:38:20.0 [tbs1979] Insert Concept 
