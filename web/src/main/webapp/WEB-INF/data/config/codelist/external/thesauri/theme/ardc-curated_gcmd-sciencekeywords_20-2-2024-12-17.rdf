insert Definition (id: null
text: Small to medium-sized odontocetes that live in marine habitats, have conical teeth and a falcate dorsal fin set near the middle to the back.
language code: en); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Small to medium-sized odontocetes that live in marine habitats, have conical teeth and a falcate dorsal fin set near the middle to the back.</definition>
