<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/ba4a9964-8323-45df-a372-b4e2f3eef9e5">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/62019831-aaba-4d63-a5cd-73138ccfa5d0"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-03-21 14:17:41.0 [mpmorahan]  
insert Definition (id: null
text: (Also called Kármán vortex street, vortex trail, vortex train.) Two parallel rows of alternately placed vortices along the wake of an obstacle in a fluid of moderate Reynolds number.

Fluid drag can be calculated from the motion of these vortices, which are stable only for a certain ratio of the width of the street to the distance between vortices along the street.
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-02-14 12:48:23.0 [mpmorahan] Insert Concept 
