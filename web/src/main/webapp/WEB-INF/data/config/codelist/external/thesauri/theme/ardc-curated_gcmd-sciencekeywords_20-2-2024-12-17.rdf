</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2024-10-03 09:38:43.0 [tstevens]  
insert WeightedRelation (id: null
related concept uuid: 4519a99a-ffa7-436b-888a-c742c82b9ed1
relationship type: null
relationship value: null
generated by: null); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">The net balance between the sea ice mass gained by freezing and the loss of mass by melting that is a function of its extent and thickness, which combine to give its volume.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
