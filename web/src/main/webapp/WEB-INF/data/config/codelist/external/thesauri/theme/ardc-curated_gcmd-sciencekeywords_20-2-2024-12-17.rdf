insert Definition (id: null
text: The amount of sky estimated to be covered by a specified cloud type or level (partial cloud amount) or by all cloud types and levels (total cloud amount).
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2021-02-26 13:13:31.0 [tstevens] Insert Concept 
