	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Reports providing information on the cleanliness of air described in terms of
levels of contaminants in air especially with regard to their potential effects
on human health.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">AIR QUALITY</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx2016"/>
</rdf:Description>

