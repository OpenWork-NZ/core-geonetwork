	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/bfa56100-6fb5-4e49-9633-298fa3b45508"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2021-05-14 09:08:39.0 [tstevens]  
insert Definition (id: null
text: The sum of the mass of the atmosphere and ocean in a "cylinder" above the seafloor.
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2021-05-20 14:27:57.0 [tstevens]  
update Definition (https://podaac.jpl.nasa.gov/dataset/TELLUS_GRFO_L3_JPL_RL06_OCN_v03); 
</changeNote>
