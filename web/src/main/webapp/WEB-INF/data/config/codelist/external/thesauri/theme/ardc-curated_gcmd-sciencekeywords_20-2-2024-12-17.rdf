<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/a389919c-a6da-465e-b074-ea29b66a686b">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
