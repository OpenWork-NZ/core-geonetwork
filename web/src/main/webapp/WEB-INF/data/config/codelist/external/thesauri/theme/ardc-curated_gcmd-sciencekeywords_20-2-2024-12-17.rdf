<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/68d0f29d-cf46-4f8c-8cad-83817a7093bc">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/8603db51-3484-4439-8b3b-a06f48e8c686"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2017-03-15 13:13:23.0 [mgenazzi] Definition added 
insert Definition (id: null
text: At the base of a glacier with minimal slope, the normal stress (σ) acting on the bed is mainly a result of the weight of a glacier.
language code: en); 
