<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/88e39edc-bf9b-4c02-8a9d-83f9b6c01891">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/0ffab597-284f-4d1a-b026-a78a6604cec5"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2014-04-14 16:19:55.0 [128.183.164.42] added definition  
update Definition (Drizzle that falls in liquid form but freezes upon impact to form a coating of glaze.); 
update Definition (Glossary of Meteorology, American Meteorological Society, 2013,  http://glossary.ametsoc.org/wiki/Freezing_drizzle); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2014-04-14 16:11:30.0 [128.183.164.42] added definition 
insert Definition (id: null
text: Drizzle, falling as a liquid, but freezing on impact with the colder ground or other exposed surfaces. It is reported as "FZDZ" in an observation and on the METAR.
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2014-04-14 14:33:15.0 [128.183.164.42] Insert Concept 
add broader relation (FREEZING DRIZZLE [88e39edc-bf9b-4c02-8a9d-83f9b6c01891,106337] - RAIN [09a57dc7-3911-4a65-9f12-b819652b8671,84455]); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2015-03-04 16:13:54.0 [saritz] Move Concepts 
delete broader relation (null); 
add broader relation (FREEZING DRIZZLE [88e39edc-bf9b-4c02-8a9d-83f9b6c01891,106337] - DRIZZLE [0ffab597-284f-4d1a-b026-a78a6604cec5,106335]); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Drizzle that falls in liquid form but freezes upon impact to form a coating of glaze.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
