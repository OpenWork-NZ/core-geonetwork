<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/aff6bb19-84d0-40ed-8b81-a2210c468283">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/6f47ae88-f28f-43e3-be6a-34f86b15fe19"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-04-01 09:29:42.0 [tbs1979]  
insert Definition (id: null
text: Erosional downcutting or downward erosion or vertical erosion is a geological process that deepens the channel of a stream or valley by removing material from the stream's bed or the valley's floor.
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-02-18 10:49:01.0 [tbs1979] Insert Concept 
