<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/28ae9814-61c2-4ca4-8bc5-d093c1ce5e83">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/abc6f016-d1f0-4725-b847-639de054d13f"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2017-03-13 14:11:44.0 [mgenazzi] Definition added 
insert Definition (id: null
text: Phylum Brachiopoda are a group of marine lophotrochozoans with hard shells on upper and lower surfaces, hinged at the rear with a pedicle projecting from one of the valesto keep the animal anchored to the  seabed floor. Two main groups comprise brachiopods, articulate with toothed hinges and simple muscles and inarticulates with untoothed hinges and complex muscles.
language code: en); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Phylum Brachiopoda are a group of marine lophotrochozoans with hard shells on upper and lower surfaces, hinged at the rear with a pedicle projecting from one of the valesto keep the animal anchored to the  seabed floor. Two main groups comprise brachiopods, articulate with toothed hinges and simple muscles and inarticulates with untoothed hinges and complex muscles.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">LAMP SHELLS</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx1276"/>
</rdf:Description>

