insert Definition (id: null
text: Sea arches form by wave erosion of coastal headlands. Sea arches are very temporary landforms, in both geologic and human terms.
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2024-10-31 10:32:58.0 [tstevens]  
