</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-02-12 13:35:12.0 [mpmorahan] Insert Concept 
add narrower relation (TROPOSPHERIC/MID-LEVEL CLOUDS (OBSERVED/ANALYZED) [a413f88b-859c-4035-a45b-2faa9934156b,82125] - ALTOCUMULUS [01021105-60ed-479a-a35b-faa73e286264,82159]); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2024-10-09 09:38:35.0 [tstevens]  
insert Definition (id: null
text: Mid-level clouds that form in the middle of the troposphere, the lowest part of the Earth's atmosphere. The clouds are made up of water droplets, ice crystals, or a combination of both, depending on the temperature and altitude.
language code: en); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Mid-level clouds that form in the middle of the troposphere, the lowest part of the Earth's atmosphere. The clouds are made up of water droplets, ice crystals, or a combination of both, depending on the temperature and altitude.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">TROPOSPHERIC/MID-LEVEL CLOUDS (OBSERVED/ANALYZED)</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx466"/>
	<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/01021105-60ed-479a-a35b-faa73e286264"/>
	<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/f58d0203-0070-422c-ab52-6ca8ffbb6362"/>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/f58d0203-0070-422c-ab52-6ca8ffbb6362">
