relationship value: null
generated by: null); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">The sum of exchangeable bases plus total soil acidity at a specific pH
value, usually 7.0 or 8.0.  When acidity is expressed as salt extractable
acidity, the cation exchange capacity (CEC) is called the &lt;i&gt;effective&lt;/i&gt;
cation exchange capacity (ECEC) because this is considered to be the CEC of the
exchanger at the native pH value.  It is usually expressed in centimoles of
charge per kilogram of exchanger or millimoles of charge per kilogram of
exchanger</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">CATION EXCHANGE CAPACITY</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx2313"/>
</rdf:Description>

