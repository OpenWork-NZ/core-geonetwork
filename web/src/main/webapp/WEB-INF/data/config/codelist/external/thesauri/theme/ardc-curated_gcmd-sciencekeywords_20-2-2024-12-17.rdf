	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-04-01 13:35:56.0 [tbs1979]  
update PrefLabel (COCKPIT/TOWER KARST); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-04-01 13:37:13.0 [tbs1979]  
insert Definition (id: null
text: A spectacular variety of karst landscape, dominated by steep or vertical sided limestone towers (karst towers) or cones. The towers originate as residual cones and are then steepened by water table undercutting from surrounding alluviated plains.
language code: en); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">A spectacular variety of karst landscape, dominated by steep or vertical sided limestone towers (karst towers) or cones. The towers originate as residual cones and are then steepened by water table undercutting from surrounding alluviated plains.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">COCKPIT/TOWER KARST</prefLabel>
