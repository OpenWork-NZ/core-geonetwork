	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-03-11 14:58:11.0 [tbs1979]  
insert Definition (id: null
text: A mean, 3-hourly "equivalent amplitude" of geomagnetic activity based on standardized K index data from a global network of 23 Northern and Southern Hemisphere stations by the Institut de Physique du Globe de Paris, France; am values are given in units of 1 nT.
language code: en); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">A mean, 3-hourly "equivalent amplitude" of geomagnetic activity based on standardized K index data from a global network of 23 Northern and Southern Hemisphere stations by the Institut de Physique du Globe de Paris, France; am values are given in units of 1 nT.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
