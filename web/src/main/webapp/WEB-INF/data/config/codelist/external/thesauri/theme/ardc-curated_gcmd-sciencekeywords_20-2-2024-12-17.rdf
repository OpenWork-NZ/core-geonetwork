<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/7886c3eb-e86e-4a84-9f2f-e398ecc82b2d">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/4f590d94-110c-4762-9171-aba6d24af6a0"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-04-01 10:33:42.0 [tbs1979]  
insert Definition (id: null
text: End moraines, or terminal moraines, are ridges of unconsolidated debris deposited at the snout or end of the glacier. They usually reflect the shape of the glacier's terminus.  Glaciers act much like a conveyor belt, carrying debris from the top of the glacier to the bottom where it deposits it in end moraines.
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2024-11-06 12:11:29.0 [tstevens]  
insert WeightedRelation (id: null
related concept uuid: 16bd425e-9a14-41ac-900e-5b5c4f713dda
relationship type: null
relationship value: null
generated by: null); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-03-05 08:40:22.0 [tbs1979] Insert Concept 
add broader relation (TERMINAL MORAINE [7886c3eb-e86e-4a84-9f2f-e398ecc82b2d,82769] - MORAINES [4f590d94-110c-4762-9171-aba6d24af6a0,82759]); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">End moraines, or terminal moraines, are ridges of unconsolidated debris deposited at the snout or end of the glacier. They usually reflect the shape of the glacier's terminus.  Glaciers act much like a conveyor belt, carrying debris from the top of the glacier to the bottom where it deposits it in end moraines.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">TERMINAL MORAINE</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx508"/>
</rdf:Description>

