<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/b1d30791-5871-474f-aedf-2d4aa51e2b92">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/b895f4b5-5273-49ef-883f-b67d9f199505"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-08-23 14:48:58.0 [tbs1979]  
insert Definition (id: null
text: A crack in an ice sheet or glacier (compare to crevice, which is in rock). Crevasses often have vertical or near-vertical walls, which can then melt and create seracs, arches, etc.; these walls sometimes expose layers that represent the glacier's stratigraphy.
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-08-06 14:38:21.0 [tbs1979] Insert Concept 
