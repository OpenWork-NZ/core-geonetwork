<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/4b7decec-e378-4824-aecf-9fe509392efd">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
