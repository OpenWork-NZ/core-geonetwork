<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/236cec51-c9e5-4584-90c4-0dac11c603cb">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/4bde697e-39b1-4a42-9803-ee775b132869"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2024-02-22 09:15:00.0 [tstevens]  
insert Definition (id: null
text: Ribonucleic acid (abbreviated RNA) is a molecule present in all living cells that is transcribed from and has structural similarities to DNA. The “transcript” is the RNA produced when a gene is transcribed. Unlike DNA, RNA is most often single-stranded. Includes mRNA (messenger), tRNA (transfer), and rRNA (ribosomal).
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2024-02-21 15:27:38.0 [tstevens] Insert Concept 
add narrower relation (RNA [236cec51-c9e5-4584-90c4-0dac11c603cb,1588450] - TRANSCRIPTOME [7d3c1302-4d88-4964-b966-f318bf2bcf74,1588451]); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2024-02-21 15:26:53.0 [tstevens] Insert Concept 
add broader relation (RNA [236cec51-c9e5-4584-90c4-0dac11c603cb,1588450] - BUILDING BLOCKS [4bde697e-39b1-4a42-9803-ee775b132869,1588446]); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2024-02-21 15:28:14.0 [tstevens] Insert Concept 
add narrower relation (RNA [236cec51-c9e5-4584-90c4-0dac11c603cb,1588450] - ENVIRONMENTAL RNA _eRNA_ [9c40d795-abe1-42d4-b5ff-727d4843b3a4,1588452]); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Ribonucleic acid (abbreviated RNA) is a molecule present in all living cells that is transcribed from and has structural similarities to DNA. The “transcript” is the RNA produced when a gene is transcribed. Unlike DNA, RNA is most often single-stranded. Includes mRNA (messenger), tRNA (transfer), and rRNA (ribosomal).</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">RNA</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx991"/>
	<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/7d3c1302-4d88-4964-b966-f318bf2bcf74"/>
	<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/9c40d795-abe1-42d4-b5ff-727d4843b3a4"/>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/7d3c1302-4d88-4964-b966-f318bf2bcf74">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/236cec51-c9e5-4584-90c4-0dac11c603cb"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2024-02-22 09:16:41.0 [tstevens]  
insert Definition (id: null
text: The transcriptome is the complete set of transcripts in a cell, and their quantity, for a specific developmental stage or physiological condition. Understanding the transcriptome is essential for interpreting the functional elements of the genome and revealing the molecular constituents of cells and tissues, and also for understanding development and disease.
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2024-02-21 15:27:38.0 [tstevens] Insert Concept 
add broader relation (TRANSCRIPTOME [7d3c1302-4d88-4964-b966-f318bf2bcf74,1588451] - RNA [236cec51-c9e5-4584-90c4-0dac11c603cb,1588450]); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">The transcriptome is the complete set of transcripts in a cell, and their quantity, for a specific developmental stage or physiological condition. Understanding the transcriptome is essential for interpreting the functional elements of the genome and revealing the molecular constituents of cells and tissues, and also for understanding development and disease.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">TRANSCRIPTOME</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx2097"/>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/9c40d795-abe1-42d4-b5ff-727d4843b3a4">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/236cec51-c9e5-4584-90c4-0dac11c603cb"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2024-02-21 15:28:14.0 [tstevens] Insert Concept 
add broader relation (ENVIRONMENTAL RNA _eRNA_ [9c40d795-abe1-42d4-b5ff-727d4843b3a4,1588452] - RNA [236cec51-c9e5-4584-90c4-0dac11c603cb,1588450]); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2024-02-22 09:18:15.0 [tstevens]  
insert Definition (id: null
text: Refers to RNAs released by organisms into their surrounding environment. The term is used here to refer strictly to RNA extracted from the environment (in cellular, vesicular, or free form) in the absence of progenitor organisms. Current eRNA applications exploit its rapid degradation to quantify temporally recent or metabolically active communities.
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2024-02-21 15:28:37.0 [tstevens]  
update PrefLabel (ENVIRONMENTAL RNA (eRNA)); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Refers to RNAs released by organisms into their surrounding environment. The term is used here to refer strictly to RNA extracted from the environment (in cellular, vesicular, or free form) in the absence of progenitor organisms. Current eRNA applications exploit its rapid degradation to quantify temporally recent or metabolically active communities.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">ENVIRONMENTAL RNA (eRNA)</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx2551"/>
</rdf:Description>

