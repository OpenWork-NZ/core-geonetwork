<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/bb87baf5-3844-4a56-865f-ea5ed420db06">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
