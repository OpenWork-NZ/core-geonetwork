</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-08-06 14:48:51.0 [tbs1979] Insert Concept 
add narrower relation (CREVASSES [b1d30791-5871-474f-aedf-2d4aa51e2b92,105603] - TRANSVERSE CREVASSES [6ba069ae-8561-44b7-9e59-d645d6bd725f,105643]); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-08-06 14:48:37.0 [tbs1979] Insert Concept 
add narrower relation (CREVASSES [b1d30791-5871-474f-aedf-2d4aa51e2b92,105603] - MARGINAL CREVASSES [f0bbea2f-2ef0-4e99-ad76-1aedbbedc016,105641]); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-08-06 14:48:25.0 [tbs1979] Insert Concept 
