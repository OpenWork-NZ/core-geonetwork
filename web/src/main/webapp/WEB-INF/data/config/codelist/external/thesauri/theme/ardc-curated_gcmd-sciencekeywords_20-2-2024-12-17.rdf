</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2012-06-29 13:48:26.0 [tbs1979]  
insert Definition (id: null
text: Refers to the production and use of nuclear power for human consumption. Methane is a naturally occurring gas which is associated with decomposition and with oil deposits.
language code: en); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Refers to the production and use of nuclear power for human consumption. Methane is a naturally occurring gas which is associated with decomposition and with oil deposits.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">METHANE PRODUCTION/USE</prefLabel>
