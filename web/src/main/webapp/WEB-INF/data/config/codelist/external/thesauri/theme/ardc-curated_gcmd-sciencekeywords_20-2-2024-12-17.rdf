	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2017-03-13 14:14:25.0 [mgenazzi] Definition added 
insert Definition (id: null
text: Phylum Mollusca. Class Bivalvia.  Sedentary bivalve characterized by two-part shell of calcium carbonate secreted by the mantle and joined by a ligamentous hinge held shut by adductor muscles distinguished by slipper dark colored shells and attached to strata by byssus.
language code: en); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Phylum Mollusca. Class Bivalvia.  Sedentary bivalve characterized by two-part shell of calcium carbonate secreted by the mantle and joined by a ligamentous hinge held shut by adductor muscles distinguished by slipper dark colored shells and attached to strata by byssus.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">MUSSELS</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx2530"/>
</rdf:Description>

