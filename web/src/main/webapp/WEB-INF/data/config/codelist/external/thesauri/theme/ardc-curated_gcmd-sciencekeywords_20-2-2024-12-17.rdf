	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Advection is the transfer of properties of current flow. The transfer of
heat gain/loss from one region to another.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
