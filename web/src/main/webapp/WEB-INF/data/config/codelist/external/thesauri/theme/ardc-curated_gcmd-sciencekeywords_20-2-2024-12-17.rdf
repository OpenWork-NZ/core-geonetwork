	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/0408bac9-c247-4b00-80de-f4665b813658"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2020-11-05 14:50:46.0 [tstevens] Insert Concept 
add broader relation (XYLEM DIELECTRIC PERMITTIVITY [3eb9aa2e-8314-4470-a7b5-8bfba901e1fe,560753] - PLANT CHARACTERISTICS [0408bac9-c247-4b00-80de-f4665b813658,84873]); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">The degree of electrical polarization a material experiences under the influence of an external electric field.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
