<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/9d92320e-b9b9-4ae8-8394-252eeda7ceb1">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/7d59f070-ccac-4a90-815b-edfca521779b"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2019-04-03 12:24:31.0 [tstevens] Insert Concept 
add broader relation (VECTOR-BORN DISEASES [9d92320e-b9b9-4ae8-8394-252eeda7ceb1,368619] - DISEASES/EPIDEMICS [7d59f070-ccac-4a90-815b-edfca521779b,84157]); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Illnesses and diseases spread through vectors. ​Vector-borne diseases include, for example, Malaria, Dengue Fever, West Nile virus, and Lyme disease.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">VECTOR-BORN DISEASES</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx1951"/>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/68447296-6019-453b-9684-3cd3ff1530c9">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/7d59f070-ccac-4a90-815b-edfca521779b"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2019-07-15 11:57:47.0 [mmorahan] Insert Concept 
add broader relation (WATERBORNE DISEASES [68447296-6019-453b-9684-3cd3ff1530c9,368959] - DISEASES/EPIDEMICS [7d59f070-ccac-4a90-815b-edfca521779b,84157]); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Diseases caused by consuming water that contains harmful
microorganisms, biotoxins, or toxic contaminants. Examples include
cholera, schistosomiasis, and other gastrointestinal problems.
Waterborne diseases are often the result of unsafe sanitation practices
or a breakdown in infrastructure that can be a result of or exacerbated
by various natural hazards, such as flood or drought.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">WATERBORNE DISEASES</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx295"/>
	<altLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">WATERBORNE INFECTIONS</altLabel>
	<altLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">WATERBORNE ILLNESSES</altLabel>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/007eeff3-1c96-4b54-aa35-2de5ebb9971a">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/7d59f070-ccac-4a90-815b-edfca521779b"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2019-07-15 12:29:48.0 [mmorahan] Rename Concept 
update PrefLabel (FOODBORNE DISEASES); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2019-07-15 12:27:02.0 [mmorahan] Insert Concept 
add broader relation (Foodborne Diseases [007eeff3-1c96-4b54-aa35-2de5ebb9971a,368963] - DISEASES/EPIDEMICS [7d59f070-ccac-4a90-815b-edfca521779b,84157]); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Illness or disease caused by consumption of foods or drinks
contaminated with biological or chemical toxins or pathogens, including
disease-causing microbes or toxic chemicals.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">FOODBORNE DISEASES</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx1658"/>
	<altLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">FOODBORNE INFECTIONS</altLabel>
	<altLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">FOODBORNE ILLNESSES</altLabel>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/b8a877b7-d867-4305-9053-3777e5dd330a">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/7d59f070-ccac-4a90-815b-edfca521779b"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2012-06-26 15:31:25.0 [tbs1979] Insert Concept 
add narrower relation (EPIDEMIOLOGY [b8a877b7-d867-4305-9053-3777e5dd330a,40041] - TELE-EPIDEMIOLOGY [d6cad59b-327e-4f3f-a664-706224c470f9,40093]); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2012-06-29 13:15:32.0 [tbs1979]  
insert Definition (id: null
text: The study of factors affecting the health and illness of populations, and serves as the foundation and logic of interventions made in the interest of public health and preventative medicine. In the study of communicable and non-communicable diseases, the work of epidemiologists ranges from outbreak investigation to study design, data collection and analysis including the development of statistical models to test hypotheses. Epidemiologists also study the interaction of diseases in a population, a condition known as a syndemic.
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2012-06-26 15:06:47.0 [tbs1979] Insert Concept 
add broader relation (EPIDEMIOLOGY [b8a877b7-d867-4305-9053-3777e5dd330a,40041] - DISEASES/EPIDEMICS [7d59f070-ccac-4a90-815b-edfca521779b,20695]); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">The study of factors affecting the health and illness of populations, and serves as the foundation and logic of interventions made in the interest of public health and preventative medicine. In the study of communicable and non-communicable diseases, the work of epidemiologists ranges from outbreak investigation to study design, data collection and analysis including the development of statistical models to test hypotheses. Epidemiologists also study the interaction of diseases in a population, a condition known as a syndemic.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">EPIDEMIOLOGY</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx764"/>
	<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/d6cad59b-327e-4f3f-a664-706224c470f9"/>
</rdf:Description>

