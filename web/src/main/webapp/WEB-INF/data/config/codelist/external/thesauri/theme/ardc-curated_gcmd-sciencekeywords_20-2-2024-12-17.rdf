	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-03-21 11:15:56.0 [tbs1979]  
insert Definition (id: null
text: In mineralogy the property of matter commonly described as the resistance of a substance to being scratched by another substance.
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-03-07 08:13:21.0 [tbs1979] Move Concepts 
