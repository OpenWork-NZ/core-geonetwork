	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">A spring characterized by intermittent discharge of water ejected turbulently and accompanied by a vapour phase (steam).</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
