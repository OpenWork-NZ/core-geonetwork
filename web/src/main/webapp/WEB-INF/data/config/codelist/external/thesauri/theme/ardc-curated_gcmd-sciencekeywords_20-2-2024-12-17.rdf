<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/f8accc20-818e-47a1-962d-80b7ec7f6d92">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/672d6958-4bbc-4b33-adc8-927e4348908b"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-03-29 14:07:24.0 [tbs1979]  
insert Definition (id: null
text: The effect by which surface waves entering shallower water increase in wave height (which is about twice the amplitude).
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-02-18 15:05:44.0 [tbs1979] Insert Concept 
add broader relation (WAVE SHOALING [f8accc20-818e-47a1-962d-80b7ec7f6d92,82671] - COASTAL PROCESSES [672d6958-4bbc-4b33-adc8-927e4348908b,82553]); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2024-10-31 11:23:55.0 [tstevens]  
insert WeightedRelation (id: null
related concept uuid: 15d5b23c-f739-43b5-bf14-3063c0a59f2d
relationship type: null
relationship value: null
generated by: null); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">The effect by which surface waves entering shallower water increase in wave height (which is about twice the amplitude).</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">WAVE SHOALING</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx2734"/>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/bb891ee1-6c7b-4ec0-b2fa-6fb67a2df2a3">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/672d6958-4bbc-4b33-adc8-927e4348908b"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2017-03-10 07:42:50.0 [tstevens]  
insert Definition (id: null
text: The removal of rock in solution by acidic rainwater. In particular, limestone is weathered by rainwater containing dissolved CO2.
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-02-18 14:31:40.0 [tbs1979] Insert Concept 
add broader relation (CHEMICAL SOLUTION [bb891ee1-6c7b-4ec0-b2fa-6fb67a2df2a3,82633] - COASTAL PROCESSES [672d6958-4bbc-4b33-adc8-927e4348908b,82553]); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">The removal of rock in solution by acidic rainwater. In particular, limestone is weathered by rainwater containing dissolved CO2.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">CHEMICAL SOLUTION</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx2981"/>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/36b178ad-4f20-41ce-89d1-4ee8567a3cf2">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/672d6958-4bbc-4b33-adc8-927e4348908b"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-03-29 12:56:57.0 [tbs1979]  
insert Definition (id: null
text: A form of coastal or river erosion, when the bed load is eroded by itself. As rocks are transported downstream along a riverbed (by a mixture of rolling, sliding and saltating), the regular impacts between them cause them to be broken up into smaller fragments. This process also makes them rounder and smoother. Attrition can also occur in glaciated regions, where it is caused by the movement of ice with embedded boulders over surface sediments.
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-02-18 14:31:16.0 [tbs1979] Insert Concept 
add broader relation (ATTRITION/WEATHERING [36b178ad-4f20-41ce-89d1-4ee8567a3cf2,82631] - COASTAL PROCESSES [672d6958-4bbc-4b33-adc8-927e4348908b,82553]); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">A form of coastal or river erosion, when the bed load is eroded by itself. As rocks are transported downstream along a riverbed (by a mixture of rolling, sliding and saltating), the regular impacts between them cause them to be broken up into smaller fragments. This process also makes them rounder and smoother. Attrition can also occur in glaciated regions, where it is caused by the movement of ice with embedded boulders over surface sediments.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">ATTRITION/WEATHERING</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx571"/>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/a8c37cb5-9426-41fd-b192-53b4c3ae1ba3">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
