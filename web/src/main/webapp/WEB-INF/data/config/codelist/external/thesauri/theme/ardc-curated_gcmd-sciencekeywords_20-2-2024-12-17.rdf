<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/293cdec2-44b7-488c-ae04-0722f0a9e8b9">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/3c4fe00c-6fb1-403e-a053-3a0174a6dfe6"/>
