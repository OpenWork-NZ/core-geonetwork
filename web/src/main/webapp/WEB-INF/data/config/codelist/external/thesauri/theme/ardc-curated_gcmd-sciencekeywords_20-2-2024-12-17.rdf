<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/b6782a30-639e-4d70-8290-81683d248b1f">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
