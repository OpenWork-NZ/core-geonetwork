<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/b13bf33a-2a06-489f-80ca-0c77b08588ec">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/4b982bef-56fe-41e9-a131-af575a8fec6a"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-08-05 12:45:26.0 [tbs1979] Insert Concept 
add broader relation (HYDRAULIC ACTION [b13bf33a-2a06-489f-80ca-0c77b08588ec,105375] - FLUVIAL PROCESSES [4b982bef-56fe-41e9-a131-af575a8fec6a,84331]); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-08-15 13:54:56.0 [tbs1979]  
insert Definition (id: null
text: A form of erosion caused by the force of moving water currents rushing into a crack in the rockface.It is strong enough to loosen sediment along the river bed and banks. The water compresses the air in the crack, pushing it right to the back.
language code: en); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">A form of erosion caused by the force of moving water currents rushing into a crack in the rockface.It is strong enough to loosen sediment along the river bed and banks. The water compresses the air in the crack, pushing it right to the back.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">HYDRAULIC ACTION</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx1325"/>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/26352dff-a48b-4b4a-a442-3b5039cf55c0">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
