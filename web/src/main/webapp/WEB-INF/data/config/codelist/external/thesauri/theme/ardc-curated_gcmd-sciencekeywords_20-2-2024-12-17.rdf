	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">(Winds) measured relative to a moving thunderstorm, usually referring to winds, wind shear, or helicity.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">STORM RELATIVE WINDS</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx260"/>
</rdf:Description>

