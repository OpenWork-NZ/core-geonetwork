<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/bb62f1cf-a6e5-4d9d-a3ab-c665b93ce072">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/abc6f016-d1f0-4725-b847-639de054d13f"/>
