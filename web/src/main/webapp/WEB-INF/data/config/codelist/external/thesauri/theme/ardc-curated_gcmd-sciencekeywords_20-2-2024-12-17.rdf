<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/a60ae1b6-abfc-4905-8c09-772da7bb1a10">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/457883c4-b30c-4d26-bed8-6c2887ebbc90"/>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">The emission of radiation, especially of visible light, by a substance
during exposure to external radiation, as light or x-rays. Since the
chlorophyll molecule fluoresces, the measurement of fluorescence can be
used to calculate chlorophyll concentration in the ocean.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">FLUORESCENCE</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx1990"/>
</rdf:Description>

