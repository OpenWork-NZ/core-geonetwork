insert Definition (id: null
text: Phylum Chordata. Class Aves. Order Charadriiformes are very diverse group of birds. Waders feed mostly in the mud. Gulls are generally larger and feed on small fish. Auks nest on sea cliffs.
language code: en); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Phylum Chordata. Class Aves. Order Charadriiformes are very diverse group of birds. Waders feed mostly in the mud. Gulls are generally larger and feed on small fish. Auks nest on sea cliffs.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
