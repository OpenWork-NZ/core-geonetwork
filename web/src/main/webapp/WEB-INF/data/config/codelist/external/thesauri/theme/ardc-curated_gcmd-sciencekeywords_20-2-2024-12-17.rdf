<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/e9ed684e-5252-4091-a794-aaf6e5f249ed">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/6eb3919b-85ce-4988-8b78-9d0018fd8089"/>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Nuclides which are unstable and that decay or disintegrate
spontaneously, emitting radiation. A synonym for radioactive nuclide.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
