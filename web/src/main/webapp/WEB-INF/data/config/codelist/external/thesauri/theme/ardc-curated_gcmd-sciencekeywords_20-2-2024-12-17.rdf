	<altLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">ACE</altLabel>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/de9ffa22-76e3-469c-926b-2dee007702d0">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
