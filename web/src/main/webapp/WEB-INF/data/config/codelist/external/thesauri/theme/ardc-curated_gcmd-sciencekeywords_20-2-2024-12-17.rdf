<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/db2d6cfb-70c3-4568-99a0-a25b3c3879dd">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
