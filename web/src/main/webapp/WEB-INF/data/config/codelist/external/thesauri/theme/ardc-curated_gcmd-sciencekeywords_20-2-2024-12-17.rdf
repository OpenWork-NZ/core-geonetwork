<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/5ce16b97-c91c-420c-9701-33d19d50b286">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/0b5e5a9b-5552-4e41-b1a1-9c01c52dff4b"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-08-20 10:18:02.0 [tbs1979]  
insert Definition (id: null
text: An aeolian sediment formed by the accumulation of wind-blown silt and lesser and variable amounts of sand and clay that are loosely cemented by calcium carbonate. It is usually homogeneous and highly porous and is traversed by vertical capillaries that permit the sediment to fracture and form vertical bluffs.
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-08-05 14:13:53.0 [tbs1979] Insert Concept 
add broader relation (LOESS [5ce16b97-c91c-420c-9701-33d19d50b286,105449] - SEDIMENT TRANSPORT [0b5e5a9b-5552-4e41-b1a1-9c01c52dff4b,105445]); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">An aeolian sediment formed by the accumulation of wind-blown silt and lesser and variable amounts of sand and clay that are loosely cemented by calcium carbonate. It is usually homogeneous and highly porous and is traversed by vertical capillaries that permit the sediment to fracture and form vertical bluffs.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">LOESS</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx1590"/>
</rdf:Description>

