	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Elongate sand bar formed parallel to the shore in areas of
considerable sediment flux, but separated from shore by a lagoon, and
pierced at intervals by inlets through which the sea communicates with
lagoon and river.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">BARRIER ISLANDS</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx901"/>
</rdf:Description>

