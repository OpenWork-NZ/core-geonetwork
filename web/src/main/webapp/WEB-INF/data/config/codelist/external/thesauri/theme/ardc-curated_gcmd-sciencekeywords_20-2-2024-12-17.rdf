<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/e4774745-c565-4b9e-a642-6fa4a0b3b79b">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/b73cee46-8e2c-4df9-b1ed-7f0aa98a04ac"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2012-06-26 15:42:52.0 [tbs1979] Insert Concept 
add broader relation (PETROLEUM PRODUCTION/USE [e4774745-c565-4b9e-a642-6fa4a0b3b79b,40115] - ENERGY PRODUCTION/USE [b73cee46-8e2c-4df9-b1ed-7f0aa98a04ac,40101]); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2012-06-29 13:54:13.0 [tbs1979]  
insert Definition (id: null
text: Refers to the production and use of nuclear power for human consumption. Petroleum is the end-product of the partial decay of living organisms which once inhabited the world's oceans. As they died they sank to the bottom of the oceans, where they were preserved. It exists in the form of crude oil, natural gas or solid material.
language code: en); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Refers to the production and use of nuclear power for human consumption. Petroleum is the end-product of the partial decay of living organisms which once inhabited the world's oceans. As they died they sank to the bottom of the oceans, where they were preserved. It exists in the form of crude oil, natural gas or solid material.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">PETROLEUM PRODUCTION/USE</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx2117"/>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/b3a95e10-1c1d-41cf-8802-8bb1d3a41353">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/b73cee46-8e2c-4df9-b1ed-7f0aa98a04ac"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2012-06-29 13:58:05.0 [tbs1979]  
insert Definition (id: null
text: Refers to the production and use of wind energy for human consumption. Wind energy/power is the conversion of wind energy into a useful form of energy, such as using wind turbines to make electricity and wind mills for mechanical power.
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2012-06-26 15:45:40.0 [tbs1979] Insert Concept 
add broader relation (WIND ENERGY PRODUCTION/USE [b3a95e10-1c1d-41cf-8802-8bb1d3a41353,40119] - ENERGY PRODUCTION/USE [b73cee46-8e2c-4df9-b1ed-7f0aa98a04ac,40101]); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Refers to the production and use of wind energy for human consumption. Wind energy/power is the conversion of wind energy into a useful form of energy, such as using wind turbines to make electricity and wind mills for mechanical power.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">WIND ENERGY PRODUCTION/USE</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx953"/>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/05410006-351a-4877-96e8-f0a821161ecf">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/b73cee46-8e2c-4df9-b1ed-7f0aa98a04ac"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2012-06-26 15:49:02.0 [tbs1979] Insert Concept 
add broader relation (GEOTHERMAL ENERGY PRODUCTION/USE [05410006-351a-4877-96e8-f0a821161ecf,40127] - ENERGY PRODUCTION/USE [b73cee46-8e2c-4df9-b1ed-7f0aa98a04ac,40101]); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2012-06-29 13:45:46.0 [tbs1979]  
insert Definition (id: null
text: Refers to the production and use of geothermal energy for human consumption. Geothermal energy is energy extracted from heat stored in the earth. This geothermal energy originates from the original formation of the planet, from radioactive decay of minerals, and from solar energy absorbed at the surface.
language code: en); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Refers to the production and use of geothermal energy for human consumption. Geothermal energy is energy extracted from heat stored in the earth. This geothermal energy originates from the original formation of the planet, from radioactive decay of minerals, and from solar energy absorbed at the surface.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">GEOTHERMAL ENERGY PRODUCTION/USE</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx2812"/>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/e5d17711-c9c1-42f6-96e4-c618c0df37cb">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/b73cee46-8e2c-4df9-b1ed-7f0aa98a04ac"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2012-07-11 08:40:16.0 [tbs1979]  
update Definition (USGS Offshore Minerals Management Glossary, http://www.mms.gov/glossary); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2012-06-26 15:35:58.0 [tbs1979] Move Concepts 
delete broader relation (null); 
add broader relation (OIL/GAS PRODUCTION [e5d17711-c9c1-42f6-96e4-c618c0df37cb,21295] - ENERGY PRODUCTION/USE [b73cee46-8e2c-4df9-b1ed-7f0aa98a04ac,40101]); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2017-03-10 08:15:00.0 [tstevens]  
update Definition (Pertains to the production and processing of natural gas and oil from reservoirs. Production is the yield of an oil or gas well; the branch of the industry that brings the oil and gas to the surface for sale. The phase of the petroleum industry that deals with bringing the well fluids to the surface and separating them and with storing, gauging, and otherwise preparing the product for pipeline. It also pertains to the amount of oil or gas produced in a given period.); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2012-06-29 13:51:27.0 [tbs1979]  
update Definition (USGS Offshore Minerals Management Glossary, "http://www.mms.gov/glossary" ); 
update Definition (Pertains to the production and processing of natural gas and oil from reservoirs. Production is the yield of an oil or gas well; the branch of the industry that brings the oil and gas to the surface for sale. The phase of the
petroleum industry that deals with bringing the well fluids to the surface and separating them and with storing, gauging, and otherwise preparing the product for pipeline. It also pertains to the amount of oil or gas produced in a given period.); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2012-06-26 15:37:34.0 [tbs1979]  
update PrefLabel (OIL PRODUCTION/USE); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Pertains to the production and processing of natural gas and oil from reservoirs. Production is the yield of an oil or gas well; the branch of the industry that brings the oil and gas to the surface for sale. The phase of the petroleum industry that deals with bringing the well fluids to the surface and separating them and with storing, gauging, and otherwise preparing the product for pipeline. It also pertains to the amount of oil or gas produced in a given period.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">OIL PRODUCTION/USE</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx2012"/>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/d3b2e908-b732-480c-a9cb-2e981da52094">
