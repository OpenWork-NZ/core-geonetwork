<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/7c892333-f4c4-4f81-b825-d6a86e107e9f">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/19ab681c-bdd7-4793-bbdb-1ec498575314"/>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Methane (CH4) is a colorless, odorless, flammable, greenhouse gas. It&#xD;
is released naturally into the air from marshes, swamps, rice&#xD;
fields, ruminant animals (such as cattle), and sewage sludge.  CH4 is&#xD;
also released from methane-producing bacteria (methanogens) that live&#xD;
in anaerobic places. [Solar Energy; v52n6; 467-477; 1994.] [Air, The&#xD;
Nature of Atmosphere and the Climate; Michael Allaby; pages 39,40;&#xD;
1992; Facts on File; New York] [Dictionary of Science;	R.K. Barnhart;&#xD;
page 398; 1986; Houghton Mifflin Company; Boston.]</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">METHANE</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx155"/>
</rdf:Description>

