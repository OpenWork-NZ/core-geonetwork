<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/35b7c7cd-49c8-476c-83f2-f2e1f4097307">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/085edf65-1c8c-414a-b8e4-a1a08ff08f22"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2019-05-30 10:07:46.0 [mmorahan] Insert Concept 
add broader relation (Vulnerable Populations [35b7c7cd-49c8-476c-83f2-f2e1f4097307,368883] - POPULATION [085edf65-1c8c-414a-b8e4-a1a08ff08f22,84711]); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2019-06-03 14:57:31.0 [mmorahan] Rename Concept 
update PrefLabel (VULNERABLE POPULATIONS); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Groups of people with a propensity or predisposition to be adversely
affected. Vulnerable populations may be less able to anticipate, cope
with, resist, and recover from the impacts of a disaster, be it natural or
man-made.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">VULNERABLE POPULATIONS</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx2662"/>
	<altLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Population Vulnerability</altLabel>
</rdf:Description>

