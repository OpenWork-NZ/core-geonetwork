<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/0168947c-5f28-46d8-b643-cb31af02a6de">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/cad91f82-7e2a-43b7-b272-2dc77e2791f4"/>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">These particles include atomic constituents such as electrons, protons, and&#xD;
neutrons (protons and neutrons are actually composite particles, made up of&#xD;
quarks), as well as other particles such as photons and neutrinos which are&#xD;
produced copiously in the sun. However, most of the particles that have been&#xD;
discovered and studied are not encountered under normal earth conditions; they&#xD;
are produced in cosmic rays and during scattering processes in particle&#xD;
accelerators.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">SUB-ATOMIC PARTICLE FLUX</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx2834"/>
</rdf:Description>

