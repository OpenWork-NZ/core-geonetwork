	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Biodiversity is the variety of life: the different plants, animals and
micro-organisms, their genes and the ecosystems of which they are a part.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">BIODIVERSITY FUNCTIONS</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx1240"/>
</rdf:Description>

