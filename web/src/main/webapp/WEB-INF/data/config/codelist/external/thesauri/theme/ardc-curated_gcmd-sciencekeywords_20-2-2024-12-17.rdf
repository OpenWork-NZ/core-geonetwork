<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/d8494f01-bcec-4232-ad78-fbd92c242e62">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/d8dcfd36-f71c-499f-84f5-43da9fee26c5"/>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Consists of oxygenated compounds that are organic derivitives of hydrogen
peroxide. These compounds are formed in the oxidation of hydrocarbons in
relatively clean air, where oxides of nitrogen are not abundant.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">HYDROPEROXY</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx218"/>
</rdf:Description>

<rdf:Description rdf:nodeID="node1igi5qapbx218">
