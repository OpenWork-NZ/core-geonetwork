	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2017-03-15 10:42:36.0 [mgenazzi] Definition added 
insert Definition (id: null
text: Phylum Chordata. Class Mammalia. Order Carnivora. Pinnipeds are widely distributed carnivorous, fin-footed, marine mammals. Seals are eared and use well developed fore-flippers for swimming and walking. Sea lions have external ear flaps. Walruses are characterized by their tusks and whiskers.
language code: en); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Phylum Chordata. Class Mammalia. Order Carnivora. Pinnipeds are widely distributed carnivorous, fin-footed, marine mammals. Seals are eared and use well developed fore-flippers for swimming and walking. Sea lions have external ear flaps. Walruses are characterized by their tusks and whiskers.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
