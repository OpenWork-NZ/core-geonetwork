	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2012-06-26 12:38:24.0 [gee-cee] Insert Concept 
add broader relation (BIRTH RATE DECLINE/INCREASE [379dd4c3-04d7-4f76-9bb9-83d0b8e1a2aa,39885] - BIOSPHERIC INDICATORS [76943142-e5a9-4ecf-b496-050dd3d97101,39883]); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2024-10-08 13:53:13.0 [tstevens]  
update Definition (https://www.cia.gov/the-world-factbook/references/definitions-and-notes/); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2024-10-08 13:52:31.0 [tstevens]  
insert Definition (id: null
text: Refers to the decline and increase of the birth rate. Birth rate, also known as natality, is the total number of live human births per 1,000 population for a given period divided by the length of the period in years.
language code: en); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Refers to the decline and increase of the birth rate. Birth rate, also known as natality, is the total number of live human births per 1,000 population for a given period divided by the length of the period in years.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">BIRTH RATE DECLINE/INCREASE</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx2680"/>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/0de668aa-cc97-482d-a0eb-cddcb1a705b6">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/76943142-e5a9-4ecf-b496-050dd3d97101"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2012-07-10 10:22:43.0 [mpmorahan]  
insert Definition (id: null
text: Migration is the relatively long-distance movement of individuals, usually on a seasonal basis. It is a ubiquitous phenomenon, found in all major animal groups, including birds, mammals, fish, reptiles, amphibians, insects, and crustaceans. The trigger for the migration may be local climate, local availability of food, the season of the year or for mating reasons.
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2012-06-26 12:39:46.0 [gee-cee] Insert Concept 
add broader relation (SPECIES MIGRATION [0de668aa-cc97-482d-a0eb-cddcb1a705b6,39889] - BIOSPHERIC INDICATORS [76943142-e5a9-4ecf-b496-050dd3d97101,39883]); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Migration is the relatively long-distance movement of individuals, usually on a seasonal basis. It is a ubiquitous phenomenon, found in all major animal groups, including birds, mammals, fish, reptiles, amphibians, insects, and crustaceans. The trigger for the migration may be local climate, local availability of food, the season of the year or for mating reasons.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">SPECIES MIGRATION</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx2465"/>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/0a07badb-1382-4f63-8344-7ba063b05534">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/76943142-e5a9-4ecf-b496-050dd3d97101"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2024-10-08 13:55:06.0 [tstevens]  
insert Definition (id: null
text: A measure of how successful reproduction is in a given breeding season. It can be used to assess the health of a population and can be an early indicator of environmental changes or population status.
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2012-06-26 12:39:12.0 [gee-cee] Insert Concept 
add broader relation (BREEDING PRODUCTIVITY [0a07badb-1382-4f63-8344-7ba063b05534,39887] - BIOSPHERIC INDICATORS [76943142-e5a9-4ecf-b496-050dd3d97101,39883]); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">A measure of how successful reproduction is in a given breeding season. It can be used to assess the health of a population and can be an early indicator of environmental changes or population status.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">BREEDING PRODUCTIVITY</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx2697"/>
