<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/11175bd5-ee63-4b13-aa03-bc5500a458c2">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/0cff6e4b-e42a-4565-89ff-350adf41ed69"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2024-10-29 09:43:33.0 [tstevens]  
