<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/ca091be1-4762-49ec-859b-a1a2fcb8e038">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/46172bbe-8bf0-49a0-848f-129c089aeb8e"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-04-02 08:28:44.0 [tbs1979]  
insert Definition (id: null
text: A geological feature that features a chain of mountains or hills that are of a continuous elevated crest for some distance. Ridges are usually termed hills or mountains as well, depending on size.
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-02-18 12:01:11.0 [tbs1979] Insert Concept 
add broader relation (RIDGE [ca091be1-4762-49ec-859b-a1a2fcb8e038,82537] - TECTONIC LANDFORMS [46172bbe-8bf0-49a0-848f-129c089aeb8e,63407]); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">A geological feature that features a chain of mountains or hills that are of a continuous elevated crest for some distance. Ridges are usually termed hills or mountains as well, depending on size.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">RIDGE</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx3005"/>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/33a0cd6c-a8e4-4187-a2f3-7eb4bf62808d">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/46172bbe-8bf0-49a0-848f-129c089aeb8e"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-04-02 07:29:37.0 [tbs1979]  
insert Definition (id: null
text: Roughly circular mound-shaped protrusion resulting from the slow extrusion of viscous lava from a volcano. The geochemistry of lava domes can vary from basalt to rhyolite although most preserved domes tend to have high silica content.
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-02-18 11:58:47.0 [tbs1979] Insert Concept 
add broader relation (LAVA DOME [33a0cd6c-a8e4-4187-a2f3-7eb4bf62808d,82525] - TECTONIC LANDFORMS [46172bbe-8bf0-49a0-848f-129c089aeb8e,63407]); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2024-10-31 09:18:58.0 [tstevens]  
insert WeightedRelation (id: null
related concept uuid: 78200b25-8c91-4f1b-82cc-ed79764cd647
relationship type: null
relationship value: null
generated by: null); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Roughly circular mound-shaped protrusion resulting from the slow extrusion of viscous lava from a volcano. The geochemistry of lava domes can vary from basalt to rhyolite although most preserved domes tend to have high silica content.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">LAVA DOME</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx2637"/>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/a2a3893c-de51-4ca7-a952-e9a43dd961a1">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
