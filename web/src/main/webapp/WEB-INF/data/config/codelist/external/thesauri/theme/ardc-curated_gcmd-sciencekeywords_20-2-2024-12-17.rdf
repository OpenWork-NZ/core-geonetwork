	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<text xmlns="https://gcmd.earthdata.nasa.gov/kms#" xml:lang="en">NASA GCMD</text>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/080389c4-68d4-41ee-ab89-070794038c8e">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/77397026-09c9-44e0-b85f-77b2bc9b1630"/>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">A colorless, odorless, and very toxic gas; molecular formula CO. It is found
in trace quantities in the natural atmosphere, but also produced by the
incomplete combustion of carbonaceous gasses.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">CARBON MONOXIDE</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx2477"/>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/a2bdd7e8-145e-4bbf-b10a-ef7a87fcb1ad">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/77397026-09c9-44e0-b85f-77b2bc9b1630"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2024-10-23 10:18:10.0 [tstevens]  
