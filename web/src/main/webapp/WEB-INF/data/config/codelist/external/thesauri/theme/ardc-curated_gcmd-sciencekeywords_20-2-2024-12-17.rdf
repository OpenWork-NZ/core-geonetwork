<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/05763c43-c6ed-4071-b868-2ea6c1335c12">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/3546cb0a-27a2-4914-85cf-1774b5c4ed19"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2017-03-15 11:05:13.0 [mgenazzi] Definition updated 
update Definition (A type of heterotrophic protistan with a life cycle that includes free-living cells that at some point congregate and differentiate into spore-bearing structures.); 
update Definition (Starr, C. 1997. Biology: concepts and applications.  Wadsworth Publishing Company.  Belmont, California.          ); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">A type of heterotrophic protistan with a life cycle that includes free-living cells that at some point congregate and differentiate into spore-bearing structures.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">SLIME MOLDS</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx60"/>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/3546cb0a-27a2-4914-85cf-1774b5c4ed19">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
