<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/83741fb9-6f86-4670-abbb-c1f3b14a939d">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
