<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/73266dd6-217a-432f-9237-176d3e94b39b">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/03d38261-1c90-491b-bc4e-cc4e703e1dff"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2012-06-28 10:09:23.0 [tbs1979] Insert Concept 
add broader relation (ENVIRONMENTAL SUSTAINABILITY [73266dd6-217a-432f-9237-176d3e94b39b,40271] - SUSTAINABILITY [03d38261-1c90-491b-bc4e-cc4e703e1dff,40269]); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2012-07-03 09:23:58.0 [tbs1979]  
insert Definition (id: null
text: Meeting the needs of the present without compromising the ability of future generations to meet their needs. Encompasses, e.g. keeping population densities below the carrying capacity of a region, facilitating the renewal of renewable resources, conserving and establishing priorities for the use of non-renewable resources, and keeping environmental impact below the level required to allow affected systems to recover and continue to evolve.
language code: en); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Meeting the needs of the present without compromising the ability of future generations to meet their needs. Encompasses, e.g. keeping population densities below the carrying capacity of a region, facilitating the renewal of renewable resources, conserving and establishing priorities for the use of non-renewable resources, and keeping environmental impact below the level required to allow affected systems to recover and continue to evolve.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">ENVIRONMENTAL SUSTAINABILITY</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx616"/>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/03d38261-1c90-491b-bc4e-cc4e703e1dff">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/fb93d937-c17c-45d0-a9e3-ca5c8a800ca8"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2012-06-28 10:10:40.0 [tbs1979] Insert Concept 
add narrower relation (SUSTAINABILITY [03d38261-1c90-491b-bc4e-cc4e703e1dff,40269] - SUSTAINABLE DEVELOPMENT [8d11c81c-ff5b-4cc0-9be2-8e73dddcb51b,40273]); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2012-06-28 10:09:23.0 [tbs1979] Insert Concept 
add narrower relation (SUSTAINABILITY [03d38261-1c90-491b-bc4e-cc4e703e1dff,40269] - ENVIRONMENTAL SUSTAINABILITY [73266dd6-217a-432f-9237-176d3e94b39b,40271]); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2012-07-03 09:22:54.0 [tbs1979]  
insert Definition (id: null
text: The capacity to endure. For humans, sustainability is the long-term maintenance of responsibility, which has environmental, economic, and social dimensions, and encompasses the concept of stewardship, the responsible management of resource use.
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2012-06-28 10:08:44.0 [tbs1979] Insert Concept 
add broader relation (SUSTAINABILITY [03d38261-1c90-491b-bc4e-cc4e703e1dff,40269] - HUMAN DIMENSIONS [fb93d937-c17c-45d0-a9e3-ca5c8a800ca8,19929]); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">The capacity to endure. For humans, sustainability is the long-term maintenance of responsibility, which has environmental, economic, and social dimensions, and encompasses the concept of stewardship, the responsible management of resource use.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">SUSTAINABILITY</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx996"/>
	<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/73266dd6-217a-432f-9237-176d3e94b39b"/>
	<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/8d11c81c-ff5b-4cc0-9be2-8e73dddcb51b"/>
