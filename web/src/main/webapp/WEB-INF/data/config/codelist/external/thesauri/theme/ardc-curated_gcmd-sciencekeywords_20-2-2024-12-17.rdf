insert Definition (id: null
text: Generally, the wind speeds (velocities) at various levels in the atmosphere above the domain of surface weather observations, as determined by any of the methods of winds-aloft observation.
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2022-08-05 14:04:20.0 [sritz] Insert Concept 
