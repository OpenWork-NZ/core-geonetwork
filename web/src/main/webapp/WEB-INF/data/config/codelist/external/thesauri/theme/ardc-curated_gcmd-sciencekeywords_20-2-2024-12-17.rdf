<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/74ce5e8a-038a-471e-a27a-be5b1f17b72f">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/cb5193ab-2d7a-4b35-b7ec-f16ce78ae270"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-04-01 09:11:22.0 [tbs1979]  
insert Definition (id: null
text: Also known as fluvial terraces are elongated terraces that flank the sides of floodplains and fluvial valleys all over the world. They consist of a relatively level strip of land, called a “tread,” separated from either an adjacent floodplain, other fluvial terraces, or uplands by distinctly steeper strips of land called “risers.” These terraces lie parallel to and above the river channel and its floodplain. Because of the manner in which they form, fluvial terraces are underlain by fluvial sediments of highly variable thickness.
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-02-18 10:42:47.0 [tbs1979] Insert Concept 
add broader relation (STREAM TERRACE [74ce5e8a-038a-471e-a27a-be5b1f17b72f,82467] - FLUVIAL LANDFORMS [cb5193ab-2d7a-4b35-b7ec-f16ce78ae270,64131]); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Also known as fluvial terraces are elongated terraces that flank the sides of floodplains and fluvial valleys all over the world. They consist of a relatively level strip of land, called a “tread,” separated from either an adjacent floodplain, other fluvial terraces, or uplands by distinctly steeper strips of land called “risers.” These terraces lie parallel to and above the river channel and its floodplain. Because of the manner in which they form, fluvial terraces are underlain by fluvial sediments of highly variable thickness.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">STREAM TERRACE</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx1751"/>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/588d868d-05a4-4dac-9fb3-770b54ce39e5">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/cb5193ab-2d7a-4b35-b7ec-f16ce78ae270"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-02-18 10:37:56.0 [tbs1979] Insert Concept 
add broader relation (LACUSTRINE PLAIN [588d868d-05a4-4dac-9fb3-770b54ce39e5,82445] - FLUVIAL LANDFORMS [cb5193ab-2d7a-4b35-b7ec-f16ce78ae270,64131]); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-04-01 08:47:40.0 [tbs1979]  
insert Definition (id: null
text: Lakes that get filled by incoming sediment. Overtime, the water may drain from the lake, leaving the deposited sediments behind. This can be caused by natural drainage, evaporation or other geophysical processes.
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2024-10-31 08:36:32.0 [tstevens]  
insert WeightedRelation (id: null
related concept uuid: 8ca51b5e-0b7a-4b7a-b7e2-6e163e195e26
relationship type: null
relationship value: null
generated by: null); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Lakes that get filled by incoming sediment. Overtime, the water may drain from the lake, leaving the deposited sediments behind. This can be caused by natural drainage, evaporation or other geophysical processes.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">LACUSTRINE PLAIN</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx2871"/>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/5f292d99-b14a-4f18-bbe0-8025d04cae50">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/cb5193ab-2d7a-4b35-b7ec-f16ce78ae270"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-04-01 08:58:49.0 [tbs1979]  
insert Definition (id: null
text: A body of standing water, either natural or man-made, that is usually smaller than a lake. They may arise naturally in floodplains as part of a river system, or they may be somewhat isolated depressions.
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-02-18 10:40:30.0 [tbs1979] Insert Concept 
