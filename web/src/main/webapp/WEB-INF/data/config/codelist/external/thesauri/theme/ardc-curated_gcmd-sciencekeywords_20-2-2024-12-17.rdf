	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">A shallow, sediment-filled body of water formed by retreating glaciers or draining floodwaters.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
