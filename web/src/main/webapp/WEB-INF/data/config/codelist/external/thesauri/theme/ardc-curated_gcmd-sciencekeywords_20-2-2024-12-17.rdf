	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Lacustrine Wetlands are lakes, or former lakes, that are naturally filled
with shallow water at certain times and more or less drained at other
times.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">LACUSTRINE WETLANDS</prefLabel>
</rdf:Description>

