</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-04-01 09:54:32.0 [tbs1979]  
insert Definition (id: null
text: A long winding ridge of stratified sand and gravel, examples of which occur in glaciated and formerly glaciated regions of Europe and North America.
language code: en); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">A long winding ridge of stratified sand and gravel, examples of which occur in glaciated and formerly glaciated regions of Europe and North America.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
