<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/70892c25-4206-4673-9504-2876927d19a3">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/abc6f016-d1f0-4725-b847-639de054d13f"/>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">The phylum Echinoderms is a wholly marine group whose members include
the familiar starfish and sea urchins often found on the shore. Some of
their particular features are their five-sided adult symmetry, their
endoskeleton which consists of many small crystals of calcium carbonate
and tube feet, which are outward manifestations of their water vascular
system.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">ECHINODERMS</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx2370"/>
	<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/6972b6bd-2f7e-460d-b12a-914b7d1e029c"/>
	<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/ec994afa-ecd4-4d25-9e8b-335cd982755c"/>
	<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/4c653917-a5d8-4572-a509-572e9fd2c63d"/>
