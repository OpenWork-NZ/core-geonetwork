<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/4f7ad022-70ea-4254-b0ae-7a231fc2e46a">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/457883c4-b30c-4d26-bed8-6c2887ebbc90"/>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">The fraction of the total radiant flux incident upon a surface that
is reflected and that varies according to the wavelength distribution
of the incident radiation.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">REFLECTANCE</prefLabel>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/61f4f3d0-7895-4cce-94e3-d249001d5ee8">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/4cc9b4fa-5097-447f-914c-eb90820938c6"/>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Oxygen (O2) is found on Earth as a gas and constitutes about 20.8% of the&#xD;
air we breathe. Elemental molecular oxygen consists of two oxygen atoms&#xD;
bonded together. A photochemical reaction of oxygen is (ultimately)&#xD;
responsible for the production of ozone in the stratosphere. Oxygen&#xD;
concentrations found in ice core samples have been used to determine past&#xD;
atmospheric levels of oxygen and helped in determining past climates.&#xD;
[Nature; v351; 217-219; 1991.] [Nature; v365; 143-147; 1993.]</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">MOLECULAR OXYGEN</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx575"/>
</rdf:Description>

