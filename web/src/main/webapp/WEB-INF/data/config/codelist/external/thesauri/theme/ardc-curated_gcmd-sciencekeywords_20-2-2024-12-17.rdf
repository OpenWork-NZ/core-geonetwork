	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-08-15 12:52:39.0 [tbs1979]  
insert Definition (id: null
text: Lakes that get filled by incoming sediment. Overtime, the water may drain from the lake, leaving the deposited sediments behind. This can be caused by natural drainage, evaporation or other geophysical processes.
language code: en); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Lakes that get filled by incoming sediment. Overtime, the water may drain from the lake, leaving the deposited sediments behind. This can be caused by natural drainage, evaporation or other geophysical processes.</definition>
