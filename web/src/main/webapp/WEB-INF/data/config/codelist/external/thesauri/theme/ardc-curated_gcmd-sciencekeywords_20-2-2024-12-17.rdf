<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/bc90bc40-2a21-4a6f-9fb9-bf3ae5845157">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/08a4f002-f368-414d-b923-83dd498452d8"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2012-07-23 15:52:51.0 [mpmorahan]  
insert Definition (id: null
text: Nitrous oxide (N2O) is a greenhouse gas produced from ocean upwelling and soils in tropical and temperate regions. Ice core studies have shown that nitrous oxide increases with temperature in the Northern Hemisphere.
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2012-06-26 15:55:39.0 [gee-cee] Insert Concept 
add broader relation (NITROUS OXIDE [bc90bc40-2a21-4a6f-9fb9-bf3ae5845157,40143] - ICE CORE RECORDS [08a4f002-f368-414d-b923-83dd498452d8,40095]); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2012-07-23 15:55:11.0 [mpmorahan] Move Concepts 
