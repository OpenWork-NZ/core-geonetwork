insert Definition (id: null
text: Changes in crystal-orientation fabric, changes in conductivity or changes in the amount of bubbles (respectively density) are considered to cause internal reflections in glaciers and ice sheets
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2015-05-01 15:50:18.0 [aaleman] Insert Concept 
