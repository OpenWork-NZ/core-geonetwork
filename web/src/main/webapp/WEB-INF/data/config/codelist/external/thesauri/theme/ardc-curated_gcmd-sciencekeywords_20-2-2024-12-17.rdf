<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/894f9116-ae3c-40b6-981d-5113de961710">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/1eb0ea0a-312c-4d74-8d42-6f1ad758f999"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2022-07-25 14:51:04.0 [tstevens] Insert Concept 
add narrower relation (EARTH SCIENCE SERVICES [894f9116-ae3c-40b6-981d-5113de961710,993907] - MACHINE LEARNING TRAINING DATA [676bb4aa-1452-4527-aa05-83233ad5d01d,996681]); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">A collection of software, tools, models, and other services that can be used to analyze, process, and model Earth science data.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">EARTH SCIENCE SERVICES</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx1385"/>
	<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/41adc080-c182-4753-9666-435f8b1c913f"/>
	<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/09d00879-6d96-4df4-9f50-73bd761118d9"/>
	<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/02d92216-70c6-437c-8c15-2b76f2132921"/>
	<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/e1f20631-b5b9-438c-b5c2-b1fa0fce100a"/>
	<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/464de0a5-2bb9-4172-9fd3-1634cbc4e739"/>
	<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/a3a5d0dd-0e8f-4649-8a55-25f9251e1008"/>
	<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/676bb4aa-1452-4527-aa05-83233ad5d01d"/>
	<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/1d550f3a-1c8c-4ef5-beff-74cfe7794f12"/>
	<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/a1fedfa9-569f-4313-8ce1-db95513c5469"/>
	<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/dc2088f9-ffb7-41c3-b0a1-856ecfec89de"/>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/e0d7fb1f-5233-4664-8e83-3c65ca344f41">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/02d92216-70c6-437c-8c15-2b76f2132921"/>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Compression services are defined as Data Handling Services that reduce the proportions (file size, physical size, volume or mass) of Earth science data. Data can be reduced by mechanical means (e.g., dehydration) or by &#xD; computer algorithms (e.g., .zip). EXAMPLES: Dehydration or Deflation (mechanical). ZIP, TAR, JAR, GZIP (computer).</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">DATA COMPRESSION</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx1031"/>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/c75db4f8-716c-47a8-a2f4-34e5a48296b0">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/02d92216-70c6-437c-8c15-2b76f2132921"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2017-03-30 07:29:24.0 [tstevens] undo move 
delete narrower relation (null); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2017-03-30 07:29:10.0 [tstevens] Move Concepts 
add narrower relation (ARCHIVING [c75db4f8-716c-47a8-a2f4-34e5a48296b0,86405] - CATALOGING [434d40e2-4e0b-408a-9811-ff878f4f0fb0,84023]); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Archiving services are defined as Data Handling Services that function to provide storage of Earth science data for later retrieval. Archive services may store the data in any manner but must allow for access and retrieval by a data requestor. This service also includes any tools that facilitate the handling of data into (storage/ingest) or out of (access/retrieval) an archive. EXAMPLES: NASA's Distributed Active Archive Centers (DAACs), Library of Congress.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">ARCHIVING</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx2831"/>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/434d40e2-4e0b-408a-9811-ff878f4f0fb0">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/02d92216-70c6-437c-8c15-2b76f2132921"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2017-03-30 07:29:10.0 [tstevens] Move Concepts 
delete broader relation (null); 
add broader relation (CATALOGING [434d40e2-4e0b-408a-9811-ff878f4f0fb0,84023] - ARCHIVING [c75db4f8-716c-47a8-a2f4-34e5a48296b0,86405]); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2017-03-30 07:29:24.0 [tstevens] undo move 
delete broader relation (null); 
add broader relation (CATALOGING [434d40e2-4e0b-408a-9811-ff878f4f0fb0,84023] - DATA MANAGEMENT/DATA HANDLING [02d92216-70c6-437c-8c15-2b76f2132921,84025]); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">A Catalog service is defined as Data Handling Services that provide a listing&#xD; of items arranged systematically with descriptive details. These items include, but are not limited to, data sets, reference materials, and other services.&#xD; Catalog services are, however, limited to topics of relevance to the Earth&#xD; Sciences and Global Environmental Change. These foci must be reflected by a&#xD; majority of the items listed in the catalog. Catalog services also include any&#xD; tools that may be used to create a catalog or facilitate the inclusion or&#xD; maintenance of a listing within a catalog. EXAMPLES: NASA's Global Change Master Directory, Geospatial One-Stop (catalogs) and docBUILDER (metadata management).</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">CATALOGING</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx1524"/>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/0f3573bc-3cb7-4cec-a5bb-1bb6b7ab9057">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/02d92216-70c6-437c-8c15-2b76f2132921"/>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Interoperability is the ability of two or more systems or components to exchange information and to use the information that has been exchanged.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">DATA INTEROPERABILITY</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx1909"/>
	<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/dad75074-b2f7-4cb7-ae02-02d054f18251"/>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/727a79dd-bef9-40c3-bf85-e152947b8e49">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
