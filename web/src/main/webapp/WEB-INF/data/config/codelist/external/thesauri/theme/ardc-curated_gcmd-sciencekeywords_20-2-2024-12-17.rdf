add narrower relation (QUASI-BIENNIAL OSCILLATION [ea64fa04-2822-4cc5-9014-f18ce1a1ef23,22993] - QBO [e932c1de-a7b5-4cbc-9f56-a40234334b2e,39721]); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2020-02-18 08:52:14.0 [tstevens] Remove Concepts 
delete narrower relation (null); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">A stratospheric (16 to 35 km altitude) oscillation of equatorial&#xD;
east-west winds which vary with a period of about 26 to 30 months or&#xD;
roughly 2 years; typically blowing for 12-16 months from the east,&#xD;
then reverse and blowing 12-16 months from the west, then back to&#xD;
easterly again.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">QUASI-BIENNIAL OSCILLATION</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx1511"/>
</rdf:Description>

