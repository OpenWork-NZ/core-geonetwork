insert Definition (id: null
text: This is the peak period in seconds of the swells. If more than one swell is present, this is the period of the swell containing the maximum energy.
language code: en); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">This is the peak period in seconds of the swells. If more than one swell is present, this is the period of the swell containing the maximum energy.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
