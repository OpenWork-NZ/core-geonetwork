	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx886"/>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/e8ba38ce-fc48-44b7-8b78-03b69e068d46">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/4b982bef-56fe-41e9-a131-af575a8fec6a"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-08-05 12:44:33.0 [tbs1979] Insert Concept 
add broader relation (SALTATION [e8ba38ce-fc48-44b7-8b78-03b69e068d46,105369] - FLUVIAL PROCESSES [4b982bef-56fe-41e9-a131-af575a8fec6a,84331]); 
