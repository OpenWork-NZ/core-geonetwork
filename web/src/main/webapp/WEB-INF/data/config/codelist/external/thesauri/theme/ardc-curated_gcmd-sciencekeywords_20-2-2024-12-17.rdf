insert Definition (id: null
text: The down slope movement of soil, rock, and other weathered materials because of gravity.
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-02-18 10:53:45.0 [tbs1979] Insert Concept 
