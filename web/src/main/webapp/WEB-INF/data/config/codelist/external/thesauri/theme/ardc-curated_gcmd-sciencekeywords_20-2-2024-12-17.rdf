	<text xmlns="https://gcmd.earthdata.nasa.gov/kms#" xml:lang="en">U.S. Food and Drug Administration</text>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/a90306f0-353c-4083-941a-0973a6fd6584">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/09a57dc7-3911-4a65-9f12-b819652b8671"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2014-04-14 14:32:09.0 [128.183.164.42] Move Concepts 
delete broader relation (null); 
add broader relation (FREEZING RAIN [a90306f0-353c-4083-941a-0973a6fd6584,86581] - RAIN [09a57dc7-3911-4a65-9f12-b819652b8671,84455]); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">A freezing precipitation form where rain that falls in liquid form
becomes supercooled and freezes upon impact with cold surfaces (at
subfreezing temperatures) to form a coating of glaze upon the ground and
exposed objects.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">FREEZING RAIN</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx2338"/>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/f9405e92-0c1c-4443-9cc4-45d662d8b5f2">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/09a57dc7-3911-4a65-9f12-b819652b8671"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2014-04-14 14:35:58.0 [128.183.164.42] Move Concepts 
delete broader relation (null); 
add broader relation (ACID RAIN [f9405e92-0c1c-4443-9cc4-45d662d8b5f2,83875] - RAIN [09a57dc7-3911-4a65-9f12-b819652b8671,84455]); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Rain having a pH lower than 5.6, representing the pH of natural rainwater;
the increased acidity is usually due to the presence of sulfuric acid
and/or nitric acid, often attributed to anthropogenic sources.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">ACID RAIN</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx751"/>
</rdf:Description>

<rdf:Description rdf:nodeID="node1igi5qapbx444">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<text xmlns="https://gcmd.earthdata.nasa.gov/kms#" xml:lang="en">Glossary of Weather and Climate, American Meteorological Society, 1996.</text>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/12250935-8f40-4279-aada-2f22cbef1459">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/cad5c02a-e771-434e-bef6-8dced38a68e8"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2014-04-15 09:49:20.0 [128.183.164.42] added definition  
insert Definition (id: null
text: The amount of precipitation collected and measured at a weather observing site during a 24 hour period.
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2014-04-14 14:26:26.0 [128.183.164.42] Insert Concept 
add broader relation (24 HOUR PRECIPITATION AMOUNT [12250935-8f40-4279-aada-2f22cbef1459,106319] - PRECIPITATION AMOUNT [cad5c02a-e771-434e-bef6-8dced38a68e8,84205]); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">The amount of precipitation collected and measured at a weather observing site during a 24 hour period.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">24 HOUR PRECIPITATION AMOUNT</prefLabel>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/d8e2bcae-7781-41b6-8d2d-7c82ae61be47">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/68eed887-8008-4352-b420-949457ab59ab"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2019-08-26 08:58:20.0 [tstevens] Insert Concept 
add broader relation (GLACIER TERMINUS [d8e2bcae-7781-41b6-8d2d-7c82ae61be47,369047] - GLACIERS [68eed887-8008-4352-b420-949457ab59ab,84413]); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">The terminus is the end of a glacier, usually the lowest end, and is also often called a glacier toe or snout.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">GLACIER TERMINUS</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx445"/>
</rdf:Description>

<rdf:Description rdf:nodeID="node1igi5qapbx445">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<text xmlns="https://gcmd.earthdata.nasa.gov/kms#" xml:lang="en">https://nsidc.org/cryosphere/glaciers/gallery/terminus.html</text>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/746c49af-3e36-4f0a-b488-e024314d6cfa">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/25d73bcf-c8d4-4c0e-ac98-8f3e98677e73"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-09-04 15:57:14.0 [epneff] Insert Concept 
add broader relation (THAWING INDEX [746c49af-3e36-4f0a-b488-e024314d6cfa,105831] - ATMOSPHERIC TEMPERATURE INDICES [25d73bcf-c8d4-4c0e-ac98-8f3e98677e73,105815]); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-10-11 19:05:18.0 [saritz] added new definition 
insert Definition (id: null
text: As used by the U.S. Army Corps of Engineers, the number of Fahrenheit degree- days (above and below 32°F) between the lowest and highest points on the cumulative degree- days time curve for one thawing season.
The thawing index determined from air temperatures at 4.5 ft above the ground is commonly designated the air thawing index, while that determined from temperatures immediately below a surface is called the surface thawing index.
language code: en); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">As used by the U.S. Army Corps of Engineers, the number of Fahrenheit degree- days (above and below 32°F) between the lowest and highest points on the cumulative degree- days time curve for one thawing season.
The thawing index determined from air temperatures at 4.5 ft above the ground is commonly designated the air thawing index, while that determined from temperatures immediately below a surface is called the surface thawing index.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">THAWING INDEX</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx446"/>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/25d73bcf-c8d4-4c0e-ac98-8f3e98677e73">
