</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/6d486f25-7477-4da9-96ae-0091596ed4d2">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/2e83362e-d8f8-4bca-83fd-bae360ebe94b"/>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Coronal mass ejection (CME) is a huge cloud of hot plasma, occasionally
expelled from the Sun. It may accelerate ions and electrons and may travel
through interplanetary space as far as the Earth¿s orbit and beyond it, often
preceded by a shock front. When the shock reaches Earth, a magnetic storm may
result.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">CORONAL MASS EJECTIONS</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx1731"/>
</rdf:Description>

