	<altLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Disease Vectors</altLabel>
	<altLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Disease Transmitters</altLabel>
	<altLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Disease Carriers</altLabel>
</rdf:Description>

