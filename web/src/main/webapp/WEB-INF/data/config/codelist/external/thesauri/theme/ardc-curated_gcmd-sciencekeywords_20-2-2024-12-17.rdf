<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/bc05d7d2-3c96-4bb6-b759-d45e3c673b86">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
