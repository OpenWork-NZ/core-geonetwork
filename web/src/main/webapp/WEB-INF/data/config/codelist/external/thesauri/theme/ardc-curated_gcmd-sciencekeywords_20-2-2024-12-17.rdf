</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2017-04-21 11:06:16.0 [tstevens]  
insert Definition (id: null
text: Winds that, over a small area, differ from those that would be appropriate to the general large-scale pressure distribution, or that possess some other peculiarity.
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2017-04-20 15:10:59.0 [sritz] Insert Concept 
