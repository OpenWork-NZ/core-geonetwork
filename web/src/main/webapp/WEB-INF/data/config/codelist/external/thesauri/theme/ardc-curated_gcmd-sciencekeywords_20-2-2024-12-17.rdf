<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/5f55961d-45b8-4330-8eee-0b9a9eb4f309">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/a1df1d50-dd2b-4944-bda5-0cf1127e2f49"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2017-04-20 15:18:10.0 [sritz] Insert Concept 
add broader relation (ANABATIC WINDS [5f55961d-45b8-4330-8eee-0b9a9eb4f309,278919] - OROGRAPHIC WINDS [a1df1d50-dd2b-4944-bda5-0cf1127e2f49,278903]); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2017-04-21 12:31:20.0 [tstevens]  
insert Definition (id: null
text: In mountain meteorology, an upslope wind driven by heating (usually daytime insolation) at the slope surface under fair-weather conditions.
language code: en); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">In mountain meteorology, an upslope wind driven by heating (usually daytime insolation) at the slope surface under fair-weather conditions.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">ANABATIC WINDS</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx3155"/>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/6520897f-c6b6-432e-b7d5-e99b33e6932e">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/a1df1d50-dd2b-4944-bda5-0cf1127e2f49"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2017-04-20 15:17:38.0 [sritz] Insert Concept 
add broader relation (MOUNTAIN BREEZES [6520897f-c6b6-432e-b7d5-e99b33e6932e,278915] - OROGRAPHIC WINDS [a1df1d50-dd2b-4944-bda5-0cf1127e2f49,278903]); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2017-04-21 12:34:29.0 [tstevens]  
insert Definition (id: null
text: A nocturnal component of the mountain–plains or mountain–valley wind systems encountered during periods of light synoptic flow.
language code: en); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">A nocturnal component of the mountain–plains or mountain–valley wind systems encountered during periods of light synoptic flow.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">MOUNTAIN BREEZES</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx2702"/>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/4d005bfc-597b-4a99-971f-21d3d44b7b91">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/a1df1d50-dd2b-4944-bda5-0cf1127e2f49"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2017-04-20 15:17:54.0 [sritz] Insert Concept 
add broader relation (VALLEY BREEZES [4d005bfc-597b-4a99-971f-21d3d44b7b91,278917] - OROGRAPHIC WINDS [a1df1d50-dd2b-4944-bda5-0cf1127e2f49,278903]); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2017-04-21 12:35:19.0 [tstevens]  
insert Definition (id: null
text: (Or valley breeze.) A wind that ascends a mountain valley (upvalley wind) during the day; the daytime component of a mountain–valley wind system.
language code: en); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">(Or valley breeze.) A wind that ascends a mountain valley (upvalley wind) during the day; the daytime component of a mountain–valley wind system.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">VALLEY BREEZES</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx2991"/>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/c19501d9-bd86-4611-bd30-6a34dc763a35">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/a1df1d50-dd2b-4944-bda5-0cf1127e2f49"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2017-04-21 12:33:12.0 [tstevens]  
insert Definition (id: null
text: A warm, dry, downslope wind descending the lee side of the Alps as a result of synoptic-scale, cross-barrier flow over the mountain range.
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2017-04-20 15:17:11.0 [sritz] Insert Concept 
add broader relation (FOEHN WINDS [c19501d9-bd86-4611-bd30-6a34dc763a35,278911] - OROGRAPHIC WINDS [a1df1d50-dd2b-4944-bda5-0cf1127e2f49,278903]); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">A warm, dry, downslope wind descending the lee side of the Alps as a result of synoptic-scale, cross-barrier flow over the mountain range.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">FOEHN WINDS</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx2375"/>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/2cf573dd-0ed7-4455-a233-5987b5a8b52a">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/a1df1d50-dd2b-4944-bda5-0cf1127e2f49"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2017-04-20 15:17:21.0 [sritz] Insert Concept 
add broader relation (BORA WINDS [2cf573dd-0ed7-4455-a233-5987b5a8b52a,278913] - OROGRAPHIC WINDS [a1df1d50-dd2b-4944-bda5-0cf1127e2f49,278903]); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2017-04-21 12:32:28.0 [tstevens]  
insert Definition (id: null
text: A fall wind with a source so cold that, when the air reaches the lowlands or coast, the dynamic warming is insufficient to raise the air temperature to the normal level for the region; hence it appears as a cold wind.
language code: en); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">A fall wind with a source so cold that, when the air reaches the lowlands or coast, the dynamic warming is insufficient to raise the air temperature to the normal level for the region; hence it appears as a cold wind.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">BORA WINDS</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx2434"/>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/d7d48399-62ac-4eca-9c09-14b9094a9444">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/a1df1d50-dd2b-4944-bda5-0cf1127e2f49"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2017-04-20 15:16:55.0 [sritz] Insert Concept 
add broader relation (KATABATIC WINDS [d7d48399-62ac-4eca-9c09-14b9094a9444,278909] - OROGRAPHIC WINDS [a1df1d50-dd2b-4944-bda5-0cf1127e2f49,278903]); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2017-04-21 12:33:56.0 [tstevens]  
insert Definition (id: null
text: Most widely used in mountain meteorology to denote a downslope flow driven by cooling at the slope surface during periods of light larger-scale winds; the nocturnal component of the along-slope wind systems.
language code: en); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Most widely used in mountain meteorology to denote a downslope flow driven by cooling at the slope surface during periods of light larger-scale winds; the nocturnal component of the along-slope wind systems.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">KATABATIC WINDS</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx1981"/>
</rdf:Description>

