<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/1d8a8e42-0fc0-4ce1-a058-9fa961c9d4ac">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/7844ae66-f542-442f-8359-05014bc19831"/>
