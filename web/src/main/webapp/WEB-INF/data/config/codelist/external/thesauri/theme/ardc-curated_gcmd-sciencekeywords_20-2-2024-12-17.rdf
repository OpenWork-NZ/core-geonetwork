<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/9613f08d-da11-4ed0-989e-c0c830870044">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/d3b7c3c0-e644-4f01-94da-dfebe854c0d1"/>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Measure of radar reflectivity, expressed in terms  of the physical size of&#xD;
a hypothetical, uniformly scattering sphere that would give rise to&#xD;
the same level of reflection as that observed from the	sample&#xD;
target.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">RADAR CROSS-SECTION</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx2848"/>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/625da982-3648-43fc-a640-1b230509944e">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/d3b7c3c0-e644-4f01-94da-dfebe854c0d1"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2020-09-29 13:28:38.0 [tstevens] Insert Concept 
add narrower relation (RADAR BACKSCATTER [625da982-3648-43fc-a640-1b230509944e,86025] - COMMON MIDPOINT GATHER [d8b34f6e-0713-45ae-b0c7-23329b0b8f0b,560729]); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">The (microwave) signal reflected by elements of  an illuminated scene back&#xD;
in the direction of the radar. It is so named to make clear the difference&#xD;
between energy scattered in arbitrary  directions, and that which returns&#xD;
to the radar and thus may be received  and recorded by the sensor.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">RADAR BACKSCATTER</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx1889"/>
	<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/d8b34f6e-0713-45ae-b0c7-23329b0b8f0b"/>
</rdf:Description>

