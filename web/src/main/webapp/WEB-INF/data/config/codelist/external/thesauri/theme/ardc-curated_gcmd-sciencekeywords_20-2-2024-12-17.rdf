<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/5b4dde5a-733e-4e55-97c9-2108b337cfeb">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/8073b62d-a2f3-4ad9-b619-de26f28877a7"/>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">A general term referring to all types of ice contained in freezing and frozen&#xD;
ground. Ground ice occurs in pores, cavities, voids or other openings in soil&#xD;
or rock and includes massive ice. It may occur as lenses, wedges, veins,&#xD;
sheets, seams, irregular masses, or as individual crystals or coatings on&#xD;
mineral or organic particles. Perennial ground ice can only occur within&#xD;
permafrost bodies.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">GROUND ICE</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx705"/>
</rdf:Description>

