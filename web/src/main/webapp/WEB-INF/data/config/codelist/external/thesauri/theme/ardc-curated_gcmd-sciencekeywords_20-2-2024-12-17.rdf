<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/e59c154f-cdc9-4400-a0d2-af60df9e1b56">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/705cd3a0-ea07-40c8-bfa1-9c26f22d13ba"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-03-20 16:09:48.0 [mpmorahan]  
insert Definition (id: null
text: A principal cloud type, forming in the high levels of the troposphere, composed of ice crystals which appear from the ground as very small elements in the form of grains or small ripples. In aviation forecasts and reports it is coded as CC.
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-02-12 11:49:21.0 [mpmorahan] Insert Concept 
add broader relation (CIRROCUMULUS [e59c154f-cdc9-4400-a0d2-af60df9e1b56,82153] - TROPOSPHERIC/HIGH-LEVEL CLOUDS (OBSERVED/ANALYZED) [705cd3a0-ea07-40c8-bfa1-9c26f22d13ba,82123]); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">A principal cloud type, forming in the high levels of the troposphere, composed of ice crystals which appear from the ground as very small elements in the form of grains or small ripples. In aviation forecasts and reports it is coded as CC.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">CIRROCUMULUS</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx289"/>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/705cd3a0-ea07-40c8-bfa1-9c26f22d13ba">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/162e2243-3266-4999-b352-d8a1a9dc82ac"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2024-10-09 09:40:35.0 [tstevens]  
insert Definition (id: null
text: High-level clouds that form in the troposphere, the lowest layer of Earth's atmosphere, and are made up of ice crystals or supercooled water droplets.
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-02-12 11:50:16.0 [mpmorahan] Insert Concept 
