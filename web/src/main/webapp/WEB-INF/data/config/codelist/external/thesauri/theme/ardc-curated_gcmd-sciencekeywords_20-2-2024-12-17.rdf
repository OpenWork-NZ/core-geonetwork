insert Definition (id: null
text: Surface relief of the land. Topography usually is measured in meters above sea level. The topography can be very different from one location to another. Topography can be flat, or mountainous, or hilly.
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2012-06-26 13:30:43.0 [gee-cee] Insert Concept 
