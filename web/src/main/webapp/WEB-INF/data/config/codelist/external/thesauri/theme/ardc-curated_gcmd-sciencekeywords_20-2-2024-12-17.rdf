insert Definition (id: null
text: A spring characterized by intermittent discharge of water ejected turbulently and accompanied by a vapour phase (steam).
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2024-10-30 08:01:41.0 [tstevens]  
