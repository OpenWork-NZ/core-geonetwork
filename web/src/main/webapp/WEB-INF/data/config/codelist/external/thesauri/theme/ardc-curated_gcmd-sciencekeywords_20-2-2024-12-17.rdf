	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-03-29 13:00:05.0 [tbs1979]  
insert Definition (id: null
text: A form of erosion caused by the force of moving water currents rushing into a crack in the rockface. It is strong enough to loosen sediment along the river bed and banks. The water compresses the air in the crack, pushing it right to the back.
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-02-18 14:32:33.0 [tbs1979] Insert Concept 
