	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Scavenging is the manner of feeding where the animal feeds on dead animal
and plant matter.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
