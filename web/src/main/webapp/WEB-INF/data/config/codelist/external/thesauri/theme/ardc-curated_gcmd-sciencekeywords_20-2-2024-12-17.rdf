	<text xmlns="https://gcmd.earthdata.nasa.gov/kms#" xml:lang="en">Renouf, Edward (1901). "Noble gases". Science. 13 (320): 268–270. Bibcode:1901Sci....13..268R.</text>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/ad41b62a-141b-4207-887c-334367860cf4">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/457883c4-b30c-4d26-bed8-6c2887ebbc90"/>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Radiation from the sun, reflected off particles in the water, and exiting
the ocean surface back into the atmosphere. The upwelling radiance at the
ocean surface.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">WATER-LEAVING RADIANCE</prefLabel>
</rdf:Description>

