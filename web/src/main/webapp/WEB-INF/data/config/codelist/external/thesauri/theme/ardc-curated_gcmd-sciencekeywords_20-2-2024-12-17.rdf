<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/b54234a2-3261-4c6e-8fd8-75230f3488c0">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/c6244bfb-300f-4818-bf45-cf1a15e7e073"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-08-20 08:47:44.0 [tbs1979]  
insert Definition (id: null
text: One of the three main types of coral reefs recognized by most coral reef scientists. It is distinguished from the other two main types (barrier reefs and atolls) in that has either an entirely shallow backreef zone (lagoon) or none at all.
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2024-11-06 09:23:33.0 [tstevens]  
insert WeightedRelation (id: null
related concept uuid: 0f5c48d1-5189-495d-b5a7-7ad596f0a5c4
relationship type: null
relationship value: null
generated by: null); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-08-06 08:09:36.0 [tbs1979] Insert Concept 
add broader relation (FRINGING REEF [b54234a2-3261-4c6e-8fd8-75230f3488c0,105489] - CORAL REEFS [c6244bfb-300f-4818-bf45-cf1a15e7e073,105487]); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">One of the three main types of coral reefs recognized by most coral reef scientists. It is distinguished from the other two main types (barrier reefs and atolls) in that has either an entirely shallow backreef zone (lagoon) or none at all.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">FRINGING REEF</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx2731"/>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/a722fea3-fe54-4995-8aec-407efe20dee9">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/c6244bfb-300f-4818-bf45-cf1a15e7e073"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-08-20 08:48:07.0 [tbs1979]  
insert Definition (id: null
text: An isolated, comparatively small reef outcrop, usually within a lagoon or embayment, often circular and surrounded by sand or seagrass. Patch reefs are common.
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-08-06 08:10:05.0 [tbs1979] Insert Concept 
add broader relation (PATCH REEF [a722fea3-fe54-4995-8aec-407efe20dee9,105493] - CORAL REEFS [c6244bfb-300f-4818-bf45-cf1a15e7e073,105487]); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">An isolated, comparatively small reef outcrop, usually within a lagoon or embayment, often circular and surrounded by sand or seagrass. Patch reefs are common.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">PATCH REEF</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx2225"/>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/8bbf1177-c74b-4f11-8f7d-40c5785312a1">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/c6244bfb-300f-4818-bf45-cf1a15e7e073"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-08-06 08:10:52.0 [tbs1979] Insert Concept 
add broader relation (ATOLL REEF [8bbf1177-c74b-4f11-8f7d-40c5785312a1,105501] - CORAL REEFS [c6244bfb-300f-4818-bf45-cf1a15e7e073,105487]); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-08-20 08:46:14.0 [tbs1979]  
insert Definition (id: null
text: A ring-shaped coral reef including a coral rim that encircles a lagoon partially or completely. There may be coral islands/cays on the coral rim.
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2024-11-06 09:10:46.0 [tstevens]  
insert WeightedRelation (id: null
related concept uuid: 8c89ede4-94d8-4fd4-a3df-f9d42e9835eb
relationship type: null
relationship value: null
generated by: null); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">A ring-shaped coral reef including a coral rim that encircles a lagoon partially or completely. There may be coral islands/cays on the coral rim.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">ATOLL REEF</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx2419"/>
</rdf:Description>

