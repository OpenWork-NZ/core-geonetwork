<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/7a33a978-8ef6-4313-b489-c06cfc6d9cec">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/233a4d81-44f8-4b0e-8ad3-695f641729f8"/>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Nutrient cycling is the repeated pathway of particular nutrients or
elements from the environment through one or more organisms back to the
environment.  Nutrient cycles include the carbon cycle, the nitrogen
cycle, the phosphorus cycle, and so on.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">NUTRIENT CYCLING</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx1200"/>
</rdf:Description>

