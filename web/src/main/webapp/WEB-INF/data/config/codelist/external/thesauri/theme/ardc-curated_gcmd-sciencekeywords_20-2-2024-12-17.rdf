<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/90e7fd13-2da2-4ba6-9e0c-dbecdf7c2215">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
