<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/3da6855e-9be8-4a79-826e-4ce984ed49a5">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/de62c07e-96c6-44fb-a3a1-cd2902305691"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2019-05-30 08:26:25.0 [mmorahan] Insert Concept 
add broader relation (Cryospheric Feedbacks [3da6855e-9be8-4a79-826e-4ce984ed49a5,368863] - Climate Feedbacks [de62c07e-96c6-44fb-a3a1-cd2902305691,368851]); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2019-06-03 14:45:53.0 [mmorahan] Rename Concept 
update PrefLabel (CRYOSPHERIC FEEDBACKS); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Processes within the cryosphere through which the climate system is
controlled, changed, or modulated. Cryospheric feedbacks involve a
perturbation in a climate quantity that causes a change in a second
quantity, and the change in the second quantity ultimately leads to an
additional change in the first. Cryospheric feedbacks may, for example,
involve the dependence of surface albedo on the presence of ice and
snow.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">CRYOSPHERIC FEEDBACKS</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx1483"/>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/514c891b-60b8-4a6f-adb3-0366c75588e9">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/de62c07e-96c6-44fb-a3a1-cd2902305691"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2019-05-30 08:26:41.0 [mmorahan] Insert Concept 
add broader relation (Land-Surface Feedbacks [514c891b-60b8-4a6f-adb3-0366c75588e9,368867] - Climate Feedbacks [de62c07e-96c6-44fb-a3a1-cd2902305691,368851]); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2019-06-03 14:47:01.0 [mmorahan] Rename Concept 
update PrefLabel (LAND-SURFACE FEEDBACKS); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2019-06-03 15:18:47.0 [mmorahan] Rename Concept 
update PrefLabel (LAND SURFACE FEEDBACKS); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Land-surface processes through which climate system is controlled,
changed, or modulated. Land-surface feedbacks involve a perturbation
in a climate quantity that causes a change in a second quantity, and the
change in the second quantity ultimately leads to an additional change
in the first. Land-surface feedbacks often involve land-surface change or
change in terrestrial carbon stocks that in turn affect land-atmosphere
interaction.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">LAND SURFACE FEEDBACKS</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx1943"/>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/80d337f4-8e90-456a-9a5b-33e5f5c907ce">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/de62c07e-96c6-44fb-a3a1-cd2902305691"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2019-06-03 14:47:56.0 [mmorahan] Rename Concept 
update PrefLabel (OCEANIC FEEDBACKS); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2019-05-30 08:26:56.0 [mmorahan] Insert Concept 
add broader relation (Oceanic Feedbacks [80d337f4-8e90-456a-9a5b-33e5f5c907ce,368871] - Climate Feedbacks [de62c07e-96c6-44fb-a3a1-cd2902305691,368851]); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Processes within the ocean through which the climate system is
controlled, changed, or modulated. Oceanic feedbacks involve a
perturbation in a climate quantity that causes a change in a second
quantity, and the change in the second quantity ultimately leads to an
additional change in the first. Examples include those processes that
govern oceanic uptake, transport, and storage of carbon dioxide.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">OCEANIC FEEDBACKS</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx1728"/>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/6a6bed83-f95a-44e6-8ae0-1371b532abc3">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/de62c07e-96c6-44fb-a3a1-cd2902305691"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2019-06-03 14:44:16.0 [mmorahan] Rename Concept 
update PrefLabel (COUPLED SYSTEM FEEDBACKS); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2019-05-30 08:20:27.0 [mmorahan] Insert Concept 
add broader relation (Coupled System Feedbacks [6a6bed83-f95a-44e6-8ae0-1371b532abc3,368859] - Climate Feedbacks [de62c07e-96c6-44fb-a3a1-cd2902305691,368851]); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Processes or interactions between systems, such as the ocean and
atmosphere, through which the climate system is controlled, changed,
or modulated. Examples include process that influence the flux of heat,
freshwater, and radiatively active trace gases between the ocean and
atmosphere as well as those that influence the exchange of carbon
dioxide between the atmosphere and terrestrial biosphere.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">COUPLED SYSTEM FEEDBACKS</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx2805"/>
</rdf:Description>

