	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">A subphylum or superclass of arthropods containing over 35,000 species
distributed  worldwide, mainly in freshwater and marine habitats, where they
constitute a major component of plankton.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">CRUSTACEANS</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx1151"/>
