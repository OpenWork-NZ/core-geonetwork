<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/9d6c8fac-a5cd-4fbc-8283-1bc256c12a43">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/4f590d94-110c-4762-9171-aba6d24af6a0"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-04-01 10:31:17.0 [tbs1979]  
insert Definition (id: null
text: A ridge of moraine that runs down the center of a valley floor. It is formed when two glaciers meet and the debris on the edges of the adjacent valley sides join and are carried on top of the enlarged glacier.
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-03-05 08:37:38.0 [tbs1979] Insert Concept 
