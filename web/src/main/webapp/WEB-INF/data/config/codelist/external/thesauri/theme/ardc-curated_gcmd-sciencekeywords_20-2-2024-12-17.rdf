	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Mechanical scraping of a rock surface by friction between rocks and moving particles.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
