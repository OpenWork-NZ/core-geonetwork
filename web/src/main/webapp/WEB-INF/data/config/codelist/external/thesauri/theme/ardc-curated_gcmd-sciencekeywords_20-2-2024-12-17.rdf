insert Definition (id: null
text: Phylum Ochrophyta. Class Phaeophyceae, brown algae, are distinguished by chloroplasts with four membranes, fucoxanthin pigment and are heterokonts that develop into forms with differentiated tissues.
language code: en); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Phylum Ochrophyta. Class Phaeophyceae, brown algae, are distinguished by chloroplasts with four membranes, fucoxanthin pigment and are heterokonts that develop into forms with differentiated tissues.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
