<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/0948a59e-cc72-4e5d-b97d-4ea0335b0906">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/08a4f002-f368-414d-b923-83dd498452d8"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2012-07-23 15:49:45.0 [mpmorahan]  
insert Definition (id: null
text: Methane (CH4) is a greenhouse gas and is seen in polar ice cores. From the ice core record, it is known that methane rose rapidly whenever climate changed from glacial to interglacial conditions (during "deglaciation"). Warming of water bathing the seafloor could have led to large-scale release of methane from the melting of methane ice.
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2012-06-26 15:54:28.0 [gee-cee] Insert Concept 
add broader relation (METHANE [0948a59e-cc72-4e5d-b97d-4ea0335b0906,40141] - ICE CORE RECORDS [08a4f002-f368-414d-b923-83dd498452d8,40095]); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2012-07-23 15:55:11.0 [mpmorahan] Move Concepts 
delete narrower relation (null); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2012-07-23 15:54:41.0 [mpmorahan] Move Concepts 
add narrower relation (METHANE [0948a59e-cc72-4e5d-b97d-4ea0335b0906,40141] - NITROUS OXIDE [bc90bc40-2a21-4a6f-9fb9-bf3ae5845157,40143]); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Methane (CH4) is a greenhouse gas and is seen in polar ice cores. From the ice core record, it is known that methane rose rapidly whenever climate changed from glacial to interglacial conditions (during "deglaciation"). Warming of water bathing the seafloor could have led to large-scale release of methane from the melting of methane ice.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">METHANE</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx2946"/>
</rdf:Description>

