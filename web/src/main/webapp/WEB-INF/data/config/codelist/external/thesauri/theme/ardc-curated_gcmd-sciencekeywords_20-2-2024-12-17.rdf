	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2022-07-26 08:26:04.0 [tstevens]  
insert Definition (id: null
text: Raster labels are a type of label that masks pixels in raster data in order to identify a data feature or attribute in a machine learning workflow.
language code: en); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Raster labels are a type of label that masks pixels in raster data in order to identify a data feature or attribute in a machine learning workflow.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
