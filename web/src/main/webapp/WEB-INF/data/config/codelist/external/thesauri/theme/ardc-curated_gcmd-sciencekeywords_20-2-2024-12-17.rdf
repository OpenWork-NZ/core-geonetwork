insert Definition (id: null
text: Class Appendicularia, Phylum Chordata, commonly called larvaceans are solitary, free-swimming tunicates characterized by a transparent body of a trunk housing internal organs and a tail with a notochord. The trunk secretes a mucous house that encloses the animal therefore making it a gelatinous zooplankton
language code: en); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Class Appendicularia, Phylum Chordata, commonly called larvaceans are solitary, free-swimming tunicates characterized by a transparent body of a trunk housing internal organs and a tail with a notochord. The trunk secretes a mucous house that encloses the animal therefore making it a gelatinous zooplankton</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">LARVACEANS</prefLabel>
