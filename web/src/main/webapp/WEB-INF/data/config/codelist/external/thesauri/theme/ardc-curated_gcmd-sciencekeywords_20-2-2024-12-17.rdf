	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2015-10-29 15:29:32.0 [aaleman] Insert Concept 
add broader relation (SODIUM [c692e8e4-b920-4eb5-86c3-b5f6121fec4b,158437] - ICE CORE RECORDS [dba19648-3f52-48ba-b00b-8527d44c4d74,83895]); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2017-03-15 13:36:49.0 [mmorahan]  
insert Definition (id: null
text: The major ions, sodium (Na+), calcium (Ca2+), and chloride (Cl−), deposited in central Antarctica and preserved in ice cores originate from both marine and continental sources. They provide important proxy records, helping to reconstruct past climatic processes.
language code: en); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">The major ions, sodium (Na+), calcium (Ca2+), and chloride (Cl−), deposited in central Antarctica and preserved in ice cores originate from both marine and continental sources. They provide important proxy records, helping to reconstruct past climatic processes.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">SODIUM</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx386"/>
</rdf:Description>

