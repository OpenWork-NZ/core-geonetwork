	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">The physical and chemical change undergone by sediment during lithification
and compaction.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">DIAGENESIS</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx1104"/>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/3d352f0f-f69f-44c4-b345-aa9230fbd6ca">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
