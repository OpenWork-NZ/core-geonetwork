<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/b709d6fc-f0cf-47de-bdbb-1cd875b5f3ab">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
