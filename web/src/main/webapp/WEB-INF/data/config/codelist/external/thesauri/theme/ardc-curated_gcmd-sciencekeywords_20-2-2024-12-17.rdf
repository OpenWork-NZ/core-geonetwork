</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/de0ace5c-fa2b-47ca-93db-79d8df7ab6f2">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
