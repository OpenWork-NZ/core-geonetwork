	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx2739"/>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/83aff0db-35fd-45f9-b409-692b17941f79">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/3ff47a50-2f58-489b-96a7-74e1d40cf0f2"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-03-07 08:14:10.0 [tbs1979] Insert Concept 
add broader relation (LUMINESCENCE [83aff0db-35fd-45f9-b409-692b17941f79,83113] - METEORITE PHYSICAL/OPTICAL PROPERTIES [3ff47a50-2f58-489b-96a7-74e1d40cf0f2,83087]); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-03-21 11:16:30.0 [tbs1979]  
insert Definition (id: null
text: It is the emission of “cold light” from minerals. There are several varieties of luminescence, each named according to the source of energy, or the trigger for the luminescence.
language code: en); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">It is the emission of “cold light” from minerals. There are several varieties of luminescence, each named according to the source of energy, or the trigger for the luminescence.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">LUMINESCENCE</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx3099"/>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/a2c042a4-2658-48c1-a511-7a5dbff2b63d">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
