<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/ea855d4c-f132-44f9-b31c-447e1101684d">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/14802b53-b702-438f-8c8a-f51506807ce6"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2017-03-15 13:39:26.0 [mgenazzi] Definition updated 
update Definition (Fish are, broadly speaking, any poikilothermic (or organism whose
body temperature varies according to the temperature of its surroundings)
legless, aquatic vertebrate that possesses a series of gills on each side
of the ;pharynx, a two-chambered heart, no internal nostrils, and at least
a median fin as well as a tail fin.); 
update Definition (Allaby, M. 1998. A Dictionary of Ecology. Oxford University Press.  Oxford, New York.    ); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Fish are, broadly speaking, any poikilothermic (or organism whose
body temperature varies according to the temperature of its surroundings)
legless, aquatic vertebrate that possesses a series of gills on each side
of the ;pharynx, a two-chambered heart, no internal nostrils, and at least
a median fin as well as a tail fin.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">FISH</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx2046"/>
	<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/c69cde73-7bd9-489b-a20b-bd23cfb82d92"/>
	<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/e5404ad9-95bf-4851-9dbb-fecf7dc1e905"/>
	<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/ed019e00-9b0a-4bdc-89aa-606cc929bd9f"/>
</rdf:Description>

