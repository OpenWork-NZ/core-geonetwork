<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/e13b084e-d044-49c9-8791-f057f777fca3">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/789939a6-3cd5-46f3-bdfd-5cdd6a012500"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2012-07-05 14:44:23.0 [mpmorahan]  
insert Definition (id: null
text: From Mitchell: The averaging region is based on the rotated principal component analysis of average June through September African rainfall presented in Janowiak (1988, J. Climate, 1, 240-255). Stations within 20-8N, 20W-10E are obtained from the National Center for Atmospheric Research World Monthly Surface Station Climatology (WMSSC), and 14 retained which had complete or almost complete records for 1950-93. See link for stations. http://jisao.washington.edu/data_sets/sahel/
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2012-06-25 10:09:45.0 [mpmorahan] Insert Concept 
add broader relation (SAHEL STANDARDIZED RAINFALL [e13b084e-d044-49c9-8791-f057f777fca3,39681] - PRECIPITATION INDICATORS [789939a6-3cd5-46f3-bdfd-5cdd6a012500,39675]); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">From Mitchell: The averaging region is based on the rotated principal component analysis of average June through September African rainfall presented in Janowiak (1988, J. Climate, 1, 240-255). Stations within 20-8N, 20W-10E are obtained from the National Center for Atmospheric Research World Monthly Surface Station Climatology (WMSSC), and 14 retained which had complete or almost complete records for 1950-93. See link for stations. http://jisao.washington.edu/data_sets/sahel/</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">SAHEL STANDARDIZED RAINFALL</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx1246"/>
</rdf:Description>

