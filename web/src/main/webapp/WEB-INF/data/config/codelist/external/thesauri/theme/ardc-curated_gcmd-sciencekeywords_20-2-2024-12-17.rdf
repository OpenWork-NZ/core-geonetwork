<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/8e73bff6-c2f9-46a6-963b-8ef09dd7f5f3">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/3c78951a-0293-4fb0-baff-ec7372fe784d"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-04-01 09:46:56.0 [tbs1979]  
insert Definition (id: null
text: An arete is a thin, almost knife-like, ridge of rock which is typically formed when two glaciers erode parallel U-shaped valleys. The arête is a thin ridge of rock that is left separating the two valleys.
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-03-05 08:23:31.0 [tbs1979] Insert Concept 
add broader relation (ARETES [8e73bff6-c2f9-46a6-963b-8ef09dd7f5f3,82725] - GLACIAL LANDFORMS [3c78951a-0293-4fb0-baff-ec7372fe784d,64133]); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">An arete is a thin, almost knife-like, ridge of rock which is typically formed when two glaciers erode parallel U-shaped valleys. The arête is a thin ridge of rock that is left separating the two valleys.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">ARETES</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx3170"/>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/89541868-0ea0-47c6-b81e-a0c4981f2d62">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/3c78951a-0293-4fb0-baff-ec7372fe784d"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2024-10-31 08:25:30.0 [tstevens]  
