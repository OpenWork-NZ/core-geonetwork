<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/b4e28ec2-c2a0-4eb4-9544-8eb227903d47">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/1bf8f27a-d6ff-4cb6-acb7-7e5cce11e029"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2017-03-15 08:41:44.0 [mgenazzi] Definition added 
insert Definition (id: null
text: Phylum Chordata. Class Aves. Order Procellariformes. Albatross family are colonial birds among the largest flying seabirds with a strong sharp-edged bill, the upper mandible ending in a large hook characterized by tubes along the sides of the bill that measure airspeed in flight. Petrel family are exclusively pelagic, colonial birds that refer to all Procellariforme families except Albatross family.
language code: en); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Phylum Chordata. Class Aves. Order Procellariformes. Albatross family are colonial birds among the largest flying seabirds with a strong sharp-edged bill, the upper mandible ending in a large hook characterized by tubes along the sides of the bill that measure airspeed in flight. Petrel family are exclusively pelagic, colonial birds that refer to all Procellariforme families except Albatross family.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">ALBATROSSES/PETRELS AND ALLIES</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx135"/>
</rdf:Description>

