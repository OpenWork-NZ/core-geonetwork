insert Definition (id: null
text: A pit like hole found in areas of karst. These features are caused by the weathering of limestone or dolomite by subsurface drainage.
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-03-05 09:34:33.0 [tbs1979] Insert Concept 
