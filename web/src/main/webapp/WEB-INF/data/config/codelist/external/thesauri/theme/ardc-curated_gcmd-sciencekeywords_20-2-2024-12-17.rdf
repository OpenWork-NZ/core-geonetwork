	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">How salty the water is.   Brine has a very high salinity.   Fresh water has a&#xD;
salinity of zero.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">SALINITY</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx265"/>
</rdf:Description>

