	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/f69374fe-eda2-4223-b130-096220251235"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2019-09-11 08:52:24.0 [tstevens] Insert Concept 
add broader relation (SCENARIO PLANNING [6062293a-f372-4e65-9bab-27355f0ebc59,369151] - GLOBAL CHANGE RESPONSES [f69374fe-eda2-4223-b130-096220251235,369139]); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Preparation based on a plausible description of how the future may develop based on a coherent and internally consistent set of assumptions about key driving forces (e.g., rate of technological change, prices) and relationships. Scenarios are neither predictions nor forecasts, but are used to provide a view of the implications of developments and actions. Preparation may differ for each plausible scenario considered.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">SCENARIO PLANNING</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx1123"/>
</rdf:Description>

