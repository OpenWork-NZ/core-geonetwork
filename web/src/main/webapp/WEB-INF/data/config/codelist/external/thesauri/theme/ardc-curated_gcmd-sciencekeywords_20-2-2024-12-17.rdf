	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/1bf8f27a-d6ff-4cb6-acb7-7e5cce11e029"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2017-03-15 09:23:03.0 [mgenazzi] Definition added 
insert Definition (id: null
text: Phylum Chordata. Class Aves. Order Pelecaniformes. Pelicans are large water birds characterized by totipalmate feet and a distinct bill with a pouch of skin used for catching prey.
