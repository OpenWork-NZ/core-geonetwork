<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/0bf50cd4-8a97-468c-8e73-047e3e09a03d">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/a04804d5-1064-48fd-a7a7-8da8e10399e1"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2024-10-04 10:35:59.0 [tstevens]  
update Definition (A phenomena wherein sea level rises above the normal tide level when
hurricanes or tropical storms move from the ocean along or across a
coastal region. This sea level rise can consists of three components, the
first of which results from low barometric pressure, i.e. the so-called
inverse barometer effect, where lower atmospheric pressure on the surface
of the water allows it to rise. The second component is wind set-up where
the winds drag surface); 
update Definition (Glossary of Oceanography and the Related Geosciences with References
"http://stommel.tamu.edu/~baum/paleo/paleogloss/paleogloss.html"); 
insert WeightedRelation (id: null
related concept uuid: 9edd23d0-68a9-4bae-8887-705058f48ba7
relationship type: null
relationship value: null
generated by: null); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2024-10-04 10:36:31.0 [tstevens]  
insert WeightedRelation (id: null
related concept uuid: 062be713-9c35-458e-86e2-26cea9415f5d
relationship type: null
relationship value: null
generated by: null); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">A phenomena wherein sea level rises above the normal tide level when
hurricanes or tropical storms move from the ocean along or across a
coastal region. This sea level rise can consists of three components, the
first of which results from low barometric pressure, i.e. the so-called
inverse barometer effect, where lower atmospheric pressure on the surface
of the water allows it to rise. The second component is wind set-up where
the winds drag surface</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">STORM SURGE</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx2953"/>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/7a79a3f3-1817-4c9f-8485-550a022b5a8d">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/a04804d5-1064-48fd-a7a7-8da8e10399e1"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2024-10-03 10:56:04.0 [tstevens]  
insert WeightedRelation (id: null
related concept uuid: 768f266e-0807-49c6-a69e-c518de310331
relationship type: null
relationship value: null
generated by: null); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Japanese for "wave in bay."  A long-period wave generated by
rapid displacement of water, such as by seismic disturbances to the sea
floor.  Tsunamis travel at speeds of about 700 km/h in the open ocean and
build to dangerous heights and energy density when their speed slows in
shallow waters.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">TSUNAMIS</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx2339"/>
</rdf:Description>

