<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/3afb06fa-96b7-4bf4-a6b7-b5fa626afc04">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/926c1b80-6c11-40eb-ae7f-f5bcfdc43fac"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-09-05 09:49:43.0 [epneff]  
update Definition (Glossary of Weather and Climate, American Meteorological Society, 1996.); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-09-04 15:01:31.0 [epneff] Insert Concept 
add broader relation (VIRTUAL TEMPERATURE [3afb06fa-96b7-4bf4-a6b7-b5fa626afc04,105813] - UPPER AIR TEMPERATURE [926c1b80-6c11-40eb-ae7f-f5bcfdc43fac,85935]); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-09-05 09:49:22.0 [epneff]  
insert Definition (id: null
text: In a system of humid air, the temperature of dry air having the same
density&amp;nbsp;and pressure as the humid air.&amp;nbsp;
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2014-04-14 15:36:40.0 [128.183.164.42] added definition  
update Definition (The virtual temperature is the temperature a parcel which contains no moisture would have to equal the density of a parcel at a specific temperature and humidity.); 
update Definition (National Weather Service Glossary, NOAA, 2009); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">The virtual temperature is the temperature a parcel which contains no moisture would have to equal the density of a parcel at a specific temperature and humidity.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">VIRTUAL TEMPERATURE</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx2815"/>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/76103e17-59c2-4458-972d-9ff9801e5d32">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
