<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/78778362-5d08-4cd7-9131-159cad561e54">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
