insert Definition (id: null
text: Proteomics is the study of the interactions, function, composition, and structures of proteins and their cellular activities. Proteomics provides a better understanding of the structure and function of an organism.
language code: en); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Proteomics is the study of the interactions, function, composition, and structures of proteins and their cellular activities. Proteomics provides a better understanding of the structure and function of an organism.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
