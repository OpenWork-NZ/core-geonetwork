	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Carbon dioxide, methane, and other trace gases absorb infrared energy, resulting in greenhouse warming of the earth.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">CARBON DIOXIDE FORCING</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx263"/>
</rdf:Description>

