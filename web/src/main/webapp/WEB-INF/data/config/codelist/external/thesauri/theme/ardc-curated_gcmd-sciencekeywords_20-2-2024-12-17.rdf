</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/873e35f5-908b-4418-861e-eab5d13a19a4">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/14555831-70ae-4650-8983-956d65595575"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2019-04-03 11:08:20.0 [tstevens] Insert Concept 
add broader relation (STORMWATER MANAGEMENT [873e35f5-908b-4418-861e-eab5d13a19a4,368611] - WATER MANAGEMENT [14555831-70ae-4650-8983-956d65595575,85065]); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Stormwater management is the control and use of stormwater runoff. The goals of stormwater management include reducing flooding to protect people and property, reducing demand on public stormwater drainage systems,  and supporting healthy streams and rivers. These can be achieved by planning for runoff, maintaining stormwater systems, and regulating the collection, storage, and movement of stormwater.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">STORMWATER MANAGEMENT</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx2192"/>
	<altLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Sustainable Drainage Systems</altLabel>
	<altLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Water Sensitive Urban Design</altLabel>
	<altLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Low Impact Development</altLabel>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/cbf64c32-99fa-4312-91a0-4fc85a6890bb">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/14555831-70ae-4650-8983-956d65595575"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2019-06-03 14:53:01.0 [mmorahan] Rename Concept 
update PrefLabel (WASTEWATER MANAGEMENT); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2019-05-30 09:24:16.0 [mmorahan] Insert Concept 
add broader relation (Wastewater Management [cbf64c32-99fa-4312-91a0-4fc85a6890bb,368875] - WATER MANAGEMENT [14555831-70ae-4650-8983-956d65595575,85065]); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">The management of wastewater or sewage, often in the form of
treatment that removes contaminants and impurities so that the water
can be directly reused or returned to aquifers or natural bodies of water.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">WASTEWATER MANAGEMENT</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx657"/>
	<altLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Wastewater Treatment</altLabel>
	<altLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Sewage Treatment</altLabel>
	<altLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Sewage Management</altLabel>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/bdfa3404-c00d-45fe-a3c1-31389a831ffc">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/14555831-70ae-4650-8983-956d65595575"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2020-05-08 08:39:19.0 [tstevens] Insert Concept 
add narrower relation (WATER STORAGE [bdfa3404-c00d-45fe-a3c1-31389a831ffc,560029] - ICE STUPA [73a50bfa-6a0a-4a36-ace4-2c424db05ab8,560069]); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2020-05-07 14:41:36.0 [tstevens] Insert Concept 
add broader relation (WATER STORAGE [bdfa3404-c00d-45fe-a3c1-31389a831ffc,560029] - WATER MANAGEMENT [14555831-70ae-4650-8983-956d65595575,85065]); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Monitoring water storage and its variations is impor-tant to understanding local hydrological processesand the global water cycle, which sustains all life onEarth. The development of satellite remote-sensingtechniques has benefited the retrieval of terrestrialwater storage and its variations, which has emerged asa new discipline. Focusing on terrestrial water storage,this  chapter  describes  three  major  retrievalapproaches: the water-balance-based approach, thesurface-parameter-based approach, and the GravityRecovery and Climate Experiment (GRACE)-basedapproach. Accurate estimates of terrestrial waterstorage and its variations are still being developed.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">WATER STORAGE</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx3090"/>
	<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/73a50bfa-6a0a-4a36-ace4-2c424db05ab8"/>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/96810430-e7e1-45eb-a4eb-8a7e17fe5076">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/14555831-70ae-4650-8983-956d65595575"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2019-06-03 14:51:10.0 [mmorahan] Rename Concept 
update PrefLabel (GROUNDWATER MANAGEMENT); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2019-05-30 09:48:58.0 [mmorahan] Insert Concept 
add broader relation (Groundwater Management [96810430-e7e1-45eb-a4eb-8a7e17fe5076,368879] - WATER MANAGEMENT [14555831-70ae-4650-8983-956d65595575,85065]); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">The management and allocation of groundwater resources for
agricultural, industrial, and domestic use. Effective allocation requires
accurate knowledge about the spatial distribution of existing resources
and the relevant flow processes. Groundwater management techniques
include artificial recharge, aquifer storage and recovery, and water
saving irrigation techniques.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">GROUNDWATER MANAGEMENT</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx480"/>
	<altLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Aquifer Management</altLabel>
</rdf:Description>

<rdf:Description rdf:nodeID="node1igi5qapbx465">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<text xmlns="https://gcmd.earthdata.nasa.gov/kms#" xml:lang="en">Nebel, Bernard J. and Richard T. Wright. 1998. Environmental Science: the Way the World Works.-6th ed. Prentice Hall, Inc. Upper Saddle River, New Jersey.</text>
</rdf:Description>

