	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Macrofossils are fossils large enough to be studied without the aid of a
microscope. Macrofossils can indicate the range of plant or animal species in
the past.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">MACROFOSSILS</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx2792"/>
</rdf:Description>

