update Definition (The Nature and Properties of Soils, Prentice Hall, 1996.); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2017-03-10 08:57:57.0 [tstevens]  
update Definition (The temperature measured at a given soil depth, typically at 2, 4, 8, and sometimes 20 and 40 in.  Many biological processes, including seed germination, plant emergence, microbial activity, and soil respiration are a function of soil temperature.); 
update Definition (American Meteorological Society Glossary of Meteorology Online. "http://amsglossary.allenpress.com/glossary" ); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">The degree of hotness or coldness of the soil as measured on some definite temperature scale.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">SOIL TEMPERATURE</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx2954"/>
</rdf:Description>

