<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/181fb5a4-125b-445d-b65f-adf9a919c800">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/9673dc0b-89c0-4f0c-b378-f1c8cb267c8f"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-08-16 10:08:23.0 [tbs1979]  
insert Definition (id: null
text: A planar fracture or discontinuity in a volume of rock, across which there has been significant displacement along the fractures as a result of earth movement.
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-08-05 13:55:12.0 [tbs1979] Insert Concept 
