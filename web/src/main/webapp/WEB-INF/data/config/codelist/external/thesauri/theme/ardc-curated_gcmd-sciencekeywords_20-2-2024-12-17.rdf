insert Definition (id: null
text: Subphylum Myriapoda, Phylum Arthropoda, are characterized by elongated segmented body, a single pair of antenna and simple eyes. Common examples are centipedes and millipedes
language code: en); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Subphylum Myriapoda, Phylum Arthropoda, are characterized by elongated segmented body, a single pair of antenna and simple eyes. Common examples are centipedes and millipedes</definition>
