	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-04-01 08:35:32.0 [tbs1979]  
insert Definition (id: null
text: Also known as a river cliff, is an erosional feature of streams. Cut banks are found in abundance along mature or meandering streams, they are located on the outside of a stream bend, known as a meander.
language code: en); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Also known as a river cliff, is an erosional feature of streams. Cut banks are found in abundance along mature or meandering streams, they are located on the outside of a stream bend, known as a meander.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">CUTBANK</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx1097"/>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/88adcca6-2bc8-443a-9f25-c9aded577615">
