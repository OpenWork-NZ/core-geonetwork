	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-08-06 14:41:45.0 [tbs1979] Insert Concept 
add broader relation (GLACIER STRIATIONS/GROOVES [c8ad9c7e-384d-42c9-a75c-813a67e4dbfa,105617] - GLACIAL LANDFORMS [b895f4b5-5273-49ef-883f-b67d9f199505,105287]); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-08-26 08:24:11.0 [tbs1979]  
insert Definition (id: null
text: Scratches or gouges cut into bedrock by process of glacial abrasion. Glacial striations usually occur as multiple straight, parallel grooves representing the movement of the sediment-loaded base of the glacier.
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2024-10-30 09:26:43.0 [tstevens]  
insert WeightedRelation (id: null
related concept uuid: b2d3b8a4-4861-4c21-b875-97084b6e75aa
relationship type: null
relationship value: null
generated by: null); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Scratches or gouges cut into bedrock by process of glacial abrasion. Glacial striations usually occur as multiple straight, parallel grooves representing the movement of the sediment-loaded base of the glacier.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">GLACIER STRIATIONS/GROOVES</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx284"/>
</rdf:Description>

