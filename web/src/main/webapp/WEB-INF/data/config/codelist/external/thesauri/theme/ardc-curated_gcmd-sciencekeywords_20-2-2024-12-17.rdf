update Definition (Gould, J. and W.Keaton. 1996. Biological Science. W.W. Norton and Company. New York, New York.); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2017-03-15 11:12:42.0 [mgenazzi] Definition added 
insert Definition (id: null
text: "Diatoms are algae of the Phylum Ochrista that lack flagella.  They have
a jewel-like appearance.	They play an extremely important role in
aquatic food webs in that they are the second most abundant component of
marine plankton (after blue-green algae).
language code: en); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">"Diatoms are algae of the Phylum Ochrista that lack flagella.  They have
a jewel-like appearance.	They play an extremely important role in
aquatic food webs in that they are the second most abundant component of
marine plankton (after blue-green algae).</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
