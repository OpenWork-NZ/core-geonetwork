<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/6fe420c1-2285-4031-babe-f0243c59a617">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/42c6d91b-afef-4638-95c5-0d130828b2e7"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2018-03-07 07:54:43.0 [tstevens] Insert Concept 
add broader relation (LEAD [6fe420c1-2285-4031-babe-f0243c59a617,310669] - CONTAMINANTS [42c6d91b-afef-4638-95c5-0d130828b2e7,84623]); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2018-03-07 09:29:12.0 [tstevens]  
insert Definition (id: null
text: A chemical element and a heavy metal that is denser than most common materials. Lead is soft and malleable, and has a relatively low melting point. When freshly cut, lead is bluish-white; it tarnishes to a dull gray color when exposed to air. Lead has the highest atomic number of any stable element and concludes three major decay chains of heavier elements.
language code: en); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">A chemical element and a heavy metal that is denser than most common materials. Lead is soft and malleable, and has a relatively low melting point. When freshly cut, lead is bluish-white; it tarnishes to a dull gray color when exposed to air. Lead has the highest atomic number of any stable element and concludes three major decay chains of heavier elements.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">LEAD</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx1088"/>
</rdf:Description>

