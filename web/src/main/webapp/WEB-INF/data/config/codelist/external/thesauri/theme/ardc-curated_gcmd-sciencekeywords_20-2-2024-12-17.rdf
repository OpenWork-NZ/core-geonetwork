	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2016-07-12 09:46:11.0 [gee-cee]  
update PrefLabel (SAVANNA); 
insert Definition (id: null
text: A rolling grassland scattered with shrubs and isolated trees, which can be found between a tropical rainforest and desert biome. Not enough rain falls on a savanna to support forests. Savannas are also known as tropical grasslands
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2016-07-12 09:43:37.0 [gee-cee] Insert Concept 
