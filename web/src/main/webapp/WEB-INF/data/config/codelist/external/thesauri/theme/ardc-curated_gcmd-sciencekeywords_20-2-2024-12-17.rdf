<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/f2057998-1d06-4e58-9177-447942355d66">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/da269095-7270-4a0d-8b43-2c85bd42dd90"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2017-03-10 07:54:10.0 [tstevens]  
insert Definition (id: null
text: A method of exploration geophysics that uses the principles of seismology to estimate of the properties of the Earth's subsurface from reflected seismic waves. This measurement is also known as seismic reflection.
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-03-05 13:17:29.0 [tbs1979] Insert Concept 
