insert Definition (id: null
text: A product formed from the cloud type algorithm. There are 4 categories (consistent with NOAA and NASA cloud products): warm liquid water, super-cooled liquid water, mixed phase clouds, and ice phase clouds.
language code: en); 
</changeNote>
