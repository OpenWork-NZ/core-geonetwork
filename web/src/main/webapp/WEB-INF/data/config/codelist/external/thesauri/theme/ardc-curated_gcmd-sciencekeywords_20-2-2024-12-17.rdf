<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/01e4b433-34ae-4ffb-a73b-dff7ae4c789a">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/0f36cd66-d755-4809-ad0e-d67b1b9aff6c"/>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">The amount of ultraviolet radiation transferred across a given unit of surface&#xD;
area in a given unit of time.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">ULTRAVIOLET FLUX</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx1963"/>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/ca87e2c2-9087-42f7-a88a-93ace50ebe39">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/0f36cd66-d755-4809-ad0e-d67b1b9aff6c"/>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">In radiometery, a measure of the intrinsic radiant intensity emitted by
a radiator in a given direction. Radiance is measured in watts per square
meter and steradian.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">ULTRAVIOLET RADIANCE</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx1110"/>
</rdf:Description>

