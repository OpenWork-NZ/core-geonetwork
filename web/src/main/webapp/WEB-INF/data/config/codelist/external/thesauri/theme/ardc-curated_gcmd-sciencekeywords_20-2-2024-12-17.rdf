	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-03-22 09:42:54.0 [tbs1979]  
insert Definition (id: null
text: The erosion, transport, and deposition of material due to the action of the wind at or near the Earth's surface. Aeolian processes are at their most effective when the vegetation cover is discontinuous or absent.
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-03-05 09:29:52.0 [tbs1979] Insert Concept 
