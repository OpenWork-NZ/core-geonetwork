insert Definition (id: null
text: The process by which surface sediment is incorporated into a fluid flow (such as air, water or even ice ) as part of the operation of erosion.
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-08-06 14:59:43.0 [tbs1979] Insert Concept 
