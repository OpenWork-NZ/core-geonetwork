add broader relation (PALEOSOLS [4fe601b0-314f-4f63-8ec1-3b96cc7263b8,40009] - LAND RECORDS [2bedb6b3-6e92-42e2-b382-60e2a6aab8e9,39979]); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2012-07-23 17:25:00.0 [mpmorahan]  
insert Definition (id: null
text: Paleosols are soils that formed in a landscape of the past with distinctive morphological features resulting from a soil-forming environment that no longer exists at the site.
language code: en); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Paleosols are soils that formed in a landscape of the past with distinctive morphological features resulting from a soil-forming environment that no longer exists at the site.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">PALEOSOLS</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx1283"/>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/2f257f83-bddd-41ce-ac78-5dac857b1be3">
