<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/78a4dbe2-2d6b-4562-988c-022c3a83f4c1">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/bb04ee83-bf49-4f96-898d-20bb6e92bc93"/>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">A theory of global tectonics in which the lithosphere is &#xD;
divided into a number of plates whose pattern of horizontal movement is &#xD;
that of torsionally rigid bodies that interact with one another at their &#xD;
boundaries, causing seismic and tectonic activity along these boundaries.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">PLATE TECTONICS</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx478"/>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/bb04ee83-bf49-4f96-898d-20bb6e92bc93">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/91697b7d-8f2b-4954-850e-61d5f61c867d"/>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Scientific field of study pertaining to the physics of the oceanic crust
and ocean-inundated continental crust.  Variables include marine
morphological features, geophysical processes of the marine environment,
and geophysical measurements of the marine environment.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">MARINE GEOPHYSICS</prefLabel>
	<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/78a4dbe2-2d6b-4562-988c-022c3a83f4c1"/>
	<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/7863ce31-0e06-42a5-bcf8-25981c44dec8"/>
	<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/ad09b215-e837-4d9f-acbc-2b45e5b81825"/>
	<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/e31f905d-bd2a-4fe9-89d8-909e1d2b9b1a"/>
</rdf:Description>

