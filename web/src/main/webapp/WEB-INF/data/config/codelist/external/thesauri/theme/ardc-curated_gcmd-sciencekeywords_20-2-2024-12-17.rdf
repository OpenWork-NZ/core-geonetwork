<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/39a032bf-c3bc-481b-9698-8be114fe85cb">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/f1682ed1-2d9c-41ec-9553-49b9ab55df9b"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2012-06-27 15:11:35.0 [tbs1979]  
update PrefLabel (REFORESTATION/REVEGETATION); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2012-07-02 15:46:28.0 [tbs1979]  
update Definition (Reforestation is the replanting of trees in forests where the trees have been cut down.  Reforestation sometimes is undertaken in an effort to reduce atmospheric carbon dioxide levels by restoring forests, which are carbon sinks.); 
update Definition (Chiras, Daniel D. 1998. Environmental Science. A Systems Approach to Sustainable Development. Wadsworth Publishing Company. Belmont, California.  ); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Reforestation is the replanting of trees in forests where the trees have been cut down.  Reforestation sometimes is undertaken in an effort to reduce atmospheric carbon dioxide levels by restoring forests, which are carbon sinks.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">REFORESTATION/REVEGETATION</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx2765"/>
</rdf:Description>

