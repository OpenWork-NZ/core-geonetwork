	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Soil Water Content: The water lost from soil upon drying to constant
mass at 105 degrees Celcius; expressed either as the mass of water per
unit mass of drysoil or as the volume of water per unit bulk volume of
soil. For GCMD purpose, this also includes all measurements related to
soil water, such as capcity, potential, and pressure, etc...</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">SOIL MOISTURE/WATER CONTENT</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx1367"/>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/e0c0af2a-1429-4248-8d5b-ccae510da0c9">
