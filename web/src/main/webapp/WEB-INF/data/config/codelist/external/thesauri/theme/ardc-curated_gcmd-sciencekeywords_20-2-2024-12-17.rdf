related concept uuid: a3407182-6908-4206-b2fd-4c39da4072ce
relationship type: null
relationship value: null
generated by: null); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-04-01 10:13:53.0 [tbs1979]  
insert Definition (id: null
text: A steep conical hill composed of glaciofluvial sediments. This feature develops when glacial crevasses and depressions in stagnant glacial ice are filled with sand and gravel deposits from sediment loaded meltwater.
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-03-05 08:31:15.0 [tbs1979] Insert Concept 
add broader relation (KAMES [89541868-0ea0-47c6-b81e-a0c4981f2d62,82753] - GLACIAL LANDFORMS [3c78951a-0293-4fb0-baff-ec7372fe784d,64133]); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">A steep conical hill composed of glaciofluvial sediments. This feature develops when glacial crevasses and depressions in stagnant glacial ice are filled with sand and gravel deposits from sediment loaded meltwater.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">KAMES</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx2769"/>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/d23f75ed-29ea-4aa2-8785-fd3a3726bc33">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/3c78951a-0293-4fb0-baff-ec7372fe784d"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-03-05 08:29:25.0 [tbs1979] Insert Concept 
add broader relation (GLACIER/HANGING/U-SHAPED VALLEYS [d23f75ed-29ea-4aa2-8785-fd3a3726bc33,82747] - GLACIAL LANDFORMS [3c78951a-0293-4fb0-baff-ec7372fe784d,64133]); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-04-01 10:07:59.0 [tbs1979]  
insert Definition (id: null
text: The terms U-shaped and V-shaped are descriptive terms of geography to characterize the form of valleys. Most valleys belong to one of these two main types or a mixture of them, at least with respect of the cross section of the slopes or hillsides.
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2024-10-30 09:31:43.0 [tstevens]  
insert WeightedRelation (id: null
related concept uuid: 7335b131-0e86-41b3-a0bc-b28120a0a78a
relationship type: null
relationship value: null
generated by: null); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">The terms U-shaped and V-shaped are descriptive terms of geography to characterize the form of valleys. Most valleys belong to one of these two main types or a mixture of them, at least with respect of the cross section of the slopes or hillsides.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">GLACIER/HANGING/U-SHAPED VALLEYS</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx1210"/>
</rdf:Description>

