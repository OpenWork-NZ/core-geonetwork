<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/8b1af14c-25f1-42bb-bba9-24ee5cee4e43">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
