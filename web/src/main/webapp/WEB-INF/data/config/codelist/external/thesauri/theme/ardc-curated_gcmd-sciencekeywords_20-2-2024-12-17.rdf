<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/23336b57-1ba3-42a6-9ec7-152285c55689">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/22ec2f9b-1f1a-469b-bc09-851d58637ff4"/>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Process and methods related to removal of trees from the forest for purposes
of forest improvements, manufacturing forest products, and lumber,
or conservation.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">FOREST HARVESTING AND ENGINEERING</prefLabel>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/b3a1e091-0bc2-4c9b-a89c-bd003fdd5889">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
