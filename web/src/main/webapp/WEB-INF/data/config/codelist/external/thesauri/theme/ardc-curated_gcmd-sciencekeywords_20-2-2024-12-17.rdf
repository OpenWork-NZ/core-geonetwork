<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/62c1fec5-3512-4136-a060-ec2338a48296">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/b73cee46-8e2c-4df9-b1ed-7f0aa98a04ac"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2012-06-29 13:57:11.0 [tbs1979]  
insert Definition (id: null
text: Refers to the production and use of wave energy for human consumption. Wave energy is the transport of energy by ocean surface waves, and the capture of that energy to do useful work.
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2012-06-26 15:47:48.0 [tbs1979] Insert Concept 
add broader relation (WAVE ENERGY PRODUCTION/USE [62c1fec5-3512-4136-a060-ec2338a48296,40123] - ENERGY PRODUCTION/USE [b73cee46-8e2c-4df9-b1ed-7f0aa98a04ac,40101]); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Refers to the production and use of wave energy for human consumption. Wave energy is the transport of energy by ocean surface waves, and the capture of that energy to do useful work.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">WAVE ENERGY PRODUCTION/USE</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx72"/>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/99ed30c9-332c-4acf-8620-eab3c67bcc90">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/b73cee46-8e2c-4df9-b1ed-7f0aa98a04ac"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2012-06-26 15:49:32.0 [tbs1979] Insert Concept 
add broader relation (BIOMASS ENERGY PRODUCTION/USE [99ed30c9-332c-4acf-8620-eab3c67bcc90,40129] - ENERGY PRODUCTION/USE [b73cee46-8e2c-4df9-b1ed-7f0aa98a04ac,40101]); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2012-06-29 13:43:25.0 [tbs1979]  
insert Definition (id: null
text: Refers to the production and use of biomass energy for human consumption. Biomass energy refers to biofuels, a wide range of fuels which are derived from biomass. The term includes solid biomass, liquid fuels and various biogases.
language code: en); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Refers to the production and use of biomass energy for human consumption. Biomass energy refers to biofuels, a wide range of fuels which are derived from biomass. The term includes solid biomass, liquid fuels and various biogases.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">BIOMASS ENERGY PRODUCTION/USE</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx2197"/>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/c346378a-09ee-428c-89c1-c94354cdc74f">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/b73cee46-8e2c-4df9-b1ed-7f0aa98a04ac"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2012-06-29 13:47:37.0 [tbs1979]  
insert Definition (id: null
text: Refers to the production and use of hydrogen power for human consumption. Hydrogen-containing compounds such as fossil fuels, biomass or even water can be a source of hydrogen. Thermochemical processes can be used to produce hydrogen from biomass and from fossil fuels such as coal, natural gas and petroleum. Power generated from sunlight, wind and nuclear sources can be used to produce hydrogen electrolytically.
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2012-06-26 15:41:20.0 [tbs1979] Insert Concept 
add broader relation (HYDROGEN PRODUCTION/USE [c346378a-09ee-428c-89c1-c94354cdc74f,40109] - ENERGY PRODUCTION/USE [b73cee46-8e2c-4df9-b1ed-7f0aa98a04ac,40101]); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Refers to the production and use of hydrogen power for human consumption. Hydrogen-containing compounds such as fossil fuels, biomass or even water can be a source of hydrogen. Thermochemical processes can be used to produce hydrogen from biomass and from fossil fuels such as coal, natural gas and petroleum. Power generated from sunlight, wind and nuclear sources can be used to produce hydrogen electrolytically.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">HYDROGEN PRODUCTION/USE</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx2233"/>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/8b4f34c1-7aed-4833-811a-401382abd17c">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/b73cee46-8e2c-4df9-b1ed-7f0aa98a04ac"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2012-06-26 15:44:23.0 [tbs1979] Insert Concept 
add broader relation (SOLAR ENERGY PRODUCTION/USE [8b4f34c1-7aed-4833-811a-401382abd17c,40117] - ENERGY PRODUCTION/USE [b73cee46-8e2c-4df9-b1ed-7f0aa98a04ac,40101]); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2012-06-29 13:54:57.0 [tbs1979]  
insert Definition (id: null
text: Refers to the production and use of solar energy for human consumption. Solar energy is energy from the sun that is converted into thermal or electrical energy.
language code: en); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Refers to the production and use of solar energy for human consumption. Solar energy is energy from the sun that is converted into thermal or electrical energy.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">SOLAR ENERGY PRODUCTION/USE</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx670"/>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/582af998-1f5c-48a7-8cdd-70fe06bb9f17">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
