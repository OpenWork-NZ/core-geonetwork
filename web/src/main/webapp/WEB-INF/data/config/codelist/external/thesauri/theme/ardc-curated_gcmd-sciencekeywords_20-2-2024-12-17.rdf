<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/9d184041-9848-4f76-affd-74f4e4fd7462">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/c44b078d-ec95-47d5-9a43-ba8475e568d2"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-04-02 10:03:03.0 [tbs1979]  
insert Definition (id: null
text: The speed of the Earth as it rotates upon its axis, while moving around the Sun in the same sense, or direction, as its rotation. This component is not consistent each year.
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-02-18 09:19:36.0 [tbs1979] Insert Concept 
