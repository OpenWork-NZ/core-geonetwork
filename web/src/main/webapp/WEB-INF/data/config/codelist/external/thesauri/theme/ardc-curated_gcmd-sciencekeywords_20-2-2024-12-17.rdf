<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/ba286b68-a400-4c29-bd24-b8ca99967968">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/06180441-d4bb-4fed-b36a-9b3cb2cac0fe"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2016-07-31 19:58:53.0 [saritz] Insert Concept 
add narrower relation (MAXIMUM 1-MINUTE SUSTAINED WIND [ba286b68-a400-4c29-bd24-b8ca99967968,217793] - TYPHOONS (WESTERN N. PACIFIC) [53998f98-9bf6-4666-90c7-48f2e5730dae,247531]); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2016-07-31 19:59:29.0 [saritz] Insert Concept 
add narrower relation (MAXIMUM 1-MINUTE SUSTAINED WIND [ba286b68-a400-4c29-bd24-b8ca99967968,217793] - CYCLONES (SW INDIAN) [1ab5b26c-8560-412c-8b7b-80921aff9fe1,247537]); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2016-06-28 15:10:47.0 [saritz]  
insert Definition (id: null
text: The standard measure of a tropical cyclone's intensity. When the term is applied to a particular weather system, it refers to the highest one-minute average wind (at an elevation of 10 meters with an unobstructed exposure) associated with that weather system at a particular point in time.
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2016-07-31 19:58:43.0 [saritz] Insert Concept 
add narrower relation (MAXIMUM 1-MINUTE SUSTAINED WIND [ba286b68-a400-4c29-bd24-b8ca99967968,217793] - HURRICANES  (N. ATLANTIC/E. PACIFIC) [93f7b0c1-ea76-431f-8cb0-0599eb51f928,247529]); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2016-07-31 19:59:18.0 [saritz] Insert Concept 
add narrower relation (MAXIMUM 1-MINUTE SUSTAINED WIND [ba286b68-a400-4c29-bd24-b8ca99967968,217793] - SEVERE CYCLONIC STORMS (N. INDIAN) [58ddb82c-fbb2-4910-8259-d9c2df2555da,247535]); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2016-07-31 19:59:04.0 [saritz] Insert Concept 
add narrower relation (MAXIMUM 1-MINUTE SUSTAINED WIND [ba286b68-a400-4c29-bd24-b8ca99967968,217793] - SEVERE TROPICAL CYCLONES (SW PACIFIC/SE INDIAN) [dd54dfac-069b-4552-abfe-d182320189c7,247533]); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2016-06-28 15:10:05.0 [saritz] Insert Concept 
add broader relation (MAXIMUM 1-MINUTE SUSTAINED WIND [ba286b68-a400-4c29-bd24-b8ca99967968,217793] - TROPICAL CYCLONES [06180441-d4bb-4fed-b36a-9b3cb2cac0fe,217775]); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">The standard measure of a tropical cyclone's intensity. When the term is applied to a particular weather system, it refers to the highest one-minute average wind (at an elevation of 10 meters with an unobstructed exposure) associated with that weather system at a particular point in time.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">MAXIMUM 1-MINUTE SUSTAINED WIND</prefLabel>
