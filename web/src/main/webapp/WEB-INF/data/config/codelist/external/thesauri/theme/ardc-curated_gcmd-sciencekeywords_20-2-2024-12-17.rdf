<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/e5404ad9-95bf-4851-9dbb-fecf7dc1e905">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/ea855d4c-f132-44f9-b31c-447e1101684d"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2017-03-15 09:19:49.0 [mgenazzi] Definition updated 
update Definition (Phylum Chordata. Class Hyperoartia. Order Petromyzontiformes. Lampreys have a sucking disk for mouth, no jaw, elongates, cylindrical, flexible body distinguished by no scales covered with mucous, a rounded tail, separated dorsal fins without spines. Phylum Chordata. Class Myxini. Hagfish as distinguished from lampreys by the presence four  pairs of tentacles around their mouth and a skull but no vertebral column); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2017-03-15 09:19:28.0 [mgenazzi] Definition added 
insert Definition (id: null
text: Phylum Chordata. Class Hyperoartia. Order Petromyzontiformes. Lampreys have a sucking disk for mouth, no jaw, elongates, cylindrical, flexible body distinguished by no scales covered with mucous, a rounded tail, separated dorsal fins with no spines. Phylum Chordata. Class Myxini. Hagfish as distinguished from lampreys by the prescence four  pairs of tentacles around their mouth and a skull but no vetebrae column
language code: en); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Phylum Chordata. Class Hyperoartia. Order Petromyzontiformes. Lampreys have a sucking disk for mouth, no jaw, elongates, cylindrical, flexible body distinguished by no scales covered with mucous, a rounded tail, separated dorsal fins without spines. Phylum Chordata. Class Myxini. Hagfish as distinguished from lampreys by the presence four  pairs of tentacles around their mouth and a skull but no vertebral column</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">LAMPREYS/HAGFISHES</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx1752"/>
</rdf:Description>

