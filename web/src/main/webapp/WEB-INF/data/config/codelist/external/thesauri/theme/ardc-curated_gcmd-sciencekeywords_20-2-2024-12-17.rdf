</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Green infrastructure is an interconnected network of natural areas andother open spaces that conserves natural ecosystem values andfunctions, sustains clean air and water, and provides a wide array ofbenefits to people and wildlife.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">GREEN INFRASTRUCTURE</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx678"/>
	<altLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">GI</altLabel>
</rdf:Description>

