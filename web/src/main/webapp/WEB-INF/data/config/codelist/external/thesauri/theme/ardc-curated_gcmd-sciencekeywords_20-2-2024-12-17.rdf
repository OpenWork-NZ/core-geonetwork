<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/1d527151-57b2-49ed-9937-c1756a704ce9">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/25d73bcf-c8d4-4c0e-ac98-8f3e98677e73"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-09-04 15:50:00.0 [epneff] Insert Concept 
add broader relation (COMMON SENSE CLIMATE INDEX [1d527151-57b2-49ed-9937-c1756a704ce9,105817] - ATMOSPHERIC TEMPERATURE INDICES [25d73bcf-c8d4-4c0e-ac98-8f3e98677e73,105815]); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-10-11 17:29:03.0 [saritz] Added new definition. 
insert Definition (id: null
text: Our climate index is a simple measure of the degree, if any, to which practical climate change is occurring.  It also illustrates natural climate variability, thus revealing how difficult it is to reliably perceive a change of quantities that are naturally ‘‘noisy’’ or chaotic. Our aim is to help people judge whether or not climate fluctuations are a significant indication of change and to provide improved understanding of climate variability.

More Information: http://data.giss.nasa.gov/csci/
language code: en); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Our climate index is a simple measure of the degree, if any, to which practical climate change is occurring.  It also illustrates natural climate variability, thus revealing how difficult it is to reliably perceive a change of quantities that are naturally ‘‘noisy’’ or chaotic. Our aim is to help people judge whether or not climate fluctuations are a significant indication of change and to provide improved understanding of climate variability.

More Information: http://data.giss.nasa.gov/csci/</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">COMMON SENSE CLIMATE INDEX</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx1628"/>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/2329bf96-d927-4993-95f9-93551d787ad7">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/25d73bcf-c8d4-4c0e-ac98-8f3e98677e73"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-09-04 15:55:54.0 [epneff] Insert Concept 
add broader relation (FREEZING INDEX [2329bf96-d927-4993-95f9-93551d787ad7,105819] - ATMOSPHERIC TEMPERATURE INDICES [25d73bcf-c8d4-4c0e-ac98-8f3e98677e73,105815]); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-10-11 17:42:11.0 [saritz] added new definition 
insert Definition (id: null
text: (Also called "coldness sun.") As used by the U. S. Army Corps of Engineers, the number of Fahrenheit degree-days (above and below 32°F) between the highest and lowest points on the cumulative degree-days time curve for one freezing season.
language code: en); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">(Also called "coldness sun.") As used by the U. S. Army Corps of Engineers, the number of Fahrenheit degree-days (above and below 32°F) between the highest and lowest points on the cumulative degree-days time curve for one freezing season.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">FREEZING INDEX</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx2682"/>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/349b4322-26ff-4b3c-90fb-b3b1afd20755">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/25d73bcf-c8d4-4c0e-ac98-8f3e98677e73"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-10-11 18:10:58.0 [saritz] added new definition 
insert Definition (id: null
text: Generally, a measure of the departure of the mean daily temperature from a given standard: one degree-day for each degree (°C or °F) of departure above (or below) the standard during one day.
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2024-10-23 10:00:52.0 [tstevens]  
