	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-02-18 12:05:21.0 [tbs1979] Insert Concept 
add broader relation (EPEIROGENIC MOVEMENT [ebcd5f14-9468-493b-b0e6-de5afda2621a,82543] - TECTONIC PROCESSES [f0bd7eeb-9004-4e40-a649-f6010d8a4303,82507]); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-04-02 08:36:00.0 [tbs1979]  
insert Definition (id: null
text: Refers to upheavals or depressions of land exhibiting long wavelengths  and little folding apart from broad undulations.
language code: en); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Refers to upheavals or depressions of land exhibiting long wavelengths  and little folding apart from broad undulations.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">EPEIROGENIC MOVEMENT</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx3127"/>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/46d188a9-1099-4d72-b466-6e839297320e">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/f0bd7eeb-9004-4e40-a649-f6010d8a4303"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-02-18 12:04:25.0 [tbs1979] Insert Concept 
add broader relation (OROGENIC MOVEMENT [46d188a9-1099-4d72-b466-6e839297320e,82541] - TECTONIC PROCESSES [f0bd7eeb-9004-4e40-a649-f6010d8a4303,82507]); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-04-02 08:42:00.0 [tbs1979]  
insert Definition (id: null
text: The formation of mountain ranges by intense upward displacement of the earth's crust, usually associated with folding, thrust faulting, and other compressional processes.
language code: en); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">The formation of mountain ranges by intense upward displacement of the earth's crust, usually associated with folding, thrust faulting, and other compressional processes.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">OROGENIC MOVEMENT</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx1975"/>
</rdf:Description>

