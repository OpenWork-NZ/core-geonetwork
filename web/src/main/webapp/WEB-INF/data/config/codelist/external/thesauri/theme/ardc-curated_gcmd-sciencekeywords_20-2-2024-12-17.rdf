<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/b4a924bb-0d42-4169-bad7-3856f69f0c4a">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/0517ae1f-7617-4f3b-80cb-649178032825"/>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">The process by which some sound is dispersed to travel in directions other
than that which from it was incident by particles suspended in the medium
through which it is travelling.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">ACOUSTIC SCATTERING</prefLabel>
</rdf:Description>

