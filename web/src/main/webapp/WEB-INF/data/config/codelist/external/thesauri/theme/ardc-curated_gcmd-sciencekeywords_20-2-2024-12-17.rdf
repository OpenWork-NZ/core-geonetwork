insert Definition (id: null
text: A body of water typically found in flat, low-lying areas, and can refer either to an extremely slow-moving stream or river (often with a poorly defined shoreline), or to a marshy lake or wetland.
language code: en); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">A body of water typically found in flat, low-lying areas, and can refer either to an extremely slow-moving stream or river (often with a poorly defined shoreline), or to a marshy lake or wetland.</definition>
