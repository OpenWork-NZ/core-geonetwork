<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/5daa972e-b47c-4050-97f1-1e628401fb97">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/a04804d5-1064-48fd-a7a7-8da8e10399e1"/>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">The horizontal distance between two successive wave crests (or troughs) in
a progressive wave.</definition>
