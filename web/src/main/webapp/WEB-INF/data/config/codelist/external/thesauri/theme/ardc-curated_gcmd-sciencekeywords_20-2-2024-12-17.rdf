<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/5c80c047-c02e-4c15-83ac-26b8b1a8f114">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
