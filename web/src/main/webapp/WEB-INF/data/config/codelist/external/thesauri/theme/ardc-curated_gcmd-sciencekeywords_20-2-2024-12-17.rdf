	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/20365b0a-f8df-437a-8b31-25557f7b4d82"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-02-14 11:04:21.0 [mpmorahan] Insert Concept 
add broader relation (STRATUS [8945d3c7-1c39-4a8b-b954-2a84da8ecc88,82265] - TROPOSPHERIC/LOW LEVEL CLOUDS (OBSERVED/ANALYZED) [20365b0a-f8df-437a-8b31-25557f7b4d82,82129]); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-03-21 14:02:47.0 [mpmorahan]  
insert Definition (id: null
text: A principal cloud type, forming in the low levels of the troposphere and normally existing as a flat layer that does not exhibit individual elements. In aviation forecasts and reports it is coded as ST.
language code: en); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">A principal cloud type, forming in the low levels of the troposphere and normally existing as a flat layer that does not exhibit individual elements. In aviation forecasts and reports it is coded as ST.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">STRATUS</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx1571"/>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/a3d37438-644d-448e-95ea-991d79b3a0f3">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
