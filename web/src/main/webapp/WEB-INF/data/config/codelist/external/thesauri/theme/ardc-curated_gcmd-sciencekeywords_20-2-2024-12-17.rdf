<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/cb21c5cb-cc49-4328-a72d-94ccca1fa888">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/112e71ec-c0a1-49a8-82d7-bcb317b45860"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2012-06-26 12:12:15.0 [gee-cee] Insert Concept 
add broader relation (SOIL EROSION [cb21c5cb-cc49-4328-a72d-94ccca1fa888,39859] - LAND SURFACE/AGRICULTURE INDICATORS [112e71ec-c0a1-49a8-82d7-bcb317b45860,39835]); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2012-07-18 18:12:54.0 [mpmorahan]  
insert Definition (id: null
text: The wearing away of the land surface by rain or irrigation water, wind, ice, or other natural or anthropogenic agents that abrade, detach and remove geologic parent material or soil from one point on the earth's surface and deposit it elsewhere, including such processes as gravitational creep and so-called tillage erosion; The detachment and movement of soil or rock by water, wind, ice, or gravity.
language code: en); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">The wearing away of the land surface by rain or irrigation water, wind, ice, or other natural or anthropogenic agents that abrade, detach and remove geologic parent material or soil from one point on the earth's surface and deposit it elsewhere, including such processes as gravitational creep and so-called tillage erosion; The detachment and movement of soil or rock by water, wind, ice, or gravity.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">SOIL EROSION</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx1750"/>
</rdf:Description>

