<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/2b4963ba-1a7a-419d-97ef-eacaa14688e0">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/a04804d5-1064-48fd-a7a7-8da8e10399e1"/>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Pendulum-like rocking of water in an enclosed area; a form of standing
wave that can be caused by meteorological or seismic forces, or that may
result from normal resonances excited by tides.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">SEICHES</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx1422"/>
</rdf:Description>

