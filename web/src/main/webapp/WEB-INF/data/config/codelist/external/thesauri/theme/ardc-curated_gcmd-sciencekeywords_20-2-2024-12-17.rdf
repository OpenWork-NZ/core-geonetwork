	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">The ability of a mineral to remain unaltered over a stated range of pressure and temperature.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
