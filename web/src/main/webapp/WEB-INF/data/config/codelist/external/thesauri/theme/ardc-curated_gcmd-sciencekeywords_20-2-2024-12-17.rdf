<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/e1af236f-ee88-4b10-8feb-70d9e09f90be">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/de7647c9-b129-4cba-afe4-63fa9998206e"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2019-06-21 11:04:49.0 [sritz] Insert Concept 
add broader relation (SHORTWAVE DOWNWARD IRRADIANCE [e1af236f-ee88-4b10-8feb-70d9e09f90be,368891] - SOLAR IRRADIANCE [de7647c9-b129-4cba-afe4-63fa9998206e,85399]); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Flux density (in W/m2) of the solar radiation at the Earth's surface</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">SHORTWAVE DOWNWARD IRRADIANCE</prefLabel>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/de7647c9-b129-4cba-afe4-63fa9998206e">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/4ad0c52d-6449-48ff-8678-adc6b2cebcb7"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2019-06-21 11:04:49.0 [sritz] Insert Concept 
add narrower relation (SOLAR IRRADIANCE [de7647c9-b129-4cba-afe4-63fa9998206e,85399] - SHORTWAVE DOWNWARD IRRADIANCE [e1af236f-ee88-4b10-8feb-70d9e09f90be,368891]); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Solar irradiance at the top of the atmosphere on a plane normal to the
incident radiation, and at the mean distance of the Earth from the Sun.
Solar irradiance is also referred to as the solar constant. In satellite
remote sensing, the solar irradiance is used as an onboard calibrartion of
visible band sensors. Some climate studies suggest that small variations
in the solar irradiance associated with solar activity over days to
decades may have an effect the Earth's climate.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">SOLAR IRRADIANCE</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx2978"/>
	<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/e1af236f-ee88-4b10-8feb-70d9e09f90be"/>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/b07017e8-d714-45a6-b1fe-8c00230ec209">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/a246a8cf-e3f9-4045-af9f-dc97f6fe019a"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2017-03-10 08:54:04.0 [tstevens]  
update Definition (The destructive processes by which rocks are changed on exposure to atmospheric agents at or near the earth's surface, with little or no transport of the loosened or altered material.); 
update Definition (Dictionary of Geological Terms, American Geological Institute, 1984. ); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">The destructive processes by which rocks are changed on exposure to atmospheric agents at or near the earth's surface, with little or no transport of the loosened or altered material.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
