	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-08-16 10:20:40.0 [tbs1979]  
insert Definition (id: null
text: Roughly circular mound-shaped protrusion resulting from the slow extrusion of viscous lava from a volcano. The geochemistry of lava domes can vary from basalt to rhyolite although most preserved domes tend to have high silica content.
language code: en); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Roughly circular mound-shaped protrusion resulting from the slow extrusion of viscous lava from a volcano. The geochemistry of lava domes can vary from basalt to rhyolite although most preserved domes tend to have high silica content.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">LAVA DOME</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx1979"/>
