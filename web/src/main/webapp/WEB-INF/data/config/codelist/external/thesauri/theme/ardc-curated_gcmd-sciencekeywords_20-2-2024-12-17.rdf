<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/3e705ebc-c58f-460d-b5e7-1da05ee45cc1">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
