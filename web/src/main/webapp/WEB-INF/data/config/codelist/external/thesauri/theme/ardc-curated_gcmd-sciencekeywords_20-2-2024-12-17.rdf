	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-02-18 14:17:44.0 [tbs1979] Insert Concept 
add broader relation (SEA CAVES [521f883e-18be-4f28-b5fe-c1f887b4233a,82611] - COASTAL LANDFORMS [c58320e6-3f1d-4c36-9bee-6bad73404c21,62739]); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-03-29 11:00:22.0 [tbs1979]  
insert Definition (id: null
text: A littoral cave, is a type of cave formed primarily by the wave action of the sea. The primary process involved is erosion. Sea caves are found throughout the world, actively forming along present coastlines and as relict sea caves on former coastlines.
language code: en); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">A littoral cave, is a type of cave formed primarily by the wave action of the sea. The primary process involved is erosion. Sea caves are found throughout the world, actively forming along present coastlines and as relict sea caves on former coastlines.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">SEA CAVES</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx2461"/>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/94b575b8-eac4-433d-aa74-d781b650f452">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/c58320e6-3f1d-4c36-9bee-6bad73404c21"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-02-18 14:18:32.0 [tbs1979] Insert Concept 
add broader relation (SHOALS [94b575b8-eac4-433d-aa74-d781b650f452,82615] - COASTAL LANDFORMS [c58320e6-3f1d-4c36-9bee-6bad73404c21,62739]); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-03-29 11:02:04.0 [tbs1979]  
insert Definition (id: null
text: A somewhat linear landform  within or extending into a body of water, typically composed of sand, silt or small pebbles. A spit or sandspit is a type of shoal.
language code: en); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">A somewhat linear landform  within or extending into a body of water, typically composed of sand, silt or small pebbles. A spit or sandspit is a type of shoal.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">SHOALS</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx1641"/>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/01400b09-68a3-4e3e-b076-1687e30bed56">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/c58320e6-3f1d-4c36-9bee-6bad73404c21"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-03-29 11:01:03.0 [tbs1979]  
insert Definition (id: null
text: A significant vertical, or near vertical, rock exposure. Cliffs are formed as erosion landforms due to the processes of erosion and weathering that produce them. Cliffs are common on coasts, in mountainous areas, escarpments and along rivers.
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2024-10-31 10:33:46.0 [tstevens]  
insert WeightedRelation (id: null
related concept uuid: a82477e6-b563-4135-90e8-c6977c7381be
relationship type: null
relationship value: null
generated by: null); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-02-18 14:18:09.0 [tbs1979] Insert Concept 
add broader relation (SEA CLIFFS [01400b09-68a3-4e3e-b076-1687e30bed56,82613] - COASTAL LANDFORMS [c58320e6-3f1d-4c36-9bee-6bad73404c21,62739]); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">A significant vertical, or near vertical, rock exposure. Cliffs are formed as erosion landforms due to the processes of erosion and weathering that produce them. Cliffs are common on coasts, in mountainous areas, escarpments and along rivers.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">SEA CLIFFS</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx963"/>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/860e25fa-e63a-4fd0-bde9-4f596b4a5929">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/c58320e6-3f1d-4c36-9bee-6bad73404c21"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-03-29 10:28:24.0 [tbs1979]  
insert Definition (id: null
text: Headlands and bays are often found together on the same stretch of coastline. A bay is surrounded by land on three sides, whereas a headland is surrounded by water on three sides. Headlands are characterized by high, breaking waves, rocky shores, intense erosion, and steep sea cliffs.
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-02-18 14:08:21.0 [tbs1979] Insert Concept 
add broader relation (HEADLANDS/BAYS/CAPE [860e25fa-e63a-4fd0-bde9-4f596b4a5929,82597] - COASTAL LANDFORMS [c58320e6-3f1d-4c36-9bee-6bad73404c21,62739]); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Headlands and bays are often found together on the same stretch of coastline. A bay is surrounded by land on three sides, whereas a headland is surrounded by water on three sides. Headlands are characterized by high, breaking waves, rocky shores, intense erosion, and steep sea cliffs.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">HEADLANDS/BAYS/CAPE</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx3065"/>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/0c51bdb0-54b0-4d0d-afd0-35ef7458ccb7">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/c58320e6-3f1d-4c36-9bee-6bad73404c21"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-02-18 12:25:39.0 [tbs1979] Insert Concept 
add broader relation (CUSPATE FORELANDS [0c51bdb0-54b0-4d0d-afd0-35ef7458ccb7,82577] - COASTAL LANDFORMS [c58320e6-3f1d-4c36-9bee-6bad73404c21,62739]); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-03-29 09:53:08.0 [tbs1979]  
insert Definition (id: null
text: Geographical features found on coastlines and created by long shore drift. Made out of sand and shingle, and later stabilized by vegetation, cuspate forelands are triangular-shaped accretions and extend seawards.
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2024-10-29 09:42:16.0 [tstevens]  
insert WeightedRelation (id: null
related concept uuid: 0c51bdb0-54b0-4d0d-afd0-35ef7458ccb7
relationship type: null
relationship value: null
generated by: null); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Geographical features found on coastlines and created by long shore drift. Made out of sand and shingle, and later stabilized by vegetation, cuspate forelands are triangular-shaped accretions and extend seawards.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">CUSPATE FORELANDS</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx970"/>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/85f409fd-9d81-4cac-84ed-fb0bb4599924">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/c58320e6-3f1d-4c36-9bee-6bad73404c21"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-02-18 14:16:55.0 [tbs1979] Insert Concept 
add broader relation (SALT MARSH [85f409fd-9d81-4cac-84ed-fb0bb4599924,82607] - COASTAL LANDFORMS [c58320e6-3f1d-4c36-9bee-6bad73404c21,62739]); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-03-29 10:36:20.0 [tbs1979]  
insert Definition (id: null
text: An environment in the upper coastal intertidal zone between land and salty or brackish water, dominated by dense stands of halophytic  (salt-tolerant) plants such as herbs, grasses, or low shrubs.
language code: en); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">An environment in the upper coastal intertidal zone between land and salty or brackish water, dominated by dense stands of halophytic  (salt-tolerant) plants such as herbs, grasses, or low shrubs.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
