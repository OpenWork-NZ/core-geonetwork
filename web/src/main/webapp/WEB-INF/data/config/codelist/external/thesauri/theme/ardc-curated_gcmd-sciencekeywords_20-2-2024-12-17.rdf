delete broader relation (null); 
add broader relation (CONDUCTIVITY [d14389d9-54f5-41a0-b8e8-dc9d8f87e4e2,84349] - WATER CHARACTERISTICS [f7e97dc3-1181-41b5-8b90-946eb2504110,310633]); 
