<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/57a381ef-56f6-48af-8974-822f5859979d">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/b887d3e5-4280-43d2-a34e-0f63ac086b6a"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2012-07-09 11:26:06.0 [mpmorahan]  
insert Definition (id: null
text: The ENSO zonal wind anomaly index is calculated for the region 
8N-8S, 150E-140W from the COADS data. This region was chosen from a map of 
zonal wind regressed onto an index of eastern equatorial Pacific SST for the 
period 1950-79. The anomalies are with respect to a 1950-79 climatology.
language code: en); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">The ENSO zonal wind anomaly index is calculated for the region 
8N-8S, 150E-140W from the COADS data. This region was chosen from a map of 
zonal wind regressed onto an index of eastern equatorial Pacific SST for the 
period 1950-79. The anomalies are with respect to a 1950-79 climatology.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">EQUATORIAL PACIFIC ZONAL WIND ANOMALY INDEX</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx2060"/>
</rdf:Description>

