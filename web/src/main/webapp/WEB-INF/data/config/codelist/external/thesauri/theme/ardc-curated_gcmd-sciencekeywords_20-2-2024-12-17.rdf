delete broader relation (null); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Also called Pressure Altitude. Barometric Altitude is the altitude&#xD;
which corresponds to a given value of atmospheric pressure according to&#xD;
the ICAO standard atmosphere. It is the indicated altitude of a pressure&#xD;
altimeter at an altimeter setting of 29.92 inches of mercury (1013.2&#xD;
mb); therefore it is the indicated altitude above the 1013.2 mb&#xD;
constant-pressure surface. RT</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">BAROMETRIC ALTITUDE</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx84"/>
</rdf:Description>

