<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/7eba0eef-3a30-4282-a162-1f483370ddc4">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/b73cee46-8e2c-4df9-b1ed-7f0aa98a04ac"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2012-06-29 13:46:50.0 [tbs1979]  
insert Definition (id: null
text: Refers to the production and use of hydroelectric energy for human consumption. Hydroelectric energy is electricity generated by hydropower, i.e., the production of electrical power through the use of the gravitational force of falling or flowing water. It is the most widely used form of renewable energy.
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2012-06-26 15:48:35.0 [tbs1979] Insert Concept 
add broader relation (HYDROELECTRIC ENERGY PRODUCTION/USE [7eba0eef-3a30-4282-a162-1f483370ddc4,40125] - ENERGY PRODUCTION/USE [b73cee46-8e2c-4df9-b1ed-7f0aa98a04ac,40101]); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Refers to the production and use of hydroelectric energy for human consumption. Hydroelectric energy is electricity generated by hydropower, i.e., the production of electrical power through the use of the gravitational force of falling or flowing water. It is the most widely used form of renewable energy.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">HYDROELECTRIC ENERGY PRODUCTION/USE</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx12"/>
</rdf:Description>

