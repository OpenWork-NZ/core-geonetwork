	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">MARINE VOLCANISM</prefLabel>
	<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/f345294c-36e6-4c76-b484-2204cc0bc3a2"/>
	<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/b677862b-7921-458f-a6db-0eb46469df33"/>
	<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/9bb0de49-1812-400c-a73b-d2686dd9066a"/>
