<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/e0a2edbb-8a94-4f47-918a-fe9f93aba5f4">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
