<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/32ffe87f-c0f0-4398-9a6a-755d7f87a5ff">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/6a2a2417-1a9c-4767-bffd-6b99f9747bab"/>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Sporozoans are one of four categories of protozoans. Sporozoan is an
informal name for parasitic protistans that complete part of the life
cycle inside specific cells of host organisms.  Many sporozoans cause
human diseases.  Plasmodium causes malaria while Cryptosporidium strains
which contaminate many water supplies can cause serious intestinal
disorders.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">SPOROZOANS</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx165"/>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/6a2a2417-1a9c-4767-bffd-6b99f9747bab">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/fbec5145-79e6-4ed0-a804-6228aa6daba5"/>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Protists are of the Kingdom Protista and are one of the diverse
eukaryotes, single-celled species of which may resemble the first
eukaryotic cells.  At the present they are categorized by what they are
not (not bacteria, fungi, plants, or animals).</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">PROTISTS</prefLabel>
