<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/8012fda7-3ea4-4ef2-bb4e-0f66d4d9e850">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/860e2af9-ce29-4f3f-b027-ae3747eb3e01"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2015-11-23 15:13:09.0 [aaleman] Insert Concept 
add narrower relation (SEA ICE CONCENTRATION [8012fda7-3ea4-4ef2-bb4e-0f66d4d9e850,86237] - ICE FRACTION [a3f36d7c-4eed-4d7a-8902-a5fcdc1b6261,158489]); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2024-10-02 13:50:53.0 [tstevens]  
insert WeightedRelation (id: null
related concept uuid: bb27bbb7-7bc4-4e38-833a-30e0a7861ccc
relationship type: null
relationship value: null
generated by: null); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">The ratio of the area of the water surface covered by ice as a fraction of
the whole area. Sea ice concentration has been monitored by polar
orbiting satellites at all wavelengths.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">SEA ICE CONCENTRATION</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx365"/>
	<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/a3f36d7c-4eed-4d7a-8902-a5fcdc1b6261"/>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/a3f36d7c-4eed-4d7a-8902-a5fcdc1b6261">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/8012fda7-3ea4-4ef2-bb4e-0f66d4d9e850"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2017-03-15 13:09:49.0 [mgenazzi] Definition added 
insert Definition (id: null
text: Sea ice is described by the area it covers, its thickness, its age, and its movement with the winds and ocean currents. Concentration is a unitless term that describes the relative amount of area covered by ice, compared to some reference area. Thus, concentration describes how much of a 25.0 kilometer by 25.0 kilometer (15.5 mile by 15.5 mile) box is covered by sea ice. Ice concentration typically is reported as a percentage (0 to 100 percent ice), a fraction from 0 to 1, or sometimes in tenths (0/10 to 10/10). Our Sea Ice Index products show ice concentration as a percentage. A value of 0 means there is no ice, while a value of 100 means the region is completely covered by ice.
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2015-11-23 15:13:09.0 [aaleman] Insert Concept 
add broader relation (ICE FRACTION [a3f36d7c-4eed-4d7a-8902-a5fcdc1b6261,158489] - SEA ICE CONCENTRATION [8012fda7-3ea4-4ef2-bb4e-0f66d4d9e850,86237]); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Sea ice is described by the area it covers, its thickness, its age, and its movement with the winds and ocean currents. Concentration is a unitless term that describes the relative amount of area covered by ice, compared to some reference area. Thus, concentration describes how much of a 25.0 kilometer by 25.0 kilometer (15.5 mile by 15.5 mile) box is covered by sea ice. Ice concentration typically is reported as a percentage (0 to 100 percent ice), a fraction from 0 to 1, or sometimes in tenths (0/10 to 10/10). Our Sea Ice Index products show ice concentration as a percentage. A value of 0 means there is no ice, while a value of 100 means the region is completely covered by ice.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">ICE FRACTION</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx2565"/>
</rdf:Description>

