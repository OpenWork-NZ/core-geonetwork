"http://amsglossary.allenpress.com/glossary/"</text>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/4309af7d-76c8-4856-8ed3-20693600228b">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/c69cde73-7bd9-489b-a20b-bd23cfb82d92"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2017-03-15 08:43:05.0 [mgenazzi] Definition added 
insert Definition (id: null
text: Phylum Chordata. Class Actinopterygii. Order Clupeiformes. Anchovies, Family Engraulidae, are small common salt-water forage fish with a large mouth, characterized by a blunt snout with teeth in both jaws and a rostral organ. Herring, Family Clupediae, are small common salt-water forage fish characterized by a single dorsal fin without spines, no lateral line and protruding lower jaw.
language code: en); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Phylum Chordata. Class Actinopterygii. Order Clupeiformes. Anchovies, Family Engraulidae, are small common salt-water forage fish with a large mouth, characterized by a blunt snout with teeth in both jaws and a rostral organ. Herring, Family Clupediae, are small common salt-water forage fish characterized by a single dorsal fin without spines, no lateral line and protruding lower jaw.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">ANCHOVIES/HERRINGS</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx853"/>
</rdf:Description>

