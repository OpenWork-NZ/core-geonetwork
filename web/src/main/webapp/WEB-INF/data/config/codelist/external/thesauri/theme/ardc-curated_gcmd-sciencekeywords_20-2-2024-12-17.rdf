	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2024-09-25 09:38:52.0 [tstevens]  
update Definition (Afforestation: "the establishment of trees on an area that has lacked forest
cover for a very long time or has never been forested. "
Reforestation: " the natural or artificial restocking (i.e., planting, seeding)
of an area with forest trees. Also called forest regeneration. "); 
update Definition (Government of British Columbia, Canada, Ministry of Forests, Glossary of Forest
Terms
"http://www.for.gov.bc.ca/pab/publctns/glossary/glossary.htm"); 
insert WeightedRelation (id: null
related concept uuid: a28eeef3-b252-4309-957b-860d2e0f97ef
relationship type: null
relationship value: null
generated by: null); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Afforestation: "the establishment of trees on an area that has lacked forest
cover for a very long time or has never been forested. "
Reforestation: " the natural or artificial restocking (i.e., planting, seeding)
of an area with forest trees. Also called forest regeneration. "</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">AFFORESTATION/REFORESTATION</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx2698"/>
</rdf:Description>

