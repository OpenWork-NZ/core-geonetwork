<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/6eef914d-ff9f-44b0-a3a6-3dcf911023d4">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/3526afb8-0dc9-43c7-8ad4-f34f250a1e91"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2024-09-30 09:28:48.0 [tstevens]  
update Definition (The wearing away of the land surface by rain or irrigation water, wind,
ice, or other natural or anthropogenic agents that abrade, detach and remove
geologic parent material or soil from one point on the earth's surface and
deposit it elsewhere, including such processes as gravitational creep and
so-called tillage erosion; The detachment and movement of soil or rock by
water, wind, ice, or gravity.); 
update Definition (From the Glossary of Soil Terms/Soil Science Society of America (SSSA):
"http://www.soils.org/sssagloss/"); 
insert WeightedRelation (id: null
related concept uuid: 36c862a7-7117-4fd2-8e33-0dda03097178
relationship type: null
relationship value: null
generated by: null); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">The wearing away of the land surface by rain or irrigation water, wind,
ice, or other natural or anthropogenic agents that abrade, detach and remove
geologic parent material or soil from one point on the earth's surface and
deposit it elsewhere, including such processes as gravitational creep and
so-called tillage erosion; The detachment and movement of soil or rock by
water, wind, ice, or gravity.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">SOIL EROSION</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx185"/>
</rdf:Description>

