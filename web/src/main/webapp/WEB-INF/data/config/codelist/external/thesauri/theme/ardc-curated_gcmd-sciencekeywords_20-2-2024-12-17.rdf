insert Definition (id: null
text: Refers to the production and use of coal for human consumption.
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2012-06-26 15:38:53.0 [tbs1979] Insert Concept 
