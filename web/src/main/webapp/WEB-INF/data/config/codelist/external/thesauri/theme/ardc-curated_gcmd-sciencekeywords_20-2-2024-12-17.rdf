<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/86c6042a-b7ca-4d97-b9d7-db22b1560810">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/b895f4b5-5273-49ef-883f-b67d9f199505"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-08-26 08:25:47.0 [tbs1979]  
insert Definition (id: null
text: In geology, a proglacial lake is a lake formed either by the damming action of a moraine or ice dam during the retreat of a melting glacier, or by meltwater trapped against an ice sheet due to isostatic depression of the crust around the ice.
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2024-10-30 15:46:11.0 [tstevens]  
