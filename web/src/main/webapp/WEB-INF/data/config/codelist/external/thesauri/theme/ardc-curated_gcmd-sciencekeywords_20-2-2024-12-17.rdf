	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2017-04-21 11:44:21.0 [tstevens]  
insert Definition (id: null
text: A coastal local wind that blows from sea to land, caused by the temperature difference when the sea surface is colder than the adjacent land.
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2017-04-20 15:11:30.0 [sritz] Insert Concept 
