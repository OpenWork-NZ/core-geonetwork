insert Definition (id: null
text: The rate and speed at which the Earth rotates around its own axis. The Earth rotates towards the east. As viewed from the North Star Polaris, the Earth turns counter-clockwise.
language code: en); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">The rate and speed at which the Earth rotates around its own axis. The Earth rotates towards the east. As viewed from the North Star Polaris, the Earth turns counter-clockwise.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
