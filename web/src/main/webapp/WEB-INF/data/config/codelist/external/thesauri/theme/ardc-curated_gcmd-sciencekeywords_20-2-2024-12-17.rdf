<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/d6ba91a1-a5f4-47e3-9485-89348235acb9">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/8ce319a5-9b49-49e3-8981-3ce512c7efb0"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-02-12 11:45:21.0 [mpmorahan] Insert Concept 
add broader relation (CIRRUS KELVIN-HELMHOLTZ COLOMBIAH [d6ba91a1-a5f4-47e3-9485-89348235acb9,82149] - CIRRUS/SYSTEMS [8ce319a5-9b49-49e3-8981-3ce512c7efb0,82147]); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2024-10-09 10:11:05.0 [tstevens]  
insert Definition (id: null
text: A cloud that produces a billowing wave pattern. They occur when there is a strong vertical shear between two air streams, causing winds to blow faster at the upper level than at the lower levels.
language code: en); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">A cloud that produces a billowing wave pattern. They occur when there is a strong vertical shear between two air streams, causing winds to blow faster at the upper level than at the lower levels.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">CIRRUS KELVIN-HELMHOLTZ COLOMBIAH</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx276"/>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/8ce319a5-9b49-49e3-8981-3ce512c7efb0">
