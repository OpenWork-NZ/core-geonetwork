insert Definition (id: null
text: For a given cloud or cloud layer, the highest level in the atmosphere at which the air contains a perceptible quantity of cloud particles.
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-03-21 14:44:17.0 [mpmorahan] Insert Concept 
