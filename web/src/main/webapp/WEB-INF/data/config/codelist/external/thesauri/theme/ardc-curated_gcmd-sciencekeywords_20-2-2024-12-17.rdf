	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-08-20 12:48:42.0 [tbs1979]  
insert Definition (id: null
text: Refers to the chemical makeup and characteristics of sediments. In chemistry, sedimentation has been used to measure the size of large molecules (macromolecule), where the force of gravity is augmented with centrifugal force in an ultracentrifuge.
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-08-05 12:42:33.0 [tbs1979] Insert Concept 
