	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">A colorless, odorless gas with the chemical formula N2, constituting 78% of
the atmosphere.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">NITROGEN</prefLabel>
</rdf:Description>

