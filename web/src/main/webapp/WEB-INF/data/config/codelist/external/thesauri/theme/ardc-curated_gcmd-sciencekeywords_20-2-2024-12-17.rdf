<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/38f99d8b-80af-439a-9d3f-1e72aef5d7c3">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/42c6d91b-afef-4638-95c5-0d130828b2e7"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2018-03-07 09:30:12.0 [tstevens]  
insert Definition (id: null
text: A chemical element that is a shiny gray solid and has the same electron configuration in the outer electron shell and a similar crystal structure. Magnesium is the ninth most abundant element in the universe. It is produced in large, aging stars from the sequential addition of three helium nuclei to a carbon nucleus.
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2018-03-07 07:53:25.0 [tstevens] Insert Concept 
add broader relation (MAGNESIUM [38f99d8b-80af-439a-9d3f-1e72aef5d7c3,310661] - CONTAMINANTS [42c6d91b-afef-4638-95c5-0d130828b2e7,84623]); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">A chemical element that is a shiny gray solid and has the same electron configuration in the outer electron shell and a similar crystal structure. Magnesium is the ninth most abundant element in the universe. It is produced in large, aging stars from the sequential addition of three helium nuclei to a carbon nucleus.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">MAGNESIUM</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx341"/>
</rdf:Description>

