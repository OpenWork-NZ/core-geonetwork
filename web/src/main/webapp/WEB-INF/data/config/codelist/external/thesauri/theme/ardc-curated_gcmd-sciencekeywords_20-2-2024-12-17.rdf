<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/bdc0bd86-a3a3-48fa-b1fb-4ca5d13d4dde">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/d35b9ba5-d018-48a5-8f0d-92b9c55b3279"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-08-15 13:19:44.0 [tbs1979]  
insert Definition (id: null
text: "Fluvial landforms" are features on the Earth's surface produced by the action, i.e. erosion and deposition, of a stream or river and include such landforms as bars, levees, braided and meandering channels, and alluvial fans.  "Fluvial processes" are those processes included in the action of running water in a stream or river
language code: en); 
</changeNote>
