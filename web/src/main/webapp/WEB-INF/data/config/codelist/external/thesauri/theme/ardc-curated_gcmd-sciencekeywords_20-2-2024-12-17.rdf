insert Definition (id: null
text: Restriction-site Associated DNA Sequencing, a method that samples at reduced complexity across target genomes. Mainly used to deliver high resolution population genomic data without whole-genome sequencing.
language code: en); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Restriction-site Associated DNA Sequencing, a method that samples at reduced complexity across target genomes. Mainly used to deliver high resolution population genomic data without whole-genome sequencing.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
