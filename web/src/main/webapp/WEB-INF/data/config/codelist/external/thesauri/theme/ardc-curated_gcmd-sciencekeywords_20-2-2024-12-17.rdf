<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/ebb8ef06-0f73-48eb-bc22-47f36a729bc6">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/e26803a0-82ea-40c4-a41a-9e222c9bd09a"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-08-20 09:59:04.0 [tbs1979]  
insert Definition (id: null
text: A form of erosion caused by the force of moving water currents rushing into a crack in the rockface. It is strong enough to loosen sediment along the river bed and banks. The water compresses the air in the crack, pushing it right to the back.
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-08-06 08:36:46.0 [tbs1979] Insert Concept 
add broader relation (HYDRAULIC ACTION [ebb8ef06-0f73-48eb-bc22-47f36a729bc6,105565] - COASTAL PROCESSES [e26803a0-82ea-40c4-a41a-9e222c9bd09a,86507]); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2024-10-11 14:18:03.0 [tstevens]  
