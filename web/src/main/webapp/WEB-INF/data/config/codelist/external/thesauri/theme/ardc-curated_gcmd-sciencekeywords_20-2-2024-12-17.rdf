<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/ddb4ca0c-9b19-442d-8bcc-e664544d3fe9">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/142ea0c1-b77f-44da-8c64-ac7ee13fd5f6"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2016-07-12 09:45:00.0 [gee-cee]  
update PrefLabel (MONTANE GRASSLAND); 
insert Definition (id: null
text: a biome defined by the World Wildlife Fund. The biome includes high altitude grasslands and shrublands around the world. The term "montane" in the name of the biome refers to "high altitude", rather than the ecological term which denotes the region below treeline.
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2016-07-12 09:43:53.0 [gee-cee] Insert Concept 
add broader relation (Montane Grassland [ddb4ca0c-9b19-442d-8bcc-e664544d3fe9,247443] - GRASSLANDS [142ea0c1-b77f-44da-8c64-ac7ee13fd5f6,85105]); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">a biome defined by the World Wildlife Fund. The biome includes high altitude grasslands and shrublands around the world. The term "montane" in the name of the biome refers to "high altitude", rather than the ecological term which denotes the region below treeline.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">MONTANE GRASSLAND</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx281"/>
</rdf:Description>

