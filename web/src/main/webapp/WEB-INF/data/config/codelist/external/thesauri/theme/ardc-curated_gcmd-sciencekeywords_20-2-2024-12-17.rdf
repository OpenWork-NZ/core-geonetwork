<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/321d9086-fc85-40a3-a2e0-d24bc6765345">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/cacfd8f0-b83a-46b7-b324-52ce1b55baa9"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-03-05 09:48:54.0 [tbs1979] Insert Concept 
add broader relation (TEMPERATURE PROFILES [321d9086-fc85-40a3-a2e0-d24bc6765345,82899] - GEOTHERMAL TEMPERATURE [cacfd8f0-b83a-46b7-b324-52ce1b55baa9,61793]); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-03-11 15:40:59.0 [tbs1979]  
insert Definition (id: null
text: The change of air temperature with height above the ground. When the temperature increases with height, the profile is called an inversion profile, or simply an inversion. When the temperature decreases strongly with height, a convective profile may be established.
language code: en); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">The change of air temperature with height above the ground. When the temperature increases with height, the profile is called an inversion profile, or simply an inversion. When the temperature decreases strongly with height, a convective profile may be established.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">TEMPERATURE PROFILES</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx1042"/>
</rdf:Description>

