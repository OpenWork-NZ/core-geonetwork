	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Photosynthesis is the synthesis of carbohydrates from carbon dioxide and
water by chlorphyll using light as energy with oxygen as a
byproduct.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">PHOTOSYNTHESIS</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx89"/>
</rdf:Description>

