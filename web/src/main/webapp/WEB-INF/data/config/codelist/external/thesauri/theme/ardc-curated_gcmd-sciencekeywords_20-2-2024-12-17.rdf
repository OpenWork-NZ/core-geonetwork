<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/c63be844-efa7-49f6-8089-c60111bbdffb">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/416221ec-04e1-4913-aacb-9045551949c4"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-08-16 14:44:04.0 [tbs1979]  
insert Definition (id: null
text: U-shaped mounds of sand with convex noses trailed by elongated arms are parabolic dunes. Sometimes these dunes are called U-shaped, blowout, or hairpin dunes, and they are well known in coastal deserts. Unlike crescent shaped dunes, their crests point upwind. The elongated arms of parabolic dunes follow rather than lead because they have been fixed by vegetation, while the bulk of the sand in the dune migrates forward.
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2024-11-06 10:11:12.0 [tstevens]  
insert WeightedRelation (id: null
related concept uuid: 4cce9a44-da57-4169-b89f-6b1460fcedb9
relationship type: null
relationship value: null
generated by: null); 
