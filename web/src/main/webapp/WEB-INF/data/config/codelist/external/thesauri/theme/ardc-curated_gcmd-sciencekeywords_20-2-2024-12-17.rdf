</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">One of the major greenhouse gases. Atmospheric carbon dioxide is caused mainly by the burning of fossil fuels and deforestation. The chemical formula for carbon dioxide is CO2. Long-term measurements of CO2 in the atmosphere are conducted at Manua Loa, Hawaii and several international monitoring stations around the world.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">ATMOSPHERIC CARBON DIOXIDE</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx1268"/>
	<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/194d8a3c-9cdd-45f3-8b4c-ce7830d9df46"/>
	<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/a65cfcfa-1028-4cc8-a4d5-9e78f487a612"/>
	<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/03ddc432-906d-4469-bb00-179c828dbea4"/>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/cdab2cca-6767-427e-b464-09fe26ec59db">
