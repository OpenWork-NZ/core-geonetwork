<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/5d3725b6-743b-4dda-bb54-b64f201ec4d1">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/14802b53-b702-438f-8c8a-f51506807ce6"/>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Reptiles are cold-blooded tetrapod craniates which breathe using lungs, have
a dry, scaly skin and lay large, shelled eggs.  They live in all types
of terrestrial habitats, the majority in tropical regions; many
secondarily freshwater and marine species.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">REPTILES</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx1281"/>
	<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/7dce336b-8596-45f0-bc76-f82b26e1405f"/>
	<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/2037d286-6285-49df-aeb4-6e429b18d595"/>
	<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/3f1803fa-3ada-4762-96e4-28966dfdcc83"/>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/7dce336b-8596-45f0-bc76-f82b26e1405f">
