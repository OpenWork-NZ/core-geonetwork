<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/ab702934-0959-45fc-a523-81e1aa0c09c8">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/63effad4-4323-486d-a81b-e0bf3264e5c9"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-03-21 14:51:02.0 [mpmorahan]  
insert Definition (id: null
text: (Sometimes incorrectly called coagulation.) In cloud physics, usually the growth of an ice hydrometeor by collision with supercooled cloud drops that freeze wholly or partially upon contact.

May also refer to the collection of smaller ice particles. This has been called a form of agglomeration and is analogous to coalescence, in which liquid drops collect other liquid drops.
    See ice accretion;
    compare coagulation.

In cloud modeling, the collection of cloud drops by drizzle drops and raindrops.

This nomenclature is used along with autoconversion and self collection to distinguish among three subprocesses, evident from numerical results, responsible for the growth of the drop-size distribution by the collision–coalescence process.  American Meteorological Society (http://glossary.ametsoc.org/wiki/Main_Page)"
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-02-14 14:50:04.0 [mpmorahan] Insert Concept 
add broader relation (ACCRETION [ab702934-0959-45fc-a523-81e1aa0c09c8,82313] - DROPLET GROWTH [63effad4-4323-486d-a81b-e0bf3264e5c9,82309]); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-02-14 14:51:07.0 [mpmorahan] Insert Concept 
add narrower relation (ACCRETION [ab702934-0959-45fc-a523-81e1aa0c09c8,82313] - RIMING [889253e1-e189-4f75-bdc7-7e612b19e3ae,82315]); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">(Sometimes incorrectly called coagulation.) In cloud physics, usually the growth of an ice hydrometeor by collision with supercooled cloud drops that freeze wholly or partially upon contact.

May also refer to the collection of smaller ice particles. This has been called a form of agglomeration and is analogous to coalescence, in which liquid drops collect other liquid drops.
    See ice accretion;
    compare coagulation.

In cloud modeling, the collection of cloud drops by drizzle drops and raindrops.

This nomenclature is used along with autoconversion and self collection to distinguish among three subprocesses, evident from numerical results, responsible for the growth of the drop-size distribution by the collision–coalescence process.  American Meteorological Society (http://glossary.ametsoc.org/wiki/Main_Page)"</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">ACCRETION</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx1360"/>
	<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/889253e1-e189-4f75-bdc7-7e612b19e3ae"/>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/889253e1-e189-4f75-bdc7-7e612b19e3ae">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/ab702934-0959-45fc-a523-81e1aa0c09c8"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2017-03-15 17:36:40.0 [sritz]  
insert Definition (id: null
text: The process where ice forms when the water droplets in fog freeze to the outer surfaces of objects
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-02-14 14:51:07.0 [mpmorahan] Insert Concept 
add broader relation (RIMING [889253e1-e189-4f75-bdc7-7e612b19e3ae,82315] - ACCRETION [ab702934-0959-45fc-a523-81e1aa0c09c8,82313]); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">The process where ice forms when the water droplets in fog freeze to the outer surfaces of objects</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">RIMING</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx3029"/>
