insert Definition (id: null
text: Division Pteridophyta. Class Lycopodiopsida. Order Lycopodiales. Lycopodium, commonly called club mosses, are asexual, flowerless, vascular plants with widely branched stems and needle-like leaves.
language code: en); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Division Pteridophyta. Class Lycopodiopsida. Order Lycopodiales. Lycopodium, commonly called club mosses, are asexual, flowerless, vascular plants with widely branched stems and needle-like leaves.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
