<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/bcb42cdb-0ad3-42e1-ac72-8af05c68cf48">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/370eba54-962b-4e59-9686-86d5c5ab9c88"/>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">A report regarding the current state of wild and domestic animals, excluding humans, physical well-being as it may be affected by certain environmental factors and/or human interaction. An environmental factor may include local, regional, or global climate changes such as drought. Human intervention may include preservation.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">ANIMAL HEALTH ADVISORIES</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx390"/>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/370eba54-962b-4e59-9686-86d5c5ab9c88">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/09d00879-6d96-4df4-9f50-73bd761118d9"/>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Reports providing information on changes in environmental factors including warnings about epidemiological or environmental hazards that potentially threaten animal or human health.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">HEALTH ADVISORIES</prefLabel>
