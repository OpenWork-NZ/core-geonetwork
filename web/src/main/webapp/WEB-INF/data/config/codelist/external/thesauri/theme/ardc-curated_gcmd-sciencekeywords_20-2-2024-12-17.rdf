	<text xmlns="https://gcmd.earthdata.nasa.gov/kms#" xml:lang="en">WikiPedia, http://en.wikipedia.org/wiki/Methanol</text>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/620a9e6c-5851-48b7-93c5-a1706546f5d1">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/bdc0bd86-a3a3-48fa-b1fb-4ca5d13d4dde"/>
