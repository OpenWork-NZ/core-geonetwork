	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">A form of erosion caused by the force of moving water currents rushing into a crack in the rockface. It is strong enough to loosen sediment along the river bed and banks. The water compresses the air in the crack, pushing it right to the back.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">HYDRAULIC ACTION</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx674"/>
</rdf:Description>

