	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2024-02-28 10:13:51.0 [tstevens] Insert Concept 
add broader relation (TRANSCRIPTOMIC ANALYSIS [19291970-5f7d-47b0-9101-11b03a15d9ee,1603371] - OMICS METHODOLOGY [d2f152e1-7398-44ad-b0a4-77ee6ef5bd6c,1603367]); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2024-02-28 12:33:08.0 [tstevens]  
insert Definition (id: null
text: The key aims of transcriptomics are: to catalog all species of transcript, including mRNAs, non-coding RNAs and small RNAs; to determine the transcriptional structure of genes, in terms of their start sites, 5′ and 3′ ends, splicing patterns, and other post-transcriptional modifications; and to quantify the changing expression levels of each transcript during development and under different conditions.
language code: en); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">The key aims of transcriptomics are: to catalog all species of transcript, including mRNAs, non-coding RNAs and small RNAs; to determine the transcriptional structure of genes, in terms of their start sites, 5′ and 3′ ends, splicing patterns, and other post-transcriptional modifications; and to quantify the changing expression levels of each transcript during development and under different conditions.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">TRANSCRIPTOMIC ANALYSIS</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx1710"/>
</rdf:Description>

