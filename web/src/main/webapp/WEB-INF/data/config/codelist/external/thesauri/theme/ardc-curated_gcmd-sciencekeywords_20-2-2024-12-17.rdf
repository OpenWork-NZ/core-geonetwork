</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/77cbdebf-eddf-42b5-8603-e939eccd1780">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/45325a01-2522-48d3-bffa-0edf1a934d48"/>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Lake level fluctuations can provide important evidence for paleoclimatic
conditions, particulary in arid and semiarid areas. Lake levels are
particularly sensitive to changes in hydrologic balance due to climatic
fluctuations. Lakes may develop and expand if there is an abundance of
precipitation and will recede and even dry up (due to evaporation) during
prolonged droughts. Lake sediment cores are often drilled to provide
stratigraphic clues to past climate conditions.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">LAKE LEVELS</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx377"/>
</rdf:Description>

<rdf:Description rdf:nodeID="node1igi5qapbx377">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<text xmlns="https://gcmd.earthdata.nasa.gov/kms#" xml:lang="en">Bradley, R.S. 1999. Paleoclimatology: Reconstructing Climates of the
Quaternary, 2nd edition. Harcourt Academic Press (especially Chapter 7.6).</text>
</rdf:Description>

