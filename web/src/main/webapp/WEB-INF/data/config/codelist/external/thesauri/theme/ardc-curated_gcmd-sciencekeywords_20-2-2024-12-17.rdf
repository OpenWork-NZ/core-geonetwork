<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/d9667e73-30db-45f9-861c-e0a5caaf2bf0">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/860e2af9-ce29-4f3f-b027-ae3747eb3e01"/>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Melt of the ice can occur at various stages: puddle, thaw holes, dried&#xD;
ice, rotten ice, flodded ice, and frozen puddle. Developing sea ice (or&#xD;
growth) takes on the following stages: New Ice, Youg Ice, First-Year Ice,&#xD;
Old Ice. Lake Ice development goes through the following stages: New Lake&#xD;
Ice, Thin Lake Ice, Medium Lake Ice, Thick Lake Ice, and Very Thick Lake&#xD;
Ice.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">ICE GROWTH/MELT</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx328"/>
</rdf:Description>

