<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/879cccd4-d375-40f6-8bee-6f58efd2dd61">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/9a802ef3-680d-4bc6-a42e-aa84d5eb9908"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2017-03-16 10:22:25.0 [sritz]  
insert Definition (id: null
text: (Also called Mesoscale Convective System) A cloud system that occurs in connection with an ensemble of thunderstorms and produces a contiguous precipitation area on the order of 100 km or more in horizontal scale in at least one direction.
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-02-14 09:10:10.0 [mpmorahan] Insert Concept 
add broader relation (DEEP CONVECTIVE CLOUD SYSTEMS [879cccd4-d375-40f6-8bee-6f58efd2dd61,82193] - CONVECTIVE CLOUDS/SYSTEMS (OBSERVED/ANALYZED) [9a802ef3-680d-4bc6-a42e-aa84d5eb9908,82127]); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">(Also called Mesoscale Convective System) A cloud system that occurs in connection with an ensemble of thunderstorms and produces a contiguous precipitation area on the order of 100 km or more in horizontal scale in at least one direction.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">DEEP CONVECTIVE CLOUD SYSTEMS</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx2398"/>
</rdf:Description>

