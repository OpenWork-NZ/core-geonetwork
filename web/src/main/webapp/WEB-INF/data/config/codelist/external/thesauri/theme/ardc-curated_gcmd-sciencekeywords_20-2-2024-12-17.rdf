	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2024-10-09 09:20:56.0 [tstevens]  
insert Definition (id: null
text: Refers to the intensity of energy emitted by the Sun, which can be harnessed for various applications such as solar sails, solar thermal propulsion, and electric power generation. The flux decreases as the distance from the Sun increases, following the inverse square law.
language code: en); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Refers to the intensity of energy emitted by the Sun, which can be harnessed for various applications such as solar sails, solar thermal propulsion, and electric power generation. The flux decreases as the distance from the Sun increases, following the inverse square law.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">SOLAR FLUX</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx555"/>
</rdf:Description>

