	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx1018"/>
	<altLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Total Cloud Liquid Water/Ice</altLabel>
	<altLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">CLW</altLabel>
	<altLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Liquid Water Content</altLabel>
	<altLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">LWC</altLabel>
	<altLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Cloud Ice/Water Content</altLabel>
</rdf:Description>

