insert Definition (id: null
text: Large-scale maps and nautical charts required to properly depict shoreline, shoreline features, navigation aids, and other navigationally significant features such as piers, docks, pilings, etc. These maps are compiled from remotely sensed data such as aerial photographs, LIDAR or satellite imagery.
language code: en); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Large-scale maps and nautical charts required to properly depict shoreline, shoreline features, navigation aids, and other navigationally significant features such as piers, docks, pilings, etc. These maps are compiled from remotely sensed data such as aerial photographs, LIDAR or satellite imagery.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">SHORELINE MAPPING</prefLabel>
