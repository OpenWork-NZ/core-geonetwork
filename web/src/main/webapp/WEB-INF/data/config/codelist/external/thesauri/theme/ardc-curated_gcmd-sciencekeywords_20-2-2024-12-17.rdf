	<text xmlns="https://gcmd.earthdata.nasa.gov/kms#" xml:lang="en">https://www.sciencedirect.com/topics/earth-and-planetary-sciences/permittivity</text>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/8f4e90e0-aea0-40cd-b781-a6a69a6e6cb3">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/2bedb6b3-6e92-42e2-b382-60e2a6aab8e9"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2012-07-23 17:26:53.0 [mpmorahan]  
insert Definition (id: null
text: Radiocarbon refers to radioactive carbon especially carbon-14, but also carbon-10 and carbon-12. Carbon-14 is a heavy radioactive isotope of Carbon having a mass of 14 and a half-life of 5730 +/-40 years. Carbon-14 is useful in dating organic materials during the last 50,000 years.
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2012-06-26 14:48:07.0 [gee-cee] Insert Concept 
add broader relation (RADIOCARBON [8f4e90e0-aea0-40cd-b781-a6a69a6e6cb3,40013] - LAND RECORDS [2bedb6b3-6e92-42e2-b382-60e2a6aab8e9,39979]); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Radiocarbon refers to radioactive carbon especially carbon-14, but also carbon-10 and carbon-12. Carbon-14 is a heavy radioactive isotope of Carbon having a mass of 14 and a half-life of 5730 +/-40 years. Carbon-14 is useful in dating organic materials during the last 50,000 years.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">RADIOCARBON</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx549"/>
</rdf:Description>

