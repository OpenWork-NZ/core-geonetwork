<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/694e18ec-ceaf-4070-9763-f3ee6dbd6b5b">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/9673dc0b-89c0-4f0c-b378-f1c8cb267c8f"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-08-16 10:23:01.0 [tbs1979]  
insert Definition (id: null
text: An area of highland, usually consisting of relatively flat terrain. A highly eroded plateau is called a dissected plateau. A volcanic plateau is a plateau produced by volcanic activity.
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-08-05 13:57:30.0 [tbs1979] Insert Concept 
add broader relation (PLATEAU [694e18ec-ceaf-4070-9763-f3ee6dbd6b5b,105401] - TECTONIC LANDFORMS [9673dc0b-89c0-4f0c-b378-f1c8cb267c8f,105291]); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">An area of highland, usually consisting of relatively flat terrain. A highly eroded plateau is called a dissected plateau. A volcanic plateau is a plateau produced by volcanic activity.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">PLATEAU</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx2087"/>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/a9f7bee8-fb32-40b1-9936-ecf6f6597b6b">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/9673dc0b-89c0-4f0c-b378-f1c8cb267c8f"/>
