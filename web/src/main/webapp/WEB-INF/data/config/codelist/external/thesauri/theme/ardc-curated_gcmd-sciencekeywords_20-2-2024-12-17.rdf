insert Definition (id: null
text: Phylum Chordata. Class Actinopterygii. Order Gadiformes. Family Gadidae. Commonly called cods or haddock, are small commercially important fishes characterized by three dorsal fins, two anal fins, no fin spines, forward pectoral fins, even tail fins and protruding lower jaw.
language code: en); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Phylum Chordata. Class Actinopterygii. Order Gadiformes. Family Gadidae. Commonly called cods or haddock, are small commercially important fishes characterized by three dorsal fins, two anal fins, no fin spines, forward pectoral fins, even tail fins and protruding lower jaw.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">CODS/HADDOCKS</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx682"/>
</rdf:Description>

