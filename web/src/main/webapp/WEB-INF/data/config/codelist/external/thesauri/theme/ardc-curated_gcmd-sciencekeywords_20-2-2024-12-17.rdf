relationship type: null
relationship value: null
generated by: null); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Lacustrine Wetlands are lakes, or former lakes, that are naturally filled with shallow water at certain times and more or less drained at other times.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">LACUSTRINE WETLANDS</prefLabel>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/b70ef20c-7215-4a39-9479-dbff7c2fdca9">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/b72c49a1-8276-4753-8c88-894bc7bbf60d"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2017-03-15 11:46:47.0 [mgenazzi] Definition added 
insert Definition (id: null
text: Peatlands are areas formed by a brown mass of organic matter in which twigs, roots, and other plant parts can still be recognized.  These areas formed due to lack of enough oxygen to decay vegetation completely on land. Peatlands form in fresh-water swamps, indicated by the plant fossils.
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2024-11-05 14:17:53.0 [tstevens]  
insert WeightedRelation (id: null
related concept uuid: f3b5489d-6723-40bf-bd55-68a0f2fc1874
relationship type: null
relationship value: null
generated by: null); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Peatlands are areas formed by a brown mass of organic matter in which twigs, roots, and other plant parts can still be recognized.  These areas formed due to lack of enough oxygen to decay vegetation completely on land. Peatlands form in fresh-water swamps, indicated by the plant fossils.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">PEATLANDS</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx350"/>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/6cec3b57-1a7f-404d-afde-4de045ef0dd2">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
