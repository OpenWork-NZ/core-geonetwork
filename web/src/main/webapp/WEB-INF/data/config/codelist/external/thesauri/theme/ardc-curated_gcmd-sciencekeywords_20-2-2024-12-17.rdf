<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/e91ca626-7afa-4e36-8a28-f8df6fc9d797">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/f2044dcf-40da-4fcc-97ab-914343d885a5"/>
