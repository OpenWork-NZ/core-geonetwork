</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/41575931-3cc4-4c9d-97a7-dde82bb0e19e">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/02ea239e-4bca-4fda-ab87-be12c723c30a"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2021-03-02 09:13:54.0 [tstevens]  
insert Definition (id: null
text: The amounts of different size particles of solids or liquids that are suspended in air as an aerosol.
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2021-02-26 07:59:22.0 [tstevens] Insert Concept 
add broader relation (AEROSOL SIZE DISTRIBUTION [41575931-3cc4-4c9d-97a7-dde82bb0e19e,560863] - AEROSOL PARTICLE PROPERTIES [02ea239e-4bca-4fda-ab87-be12c723c30a,85549]); 
</changeNote>
