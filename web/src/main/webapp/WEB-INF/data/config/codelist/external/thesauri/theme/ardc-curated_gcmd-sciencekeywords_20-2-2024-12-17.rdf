	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-03-11 14:30:12.0 [tbs1979]  
insert Definition (id: null
text: The magnetic intensity of the Earth's pull on an object, such as a satellite and measured by

X (easterly intensity),

Y (northerly intensity) and,

Z (vertical intensity, positive downwards).
language code: en); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">The magnetic intensity of the Earth's pull on an object, such as a satellite and measured by

X (easterly intensity),

Y (northerly intensity) and,

Z (vertical intensity, positive downwards).</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
