insert Definition (id: null
text: A methodological and application area of epidemiology concerned with the application of space-based systems (communication, Earth observation, positioning systems, Geographical Information Systems. biostatistics, etc.) in the study of the space and time distribution of health events or disease process in populations.
language code: en); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">A methodological and application area of epidemiology concerned with the application of space-based systems (communication, Earth observation, positioning systems, Geographical Information Systems. biostatistics, etc.) in the study of the space and time distribution of health events or disease process in populations.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">TELE-EPIDEMIOLOGY</prefLabel>
