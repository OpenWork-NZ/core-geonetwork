<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/7ebe88d4-fa73-4dd1-8cbd-6b1c266dff52">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/cda9b483-8711-42b8-82f9-e7d22ce9c62c"/>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Airspeed is the speed on an exposed (usually airborne) object relative to the&#xD;
atmosphere. &#xD;
In a calm atmosphere, airspeed equals ground speed. Ground speed is the speed&#xD;
of an airborne object relative to the earth's surface.	It is the magnitude of&#xD;
the vector sum of the object's velocity with respect to the air and the wind&#xD;
velocity, or, expressed in a different manner, the algebraic sum of the&#xD;
aircraft's airspeed and the wind factor.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">AIRSPEED/GROUND SPEED</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx890"/>
</rdf:Description>

