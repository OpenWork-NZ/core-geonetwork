add broader relation (SEDIMENT THICKNESS [13090c27-d808-4e51-a8ca-2f2c7b958f57,1484199] - SEDIMENTATION [b1de8d2f-cfe6-4358-a4cd-5b7e19d0e585,1483155]); 
