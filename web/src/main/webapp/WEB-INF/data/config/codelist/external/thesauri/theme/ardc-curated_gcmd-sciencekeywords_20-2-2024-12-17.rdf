<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/a272028a-5a84-4a52-b689-b45d5b6adfff">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/d2f152e1-7398-44ad-b0a4-77ee6ef5bd6c"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2024-02-28 14:52:40.0 [tstevens]  
insert Definition (id: null
text: The Basic Local Alignment Search Tool that finds regions of local similarity between sequences. The program compares nucleotide or protein sequences to sequence databases and calculates the statistical significance of matches. BLAST can be used to infer functional and evolutionary relationships between sequences as well as help identify members of gene families.
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2024-02-28 13:48:46.0 [tstevens] Insert Concept 
add broader relation (BLAST [a272028a-5a84-4a52-b689-b45d5b6adfff,1603379] - OMICS METHODOLOGY [d2f152e1-7398-44ad-b0a4-77ee6ef5bd6c,1603367]); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">The Basic Local Alignment Search Tool that finds regions of local similarity between sequences. The program compares nucleotide or protein sequences to sequence databases and calculates the statistical significance of matches. BLAST can be used to infer functional and evolutionary relationships between sequences as well as help identify members of gene families.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">BLAST</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx2904"/>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/3078eaeb-541e-44a0-9828-a1020f7bc6cf">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/d2f152e1-7398-44ad-b0a4-77ee6ef5bd6c"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2024-02-28 11:39:48.0 [tstevens]  
insert Definition (id: null
text: A bin is a subset of genomic fragments that are believed to be from the same species in a metagenomic community. Contig binning aims to put the assembled genomic fragments, or contigs, from the same genome into the same bin. The contigs from these bins are then presented as a single collection to form metagenome-assembled genomes (MAGs).
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2024-02-28 10:16:37.0 [tstevens] Insert Concept 
add broader relation (BIN/BINNING [3078eaeb-541e-44a0-9828-a1020f7bc6cf,1603374] - OMICS METHODOLOGY [d2f152e1-7398-44ad-b0a4-77ee6ef5bd6c,1603367]); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">A bin is a subset of genomic fragments that are believed to be from the same species in a metagenomic community. Contig binning aims to put the assembled genomic fragments, or contigs, from the same genome into the same bin. The contigs from these bins are then presented as a single collection to form metagenome-assembled genomes (MAGs).</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">BIN/BINNING</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx2740"/>
</rdf:Description>

