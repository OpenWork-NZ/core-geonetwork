	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2012-07-26 12:06:08.0 [mpmorahan]  
insert Definition (id: null
text: The sediment thickness at any location on the continental margin is the vertical distance from the sea floor to the top of the basement at the base of the sediments, regardless of the slope of the sea floor or the slope of the top basement surface.
language code: en); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">The sediment thickness at any location on the continental margin is the vertical distance from the sea floor to the top of the basement at the base of the sediments, regardless of the slope of the sea floor or the slope of the top basement surface.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">SEDIMENT THICKNESS</prefLabel>
