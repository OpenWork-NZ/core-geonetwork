<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/d3ad1ced-39fa-4e3a-a75d-58e5393a2abe">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/2575cfaf-1a09-48b6-acb9-fda23b6f4719"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-08-06 14:49:27.0 [tbs1979] Insert Concept 
add broader relation (LATERAL MORAINE [d3ad1ced-39fa-4e3a-a75d-58e5393a2abe,105645] - MORAINES [2575cfaf-1a09-48b6-acb9-fda23b6f4719,105627]); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-08-26 08:44:50.0 [tbs1979]  
insert Definition (id: null
text: Parallel ridges of debris deposited along the sides of a glacier. The unconsolidated debris can be deposited on top of the glacier by frost shattering of the valley walls and from tributary streams flowing into the valley.
language code: en); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Parallel ridges of debris deposited along the sides of a glacier. The unconsolidated debris can be deposited on top of the glacier by frost shattering of the valley walls and from tributary streams flowing into the valley.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">LATERAL MORAINE</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx1668"/>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/16bd425e-9a14-41ac-900e-5b5c4f713dda">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/2575cfaf-1a09-48b6-acb9-fda23b6f4719"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2024-11-06 12:10:41.0 [tstevens]  
insert WeightedRelation (id: null
related concept uuid: 7886c3eb-e86e-4a84-9f2f-e398ecc82b2d
relationship type: null
relationship value: null
generated by: null); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-08-26 08:47:43.0 [tbs1979]  
insert Definition (id: null
text: End moraines, or terminal moraines, are ridges of unconsolidated debris deposited at the snout or end of the glacier. They usually reflect the shape of the glacier's terminus.  Glaciers act much like a conveyor belt, carrying debris from the top of the glacier to the bottom where it deposits it in end moraines.
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-08-06 14:50:12.0 [tbs1979] Insert Concept 
add broader relation (TERMINAL MORAINE [16bd425e-9a14-41ac-900e-5b5c4f713dda,105653] - MORAINES [2575cfaf-1a09-48b6-acb9-fda23b6f4719,105627]); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">End moraines, or terminal moraines, are ridges of unconsolidated debris deposited at the snout or end of the glacier. They usually reflect the shape of the glacier's terminus.  Glaciers act much like a conveyor belt, carrying debris from the top of the glacier to the bottom where it deposits it in end moraines.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">TERMINAL MORAINE</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx2975"/>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/b62123dd-1bf5-4222-a646-05d71d729c75">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/2575cfaf-1a09-48b6-acb9-fda23b6f4719"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-08-06 14:49:58.0 [tbs1979] Insert Concept 
add broader relation (RIBBED/ROGAN MORAINE [b62123dd-1bf5-4222-a646-05d71d729c75,105651] - MORAINES [2575cfaf-1a09-48b6-acb9-fda23b6f4719,105627]); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-08-26 08:47:14.0 [tbs1979]  
insert Definition (id: null
text: Type of basal moraines that forms a series of ribs perpendicular to the ice flow in an ice sheet. The depressions between the ribs are sometimes filled with water making the Rogen moraines look like tigerstripes on aerial photographs.
language code: en); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Type of basal moraines that forms a series of ribs perpendicular to the ice flow in an ice sheet. The depressions between the ribs are sometimes filled with water making the Rogen moraines look like tigerstripes on aerial photographs.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">RIBBED/ROGAN MORAINE</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx355"/>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/5c242e01-40c4-4fca-a99d-48e4064f6c6f">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/2575cfaf-1a09-48b6-acb9-fda23b6f4719"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-08-06 14:49:47.0 [tbs1979] Insert Concept 
add broader relation (RECESSIONAL MORAINE [5c242e01-40c4-4fca-a99d-48e4064f6c6f,105649] - MORAINES [2575cfaf-1a09-48b6-acb9-fda23b6f4719,105627]); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-08-26 08:45:34.0 [tbs1979]  
insert Definition (id: null
text: Are often observed as a series of transverse ridges running across a valley behind a terminal moraine. They form perpendicular to the lateral moraines that they reside between and are composed of unconsolidated debris deposited by the glacier. They are created during temporary halts in a glacier's retreat.
language code: en); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Are often observed as a series of transverse ridges running across a valley behind a terminal moraine. They form perpendicular to the lateral moraines that they reside between and are composed of unconsolidated debris deposited by the glacier. They are created during temporary halts in a glacier's retreat.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">RECESSIONAL MORAINE</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx2260"/>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/063fae56-f066-4023-84c2-daff8261b7fc">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/2575cfaf-1a09-48b6-acb9-fda23b6f4719"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-08-26 08:45:13.0 [tbs1979]  
insert Definition (id: null
text: A ridge of moraine that runs down the center of a valley floor. It is formed when two glaciers meet and the debris on the edges of the adjacent valley sides join and are carried on top of the enlarged glacier.
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-08-06 14:49:37.0 [tbs1979] Insert Concept 
add broader relation (MEDIAL MORAINE [063fae56-f066-4023-84c2-daff8261b7fc,105647] - MORAINES [2575cfaf-1a09-48b6-acb9-fda23b6f4719,105627]); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">A ridge of moraine that runs down the center of a valley floor. It is formed when two glaciers meet and the debris on the edges of the adjacent valley sides join and are carried on top of the enlarged glacier.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">MEDIAL MORAINE</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx1148"/>
</rdf:Description>

