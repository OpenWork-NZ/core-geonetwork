	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">A measurement of distance from the sea surface to the sea floor.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
