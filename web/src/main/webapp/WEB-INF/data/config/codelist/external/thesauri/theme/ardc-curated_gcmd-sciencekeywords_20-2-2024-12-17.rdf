	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-02-18 11:59:11.0 [tbs1979] Insert Concept 
add broader relation (LAVA PLAIN [dc18db4d-2184-453e-ba0a-86c83a9bede0,82527] - TECTONIC LANDFORMS [46172bbe-8bf0-49a0-848f-129c089aeb8e,63407]); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-04-02 07:30:27.0 [tbs1979]  
insert Definition (id: null
text: Also called a lava field or lava bed, is a large expanse of nearly flat-lying lava flows. Such features are generally composed of highly-fluid basalt lava, and can extend for tens or even hundreds of miles across the underlying terrain.
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2024-10-31 09:23:00.0 [tstevens]  
insert WeightedRelation (id: null
related concept uuid: edb9d13d-27a1-4e9a-a32e-4e49b5e76836
relationship type: null
relationship value: null
generated by: null); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Also called a lava field or lava bed, is a large expanse of nearly flat-lying lava flows. Such features are generally composed of highly-fluid basalt lava, and can extend for tens or even hundreds of miles across the underlying terrain.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">LAVA PLAIN</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx1764"/>
</rdf:Description>

