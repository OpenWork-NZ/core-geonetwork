	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">The movement of loose particulate material by a medium such as wind or
water currents.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">SEDIMENT TRANSPORT</prefLabel>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/676327f4-8354-4033-8081-9cab6651ac98">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
