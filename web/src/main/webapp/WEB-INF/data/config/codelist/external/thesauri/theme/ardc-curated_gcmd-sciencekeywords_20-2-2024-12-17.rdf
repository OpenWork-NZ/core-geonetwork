insert Definition (id: null
text: Phylum Chordata. Class Mammalia. Order Atiodactyla. Deer are ruminant, four legged animals with long powerful legs, a small tail, long ears. Deer distinguished by their antlers, which are temporary and can be regrown. Male deer possess antlers while generally females lack antlers.
language code: en); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Phylum Chordata. Class Mammalia. Order Atiodactyla. Deer are ruminant, four legged animals with long powerful legs, a small tail, long ears. Deer distinguished by their antlers, which are temporary and can be regrown. Male deer possess antlers while generally females lack antlers.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">DEER/MOOSE</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx1106"/>
</rdf:Description>

