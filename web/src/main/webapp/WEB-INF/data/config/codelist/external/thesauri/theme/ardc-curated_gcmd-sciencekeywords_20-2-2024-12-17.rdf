	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">A type of frozen precipitation in the form of balls or irregular lumps of
ice, usually consisting of concentric layers of ice. Hail is always
produced by convective clouds, nearly always cumulonimbus.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">HAIL</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx216"/>
</rdf:Description>

