	<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/8f109871-e6ff-4cef-a5f8-5a3ad981923e"/>
	<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/38fb609b-2a10-4d4f-b2e8-7e51161ec974"/>
</rdf:Description>

