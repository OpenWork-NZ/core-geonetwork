	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx2916"/>
	<altLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">SRM</altLabel>
</rdf:Description>

