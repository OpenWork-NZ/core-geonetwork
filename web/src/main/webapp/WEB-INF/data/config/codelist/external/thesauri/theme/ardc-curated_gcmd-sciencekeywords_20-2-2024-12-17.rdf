<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/9985d211-1056-4a7a-a1c8-550923ea5a81">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/d4449cf4-8d4e-4282-b84d-5098715389dd"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2019-02-25 17:41:05.0 [sritz]  
insert Definition (id: null
text: Latent heat refers to energy lost (acquired) by a thermodynamic system during evaporative (condensation) processes. Most commonly in Earth systems, latent heating and cooling is experienced by any body containing water. Roughly 20% of the cooling of the surface of the Earth is due to evaporative processes. This energy, carried by water vapor, is released into the atmosphere during condensation processes, mainly during formation of clouds and precipitation.
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2019-02-15 14:38:08.0 [sritz] Insert Concept 
add broader relation (LATENT HEAT FLUX [9985d211-1056-4a7a-a1c8-550923ea5a81,368495] - PRECIPITATION PROFILES [d4449cf4-8d4e-4282-b84d-5098715389dd,368491]); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Latent heat refers to energy lost (acquired) by a thermodynamic system during evaporative (condensation) processes. Most commonly in Earth systems, latent heating and cooling is experienced by any body containing water. Roughly 20% of the cooling of the surface of the Earth is due to evaporative processes. This energy, carried by water vapor, is released into the atmosphere during condensation processes, mainly during formation of clouds and precipitation.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">LATENT HEAT FLUX</prefLabel>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/40f7445f-1741-418e-9831-e2e3322daf5a">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
