<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/d622004f-e155-4af3-87c5-61b3a4b87692">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/cda9b483-8711-42b8-82f9-e7d22ce9c62c"/>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">The effects of roll, pitch, and yaw, as well as jitter on  the image&#xD;
geometry. &lt;I&gt;Roll&lt;/I&gt; will cause the image to take on a wavy appearance,&#xD;
&lt;I&gt;pitch&lt;/I&gt; will cause grid cells to contract or expand in the flight&#xD;
direction, and &lt;I&gt;yaw&lt;/I&gt; will create a skewed image.	 &lt;I&gt;Jitter&lt;/I&gt;&#xD;
consists of random and	unsystematic vibaration which cannot be&#xD;
measured.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">VIEWING GEOMETRY</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx62"/>
</rdf:Description>

