	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-08-26 09:07:33.0 [tbs1979]  
insert Definition (id: null
text: A process made by made by glaciohydraulic supercooling, though some studies show that even where physical conditions allow it to occur, the process may not be responsible for observed sequences of basal ice.
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-08-06 15:00:23.0 [tbs1979] Insert Concept 
add broader relation (BASAL ICE FREEZING [ee8dfdf6-0153-4067-ab3b-51794b01ee86,105665] - FREEZE/THAW [24b052b6-5996-496d-9e91-1fdbda5897da,105663]); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">A process made by made by glaciohydraulic supercooling, though some studies show that even where physical conditions allow it to occur, the process may not be responsible for observed sequences of basal ice.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">BASAL ICE FREEZING</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx200"/>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/24b052b6-5996-496d-9e91-1fdbda5897da">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/b409a30b-0e3f-4592-bec9-7d371797b4a9"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-08-06 14:59:59.0 [tbs1979] Insert Concept 
add broader relation (FREEZE/THAW [24b052b6-5996-496d-9e91-1fdbda5897da,105663] - GLACIAL PROCESSES [b409a30b-0e3f-4592-bec9-7d371797b4a9,85295]); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-08-26 09:07:05.0 [tbs1979]  
insert Definition (id: null
text: The process where water seeps into a crack in a rock, as the temperature drops below freezing, the water freezes and expands causing the crack to enlarge. The ice then melts into water again as the temperature rises above freezing. This action is repeated until the rock breaks.
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2024-10-02 09:32:28.0 [tstevens]  
