	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">The condition that occurs when water overflows the natural or
artificial confines of a stream or other body of water, or accumulates by
drainage over low-lying areas.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">FLOODS</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx735"/>
	<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/44278367-2c4d-4309-90a2-03244a12ae39"/>
