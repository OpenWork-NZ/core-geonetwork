<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/1a888a27-8715-46c8-9e11-a6bffba00078">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
