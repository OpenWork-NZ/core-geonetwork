<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/d53e1951-fb68-4ad8-8725-d19c10751da5">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/b8018326-a186-4847-961d-8bd0727bbd5e"/>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Related to or about any permanent or temporary construction on a farm, ranch,
or other agricultural land.  This includes items such as barns, but also
water improvements, fencing, shelters, henhouses, dams, etc...</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
