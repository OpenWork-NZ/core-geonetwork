	<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/bde65cfd-faec-4656-bc27-22dfe30912b7"/>
	<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/f5717312-c3ca-4492-a166-9f17c6d9b273"/>
	<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/2ab4134d-1ac7-4421-a7a6-659a542aff4c"/>
