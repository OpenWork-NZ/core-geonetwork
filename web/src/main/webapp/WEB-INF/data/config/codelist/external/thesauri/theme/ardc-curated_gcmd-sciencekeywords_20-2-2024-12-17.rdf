	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Any measurement of Carbon in the soil, in organic or inorganic fractions.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
