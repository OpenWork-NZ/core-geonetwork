	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/376a1d5c-2496-4381-981f-bc047af92044"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2024-10-01 15:43:55.0 [tstevens]  
update Definition (Active layer, also called frost zone or mollisol, is part of the soil included
with the suprapermafrost layer (i.e., existing above permafrost) that usually
freezes in winter and thaws in summer. 
Its bottom surface is the frost table, beneath which may lie permafrost or
talik. The depth of the active layer varies anywhere from a few inches to
several feet.); 
update Definition (American Meteorological Society Glossary of Meteorology Online
"http://amsglossary.allenpress.com/glossary"); 
insert WeightedRelation (id: null
related concept uuid: 10270ee0-8d85-4c75-9fa2-49e7a9755cb3
relationship type: null
relationship value: null
generated by: null); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Active layer, also called frost zone or mollisol, is part of the soil included
with the suprapermafrost layer (i.e., existing above permafrost) that usually
freezes in winter and thaws in summer. 
Its bottom surface is the frost table, beneath which may lie permafrost or
talik. The depth of the active layer varies anywhere from a few inches to
several feet.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">ACTIVE LAYER</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx1723"/>
</rdf:Description>

