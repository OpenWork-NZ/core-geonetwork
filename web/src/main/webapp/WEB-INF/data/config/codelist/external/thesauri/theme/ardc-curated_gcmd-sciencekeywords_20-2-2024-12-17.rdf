<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/8bb1dca3-9793-4120-b0ea-f27a5b81f259">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/592d49c4-e8ae-4ab4-bf24-ae4a896d0637"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2017-04-20 14:42:42.0 [sritz] Move Concepts 
delete broader relation (null); 
add broader relation (BOUNDARY LAYER WINDS [8bb1dca3-9793-4120-b0ea-f27a5b81f259,83375] - UPPER LEVEL WINDS [592d49c4-e8ae-4ab4-bf24-ae4a896d0637,83357]); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2017-04-21 11:29:22.0 [tstevens]  
update Definition (Winds measured in the layer of fluid near a boundary that is affected by friction against that boundary surface, and possibly by transport of heat and other variables (such as winds) across that surface.  In meteorology, this is the atmospheric boundary layer.); 
update Definition (Glossary of Meteorology, American Meteorological Society); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Winds measured in the layer of fluid near a boundary that is affected by friction against that boundary surface, and possibly by transport of heat and other variables (such as winds) across that surface.  In meteorology, this is the atmospheric boundary layer.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">BOUNDARY LAYER WINDS</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx1222"/>
</rdf:Description>

