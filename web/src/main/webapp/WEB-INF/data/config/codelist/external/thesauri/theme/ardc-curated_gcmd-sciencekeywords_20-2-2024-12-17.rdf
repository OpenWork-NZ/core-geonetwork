<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/57292a97-19be-4fae-b2f7-9fa0a3629b53">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/c9e429cb-eff0-4dd3-9eca-527e0081f65c"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-02-14 13:56:51.0 [mpmorahan] Move Concepts 
delete broader relation (null); 
add broader relation (CLOUD HEIGHT [57292a97-19be-4fae-b2f7-9fa0a3629b53,63281] - CLOUD PROPERTIES [c9e429cb-eff0-4dd3-9eca-527e0081f65c,82133]); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">In weather observations, the height of the cloud base above local
terrain.  In satellite remote sensing, cloud height is often referred to as the
height of the cloud top above local terrain or above mean sea level. Also can
be defined as the vertical distance from the cloud base to the cloud top; more
commonly referred to as the "thickness" or "depth" of the cloud. </definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">CLOUD HEIGHT</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx2366"/>
</rdf:Description>

