<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/547c2bee-40ce-4b23-8338-5fa7c6ad8a8d">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/3ff47a50-2f58-489b-96a7-74e1d40cf0f2"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-03-07 08:13:36.0 [tbs1979] Insert Concept 
add broader relation (REFLECTION [547c2bee-40ce-4b23-8338-5fa7c6ad8a8d,83109] - METEORITE PHYSICAL/OPTICAL PROPERTIES [3ff47a50-2f58-489b-96a7-74e1d40cf0f2,83087]); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2017-03-10 07:53:19.0 [tstevens]  
insert Definition (id: null
text: A method of exploration geophysics that uses the principles of seismology to estimate of the properties of the Earth's subsurface from reflected seismic waves. This measurement is also known as seismic reflection.
language code: en); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">A method of exploration geophysics that uses the principles of seismology to estimate of the properties of the Earth's subsurface from reflected seismic waves. This measurement is also known as seismic reflection.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">REFLECTION</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx2295"/>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/651a6368-251e-45f6-8496-1f798de85db5">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/3ff47a50-2f58-489b-96a7-74e1d40cf0f2"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-03-07 08:16:28.0 [tbs1979] Insert Concept 
add broader relation (LUSTER [651a6368-251e-45f6-8496-1f798de85db5,83115] - METEORITE PHYSICAL/OPTICAL PROPERTIES [3ff47a50-2f58-489b-96a7-74e1d40cf0f2,83087]); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-03-21 11:17:13.0 [tbs1979]  
insert Definition (id: null
text: Luster is the way light reflects off the surface of a mineral.
language code: en); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Luster is the way light reflects off the surface of a mineral.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">LUSTER</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx2972"/>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/0de2a94f-9bd1-4ad0-b5b8-4a8237d049bf">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/3ff47a50-2f58-489b-96a7-74e1d40cf0f2"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-03-07 08:11:29.0 [tbs1979] Insert Concept 
add broader relation (ELECTRICAL [0de2a94f-9bd1-4ad0-b5b8-4a8237d049bf,83105] - METEORITE PHYSICAL/OPTICAL PROPERTIES [3ff47a50-2f58-489b-96a7-74e1d40cf0f2,83087]); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-03-21 11:15:23.0 [tbs1979]  
insert Definition (id: null
text: The electrical nature of a material is characterized by its conductivity (or, inversely, its resistivity) and its dielectric constant, and coefficients that indicate the rates of change of these with temperature, frequency at which measurement is made, and so on. For rocks with a range of chemical composition as well as variable physical properties of porosity and fluid content, the values of electrical properties can vary widely.
language code: en); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">The electrical nature of a material is characterized by its conductivity (or, inversely, its resistivity) and its dielectric constant, and coefficients that indicate the rates of change of these with temperature, frequency at which measurement is made, and so on. For rocks with a range of chemical composition as well as variable physical properties of porosity and fluid content, the values of electrical properties can vary widely.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">ELECTRICAL</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx2714"/>
</rdf:Description>

<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/d9add64c-1764-4ddb-b088-71c77084a2f5">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
