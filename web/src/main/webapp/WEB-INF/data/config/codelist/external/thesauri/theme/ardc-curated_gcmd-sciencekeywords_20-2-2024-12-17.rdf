	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2016-07-12 10:24:25.0 [gee-cee]  
insert Definition (id: null
text: Subset of Earth's aquatic ecosystems. They include lakes and ponds, rivers, streams, springs, and wetlands. They can be contrasted with marine ecosystems, which have a larger salt content.
language code: en); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Subset of Earth's aquatic ecosystems. They include lakes and ponds, rivers, streams, springs, and wetlands. They can be contrasted with marine ecosystems, which have a larger salt content.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">FRESHWATER ECOSYSTEMS</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx2729"/>
