<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/2e2b3e40-8775-41a7-a541-e482847289cb">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/2e5a401b-1507-4f57-82b8-36557c13b154"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2021-06-08 16:17:17.0 [sritz]  
insert Definition (id: null
text: Absorbing aerosols refer to those aerosols that absorb light, whereby they both reduce the amount of sunlight reaching the surface (direct effect) and heat their surroundings.
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2021-06-08 16:13:31.0 [sritz] Insert Concept 
