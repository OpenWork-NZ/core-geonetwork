<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/5f6e0ca7-5d60-4973-890b-08ad82654331">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/66700628-2b62-4466-999e-faeb15ca4da5"/>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">The raw digital values recorded by the sensor.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
