relationship value: null
generated by: null); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-03-22 11:08:17.0 [tbs1979]  
insert Definition (id: null
text: Underwater structures made from calcium carbonate secreted by corals. Corals are colonies of tiny living animals found in marine waters containing few nutrients. Most coral reefs are built from stony corals, and are formed by polyps that live together in groups. The polyps secrete a hard carbonate exoskeleton which provides support and protection for the body of each polyp.
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-02-18 12:21:56.0 [tbs1979] Insert Concept 
add broader relation (CORAL REEFS [dff4d4af-e1e0-4991-884b-a1c088a802b2,82559] - COASTAL LANDFORMS [c58320e6-3f1d-4c36-9bee-6bad73404c21,62739]); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-02-18 12:23:33.0 [tbs1979] Insert Concept 
add narrower relation (CORAL REEFS [dff4d4af-e1e0-4991-884b-a1c088a802b2,82559] - APRON REEF [0e566bce-90bf-4a0a-a000-5bb5fb430788,82567]); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-02-18 12:24:58.0 [tbs1979] Insert Concept 
add narrower relation (CORAL REEFS [dff4d4af-e1e0-4991-884b-a1c088a802b2,82559] - TABLE REEF [5f4dc81d-0893-4eb9-b82a-6a070836aa16,82575]); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-02-18 12:22:25.0 [tbs1979] Insert Concept 
add narrower relation (CORAL REEFS [dff4d4af-e1e0-4991-884b-a1c088a802b2,82559] - FRINGING REEF [0f5c48d1-5189-495d-b5a7-7ad596f0a5c4,82561]); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-02-18 12:24:38.0 [tbs1979] Insert Concept 
add narrower relation (CORAL REEFS [dff4d4af-e1e0-4991-884b-a1c088a802b2,82559] - ATOLL REEF [8c89ede4-94d8-4fd4-a3df-f9d42e9835eb,82573]); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-02-18 12:22:54.0 [tbs1979] Insert Concept 
add narrower relation (CORAL REEFS [dff4d4af-e1e0-4991-884b-a1c088a802b2,82559] - BARRIER REEF [5fde7781-d4f6-41a8-8428-f428b70c02dc,82563]); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Underwater structures made from calcium carbonate secreted by corals. Corals are colonies of tiny living animals found in marine waters containing few nutrients. Most coral reefs are built from stony corals, and are formed by polyps that live together in groups. The polyps secrete a hard carbonate exoskeleton which provides support and protection for the body of each polyp.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">CORAL REEFS</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx3105"/>
	<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/5fde7781-d4f6-41a8-8428-f428b70c02dc"/>
	<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/b428ba89-4638-4989-90c1-f5e4f0d0a6f6"/>
	<narrower xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/0e566bce-90bf-4a0a-a000-5bb5fb430788"/>
