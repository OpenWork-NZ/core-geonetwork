insert Definition (id: null
text: A steep conical hill of tephra (volcanic debris) that accumulates around and downwind from a volcanic vent.
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-08-16 10:08:36.0 [tbs1979]  
