<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/da436e9b-60e5-4a5f-a50a-08794d62bca8">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/b7d562cf-9b9b-4461-900b-50423a8c4d29"/>
