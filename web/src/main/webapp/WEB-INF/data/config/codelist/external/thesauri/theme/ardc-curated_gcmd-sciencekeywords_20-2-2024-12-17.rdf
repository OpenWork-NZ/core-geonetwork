	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">The transport of mass by vertical motion within clouds. Mass in this
context is defined as the mass of dry air plus the mass of water vapor,
excluding the mass of any liquid water.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">CLOUD MASS FLUX</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx337"/>
</rdf:Description>

