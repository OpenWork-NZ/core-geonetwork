add broader relation (SHOALS [cae5bafd-10a7-4bcf-af1a-3e187ee5e955,105543] - COASTAL LANDFORMS [0cff6e4b-e42a-4565-89ff-350adf41ed69,105283]); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-08-20 09:23:13.0 [tbs1979]  
insert Definition (id: null
text: A somewhat linear landform  within or extending into a body of water, typically composed of sand, silt or small pebbles. A spit or sandspit is a type of shoal.
language code: en); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">A somewhat linear landform  within or extending into a body of water, typically composed of sand, silt or small pebbles. A spit or sandspit is a type of shoal.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">SHOALS</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx981"/>
