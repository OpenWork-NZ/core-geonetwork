add broader relation (CLEAVAGE [d9add64c-1764-4ddb-b088-71c77084a2f5,83111] - METEORITE PHYSICAL/OPTICAL PROPERTIES [3ff47a50-2f58-489b-96a7-74e1d40cf0f2,83087]); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-03-21 11:12:23.0 [tbs1979]  
insert Definition (id: null
text: Breakage of a mineral along a flat plane of weakness.
language code: en); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Breakage of a mineral along a flat plane of weakness.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
