add broader relation (NIMBOSTRATUS [a3d37438-644d-448e-95ea-991d79b3a0f3,82255] - TROPOSPHERIC/LOW LEVEL CLOUDS (OBSERVED/ANALYZED) [20365b0a-f8df-437a-8b31-25557f7b4d82,82129]); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2013-03-21 14:01:07.0 [mpmorahan]  
insert Definition (id: null
text: Low or middle-level thick dark cloud with with more or less continuously falling rain, snow or sleet. In aviation forecasts and reports it is coded as NS.
language code: en); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Low or middle-level thick dark cloud with with more or less continuously falling rain, snow or sleet. In aviation forecasts and reports it is coded as NS.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
