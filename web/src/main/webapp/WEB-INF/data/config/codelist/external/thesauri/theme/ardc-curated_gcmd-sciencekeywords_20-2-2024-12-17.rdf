insert Definition (id: null
text: An ENSO meridional wind anomaly index is calculated for the region 12-2N, 160E-80W from the International Comprehensive Ocean-Atmosphere Data Set (COADS). This region was chosen from a map of meridional wind regressed onto an index of eastern equatorial Pacific SST for the period 1950-79.
language code: en); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">An ENSO meridional wind anomaly index is calculated for the region 12-2N, 160E-80W from the International Comprehensive Ocean-Atmosphere Data Set (COADS). This region was chosen from a map of meridional wind regressed onto an index of eastern equatorial Pacific SST for the period 1950-79.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">EQUATORIAL PACIFIC MERIDIONAL WIND ANOMALY INDEX</prefLabel>
