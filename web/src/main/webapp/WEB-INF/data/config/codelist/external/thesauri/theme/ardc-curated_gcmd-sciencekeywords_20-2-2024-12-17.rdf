<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/87b074b4-9b73-4e69-b8c0-0f112b1cfa6d">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/457883c4-b30c-4d26-bed8-6c2887ebbc90"/>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">Dissolved organic matter (DOM) produced by the decomposition of plant
material and the metabolism of plankton, originating in the ocean or
brought to the ocean by rivers, and producing a distinctive yellow-brown
to yellow-red coloration of the water.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">GELBSTOFF</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx2125"/>
</rdf:Description>

