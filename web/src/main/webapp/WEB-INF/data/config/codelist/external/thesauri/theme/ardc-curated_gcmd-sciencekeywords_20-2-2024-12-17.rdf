<rdf:Description rdf:about="https://gcmd.earthdata.nasa.gov/kms/concept/75a83951-a086-4d25-9ab0-c118b0e20383">
	<rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<broader xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concept/f7e97dc3-1181-41b5-8b90-946eb2504110"/>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2018-03-07 12:38:17.0 [tstevens]  
insert Definition (id: null
text: A condition caused predominantly by dissolved salts of calcium, magnesium and iron, such as bicarbonates, carbonates, sulfates, chlorides and nitrates, a water-quality indicator of the concentration of alkaline salts in water, hard water requires more soap, detergent or shampoo to raise a lather.
language code: en); 
</changeNote>
	<changeNote xmlns="http://www.w3.org/2004/02/skos/core#" rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2018-03-07 08:31:07.0 [tstevens] Insert Concept 
add broader relation (WATER HARDNESS [75a83951-a086-4d25-9ab0-c118b0e20383,310689] - WATER CHARACTERISTICS [f7e97dc3-1181-41b5-8b90-946eb2504110,310633]); 
</changeNote>
	<definition xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">A condition caused predominantly by dissolved salts of calcium, magnesium and iron, such as bicarbonates, carbonates, sulfates, chlorides and nitrates, a water-quality indicator of the concentration of alkaline salts in water, hard water requires more soap, detergent or shampoo to raise a lather.</definition>
	<inScheme xmlns="http://www.w3.org/2004/02/skos/core#" rdf:resource="https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords"/>
	<prefLabel xmlns="http://www.w3.org/2004/02/skos/core#" xml:lang="en">WATER HARDNESS</prefLabel>
	<reference xmlns="https://gcmd.earthdata.nasa.gov/kms#" rdf:nodeID="node1igi5qapbx2092"/>
</rdf:Description>

